<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.ExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Expense" Height="610" Width="560"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="CanResizeWithGrip"
        MinWidth="480" MinHeight="520">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="💸" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Add New Expense" FontSize="16" FontWeight="Bold" Foreground="#152039"/>
                    <TextBlock Text="Record operational overheads, utilities, salaries, or petty cash." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scrollable Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <!-- Date & Category -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDate" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Category *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbCategory" SelectionChanged="Category_Changed" Padding="8">
                            <ComboBoxItem Content="Everyday Exp" IsSelected="True"/>
                            <ComboBoxItem Content="Tea &amp; Refreshments"/>
                            <ComboBoxItem Content="Salary"/>
                            <ComboBoxItem Content="EB (Electricity)"/>
                            <ComboBoxItem Content="Water Bill"/>
                            <ComboBoxItem Content="ESI / PF"/>
                            <ComboBoxItem Content="Rent"/>
                            <ComboBoxItem Content="Transport &amp; Freight"/>
                            <ComboBoxItem Content="Repairs &amp; Maintenance"/>
                            <ComboBoxItem Content="Exhibition / Marketing"/>
                            <ComboBoxItem Content="Insurance &amp; Licences"/>
                            <ComboBoxItem Content="Stationery &amp; Printing"/>
                            <ComboBoxItem Content="Packaging Consumables"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Frequency & Amount -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="How Often (Frequency)" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbFreq" Padding="8">
                            <ComboBoxItem Content="Daily" IsSelected="True"/>
                            <ComboBoxItem Content="Weekly"/>
                            <ComboBoxItem Content="Monthly"/>
                            <ComboBoxItem Content="Quarterly"/>
                            <ComboBoxItem Content="Yearly"/>
                            <ComboBoxItem Content="One-time"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Amount (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAmount" Padding="8" FontWeight="Bold" FontSize="13" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                </Grid>

                <!-- Details / Description with choice presets -->
                <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Details / Description *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" VerticalAlignment="Center"/>
                        <TextBlock Text="Select preset or type custom" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="CbDescPreset" IsEditable="True" Padding="8" BorderBrush="#E1E5EC">
                        <ComboBoxItem Content="Daily staff tea, coffee, and biscuits"/>
                        <ComboBoxItem Content="Monthly factory electricity consumption"/>
                        <ComboBoxItem Content="Monthly factory premises rent"/>
                        <ComboBoxItem Content="Worker wages and overtime advance"/>
                        <ComboBoxItem Content="Drinking water cans and supply tanker"/>
                        <ComboBoxItem Content="Tempo / Auto freight and parcel charges"/>
                        <ComboBoxItem Content="Sole trimming &amp; sewing machine maintenance"/>
                        <ComboBoxItem Content="Stationery, printing, and billing roll"/>
                        <ComboBoxItem Content="Pollution control &amp; factory license renewal"/>
                    </ComboBox>
                </StackPanel>

                <!-- Paid By / Payment Mode -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Paid By (Payment Mode) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbMode" Padding="8">
                            <ComboBoxItem Content="Bank" IsSelected="True"/>
                            <ComboBoxItem Content="Cash"/>
                            <ComboBoxItem Content="UPI"/>
                            <ComboBoxItem Content="Company Card"/>
                            <ComboBoxItem Content="Director Account"/>
                            <ComboBoxItem Content="Cheque"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Paid To / Recipient (Optional)" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPaidTo" Padding="8" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Save Expense" Click="Save_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
