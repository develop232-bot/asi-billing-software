<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.ExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add expense" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="CanResizeWithGrip"
        MinWidth="460" MinHeight="480">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header matching modal: Add expense with close button -->
        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="Cancel_Click" Background="Transparent" BorderThickness="0"
                        FontSize="14" Foreground="#64748B" Cursor="Hand" Padding="6,2" VerticalAlignment="Center"/>
                <TextBlock Text="Add expense" FontSize="17" FontWeight="Bold" Foreground="#152039" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Scrollable Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- Row 1: Date & Category (Employee, Utility, Misc Exp ONLY) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Date" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDate" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Category" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbCategory" SelectionChanged="Category_Changed" Padding="8" BorderBrush="#E1E5EC" SelectedIndex="0">
                            <ComboBoxItem Content="Employee"/>
                            <ComboBoxItem Content="Utility"/>
                            <ComboBoxItem Content="Misc Exp"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Type & Amount -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Type" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbType" Padding="8" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Amount (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAmount" Padding="8" FontWeight="Bold" FontSize="13" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Employee Name & Position (Visible when Category == Employee) -->
                <Grid x:Name="GridEmployee" Margin="0,0,0,12" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Employee name" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmployeeName" Padding="8" BorderBrush="#E1E5EC" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Position" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbPosition" IsEditable="True" Text="" Padding="8" BorderBrush="#E1E5EC">
                            <ComboBoxItem Content="Operator"/>
                            <ComboBoxItem Content="Supervisor"/>
                            <ComboBoxItem Content="Cutter"/>
                            <ComboBoxItem Content="Stitcher"/>
                            <ComboBoxItem Content="Helper"/>
                            <ComboBoxItem Content="Packer"/>
                            <ComboBoxItem Content="Driver"/>
                            <ComboBoxItem Content="Accountant"/>
                            <ComboBoxItem Content="Manager"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 4: Details (optional) -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Details (optional)" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDetails" Padding="8" BorderBrush="#E1E5EC" FontSize="12.5"/>
                </StackPanel>

                <!-- Row 5: Paid by -->
                <StackPanel Margin="0,0,0,12" Width="235" HorizontalAlignment="Left">
                    <TextBlock Text="Paid by" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbPaidBy" Padding="8" BorderBrush="#E1E5EC" SelectedIndex="0">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Bank"/>
                        <ComboBoxItem Content="UPI"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons: Cancel and Save expense -->
        <Border Grid.Row="2" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Save expense" Click="Save_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
