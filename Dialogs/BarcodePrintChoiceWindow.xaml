<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.BarcodePrintChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Barcode Labels" Height="730" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🖨️ Print Barcode Labels" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Print barcode stickers for a single item, multiple selected items, or all catalog products." FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Mode Selection Tiles (3 choices) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tile 1: Single Product -->
                <Border Grid.Column="0" x:Name="BorderSingle" CornerRadius="8" Padding="12,10" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="SelectSingle_Click">
                    <StackPanel>
                        <RadioButton x:Name="RbSingle" Content="Single Product" FontWeight="Bold" FontSize="12" Foreground="#0F172A" IsChecked="True" Checked="Mode_Checked"/>
                        <TextBlock Text="1 item with live label preview" FontSize="10.5" Foreground="#64748B" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tile 2: Multiple Products -->
                <Border Grid.Column="2" x:Name="BorderMultiple" CornerRadius="8" Padding="12,10" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="SelectMultiple_Click">
                    <StackPanel>
                        <RadioButton x:Name="RbMultiple" Content="Multiple Select" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Checked="Mode_Checked"/>
                        <TextBlock Text="Pick multiple items &amp; print continuously" FontSize="10.5" Foreground="#64748B" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tile 3: All Products -->
                <Border Grid.Column="4" x:Name="BorderAll" CornerRadius="8" Padding="12,10" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="SelectAll_Click">
                    <StackPanel>
                        <RadioButton x:Name="RbAll" Content="All Products" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Checked="Mode_Checked"/>
                        <TextBlock Text="Batch print entire catalog" FontSize="10.5" Foreground="#64748B" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY 1: Single Product View -->
        <Grid Grid.Row="2" x:Name="PanelSingle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Product & Options Selection -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <!-- Search Input -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="🔍 Search Item:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearchSingle" TextChanged="TxtSearchSingle_TextChanged" Padding="8,4" FontSize="11.5" BorderBrush="#CBD5E1" Height="28"/>
                    </DockPanel>

                    <!-- Product Selector -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Product to Print" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbProduct" IsEditable="True" IsTextSearchEnabled="True"
                                  SelectionChanged="CbProduct_SelectionChanged" DisplayMemberPath="DisplayName"
                                  Height="32" Padding="6,4" FontSize="12"/>
                    </StackPanel>

                    <!-- Size & Copies -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Size Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Select Size" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbSize" IsEditable="True" IsTextSearchEnabled="True"
                                      SelectionChanged="CbSize_SelectionChanged" LostFocus="CbSize_LostFocus" KeyUp="CbSize_KeyUp"
                                      Height="30" Padding="6,3" FontSize="12"/>
                        </StackPanel>

                        <!-- Number of Copies -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Label Copies" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Click="DecCopies_Click" Width="32" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="TxtCopies" Text="1" Width="60" Height="32" Margin="6,0" Padding="0"
                                         Background="White" Foreground="#0F172A" CaretBrush="#0F172A"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         FontWeight="Bold" FontSize="15" BorderBrush="#0284C7" BorderThickness="1.5"/>
                                <Button Content="+" Click="IncCopies_Click" Width="32" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Printable Label Preview -->
            <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="10" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="PrintableLabel" Background="White" Width="350" CornerRadius="8" Padding="14,10" BorderBrush="#94A3B8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Brand Name -->
                        <TextBlock Text="AFRAH SAMIYA INDUSTRIES" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="SHOES &amp; UNIFORMS · FOOTWEAR DIVISION" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,1,0,5"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,5"/>

                        <!-- Product Name -->
                        <TextBlock x:Name="TxtProdName" Text="Product Name" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>

                        <!-- Category / SKU / Size Tag Line -->
                        <DockPanel HorizontalAlignment="Center" Margin="0,3,0,5">
                            <TextBlock x:Name="TxtSku" Text="SKU: ASI-001" FontSize="9.5" Foreground="#475569" Margin="0,0,8,0"/>
                            <TextBlock Text="·" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtSize" Text="Size: 8" FontWeight="Bold" FontSize="9.5" Foreground="#1E293B"/>
                        </DockPanel>

                        <!-- Real Vector Barcode Image -->
                        <Border Background="White" Padding="4,2" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Image x:Name="ImgBarcode" Width="250" Height="68" Stretch="Uniform"/>
                        </Border>

                        <Border Height="1" Background="#E2E8F0" Margin="0,2,0,5"/>

                        <!-- MRP and Tax info -->
                        <DockPanel HorizontalAlignment="Stretch" Margin="6,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MAX RETAIL PRICE" FontSize="7.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="(Incl. of all taxes)" FontSize="7" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtMrp" Text="₹ 0.00" FontWeight="Bold" FontSize="14" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- MAIN BODY 2: Multiple Products View (Continuous Print) -->
        <Border Grid.Row="2" x:Name="PanelMultiple" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <!-- Top Toolbar: Search & Select Actions -->
                <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="12,10" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="🔍 Filter Products:" FontWeight="SemiBold" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearchMulti" TextChanged="TxtSearchMulti_TextChanged" Padding="8,4" FontSize="12" BorderBrush="#CBD5E1" Height="28"/>
                        </DockPanel>

                        <!-- Action Controls: Select All, Deselect All, Set Copies -->
                        <DockPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select All" Click="SelectAllMulti_Click" Padding="10,4" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontSize="11" Margin="0,0,6,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Deselect All" Click="DeselectAllMulti_Click" Padding="10,4" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontSize="11" Margin="0,0,12,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>

                                <Border BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Height="16" Margin="0,0,12,0"/>

                                <TextBlock Text="Default Copies:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="−" Click="DecMultiDefaultCopies_Click" Width="24" Height="24" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="10"/>
                                <TextBox x:Name="TxtMultiDefaultCopies" Text="1" Width="36" Height="24" Margin="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                <Button Content="+" Click="IncMultiDefaultCopies_Click" Width="24" Height="24" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="10" Margin="0,0,6,0"/>
                                <Button Content="Apply to Selected" Click="ApplyDefaultCopies_Click" Padding="8,3" Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#C7D2FE" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>

                            <Border Background="#EEF2FF" Padding="8,4" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMultiSummaryBadge" Text="0 items selected · 0 labels" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Products Selection Table -->
                <DataGrid x:Name="DgMultiProducts" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowHeight="38" Margin="0,0,0,6">
                    <DataGrid.Columns>
                        <!-- Checkbox Column -->
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="MultiItemCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Product Name & SKU -->
                        <DataGridTemplateColumn Header="Product Name &amp; SKU" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sku}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Barcode -->
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" FontFamily="Consolas, Segoe UI" FontSize="11"/>

                        <!-- Price -->
                        <DataGridTextColumn Header="Price" Binding="{Binding RetailPrice, StringFormat='₹{0:N2}'}" Width="85" FontWeight="SemiBold"/>

                        <!-- Size Selector -->
                        <DataGridTemplateColumn Header="Size" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableSizes}" SelectedItem="{Binding SelectedSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding SelectedSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                              IsEditable="True" IsTextSearchEnabled="True" Height="26" Padding="4,2" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Copies Column -->
                        <DataGridTemplateColumn Header="Copies" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="−" Tag="{Binding}" Click="RowDecCopies_Click" Width="24" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="11"/>
                                        <TextBox Text="{Binding Copies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="RowCopies_TextChanged" Width="40" Height="24" Margin="3,0" Padding="0"
                                                 Background="White" Foreground="#0F172A" CaretBrush="#0F172A"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="12" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                        <Button Content="+" Tag="{Binding}" Click="RowIncCopies_Click" Width="24" Height="24" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- MAIN BODY 3: All Products Batch View -->
        <Border Grid.Row="2" x:Name="PanelAll" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#EEF2FF" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Batch Print All Barcode Labels" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                <TextBlock Text="Generate barcode price stickers for all saleable footwear and apparel products in your catalog." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,18" MaxWidth="380"/>

                <!-- Stats summary card -->
                <Border Background="#F8FAFC" CornerRadius="8" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Products:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalProductsCount" Text="0 Products" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Copies per Product:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Click="DecBatchCopies_Click" Width="32" Height="32" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="TxtBatchCopies" Text="1" TextChanged="TxtBatchCopies_TextChanged" Width="60" Height="32" Margin="6,0" Padding="0"
                                         Background="White" Foreground="#0F172A" CaretBrush="#0F172A"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="15" BorderBrush="#0284C7" BorderThickness="1.5"/>
                                <Button Content="+" Click="IncBatchCopies_Click" Width="32" Height="32" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Total Labels Callout -->
                <Border Background="#ECFDF5" CornerRadius="8" Padding="14,10" BorderBrush="#A7F3D0" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="🏷️ Total Labels to Print:" FontSize="12" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalBatchLabels" Text="0 Labels" FontSize="13" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#CBD5E1" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button x:Name="BtnPrint" Content="🖨️ Print Label" Click="Print_Click" Padding="22,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
