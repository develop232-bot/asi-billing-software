<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.DownloadFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Report" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="SingleBorderWindow">

    <Border Padding="22">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <Border Width="38" Height="38" CornerRadius="10" Background="#EEF2FF" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Download Report" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Choose the format you would like to download:" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

            <!-- Option 1: PDF Document -->
            <Button x:Name="BtnPdf" Click="BtnPdf_Click" Margin="0,0,0,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Padding="14,12">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="8" Background="#FEE2E2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PDF Document (.pdf)" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                        <TextBlock Text="Printable formatted report for viewing, printing or sharing" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Option 2: Excel / CSV Spreadsheet -->
            <Button x:Name="BtnCsv" Click="BtnCsv_Click" Margin="0,0,0,18" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Padding="14,12">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="8" Background="#DCFCE7" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Excel / CSV Spreadsheet (.csv)" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                        <TextBlock Text="Spreadsheet containing all columns and filtered records" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Cancel Button -->
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Right" Padding="18,7" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>