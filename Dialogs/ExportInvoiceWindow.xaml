<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.ExportInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Overseas Export Invoice" Height="700" Width="920"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#23968A" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New Export Invoice" FontSize="20" FontWeight="Bold" Foreground="#152039"/>
                <TextBlock Text=" (Middle East &amp; Global / LUT Zero-Rated GST)" FontSize="13" Foreground="#78839A" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buyer & Shipping Info -->
        <Border Grid.Row="1" Background="White" Padding="18" Margin="0,0,0,14" BorderBrush="#E1E5EC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Buyer Company Name *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtParty" Padding="8" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Invoice Date" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Padding="6"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Invoice Number" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInvoiceNo" Padding="8" IsReadOnly="True" Background="#F6F7FA" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Destination Country" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbCountry" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="Country_SelectionChanged" Padding="8">
                        <ComboBoxItem Content="UAE" IsSelected="True"/>
                        <ComboBoxItem Content="Saudi Arabia"/>
                        <ComboBoxItem Content="Qatar"/>
                        <ComboBoxItem Content="Oman"/>
                        <ComboBoxItem Content="Kuwait"/>
                        <ComboBoxItem Content="Bahrain"/>
                        <ComboBoxItem Content="Other (USD)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Currency &amp; Exchange Rate (₹)" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCur" Text="AED" IsReadOnly="True" Background="#F6F7FA" Padding="8"/>
                        <TextBox x:Name="TxtFx" Grid.Column="1" Text="24.10" Padding="8" Margin="8,0,0,0" TextChanged="Fx_TextChanged"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Port of Discharge" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPod" Text="Jebel Ali" Padding="8" BorderBrush="#E1E5EC"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line Items Table -->
        <Border Grid.Row="2" Background="White" Padding="14" BorderBrush="#E1E5EC" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Export Products" FontWeight="Bold" FontSize="14" Foreground="#152039" VerticalAlignment="Center"/>
                    <Button Content="+ Add Item" Click="AddLine_Click" Margin="16,0,0,0" Padding="10,4" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <DataGrid x:Name="DgLines" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Product / Item" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableProducts}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Pid, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" IsTextSearchEnabled="True"
                                              SelectionChanged="ProductSelectionChanged" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="Rate (Cur)" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Total (Cur)" Binding="{Binding GrossAmount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True"/>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Click="DeleteLine_Click" Foreground="#C23A32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Terms & Currency Summary -->
        <Grid Grid.Row="3" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Incoterm: " VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbInco" Width="90" Margin="8,0,0,0" IsEditable="True" IsTextSearchEnabled="True">
                        <ComboBoxItem Content="FOB" IsSelected="True"/>
                        <ComboBoxItem Content="CIF"/>
                        <ComboBoxItem Content="CFR"/>
                        <ComboBoxItem Content="EXW"/>
                    </ComboBox>
                    <TextBlock Text="Port of Loading: " VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="TxtPol" Text="Chennai" Width="100" Padding="4"/>
                </StackPanel>

                <TextBlock Text="GST: Zero-rated supply under LUT (Letter of Undertaking)" Foreground="#1B8556" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="White" Padding="14" BorderBrush="#E1E5EC" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="LblCurTotal" Text="Total (AED):" FontWeight="Bold" FontSize="14" Foreground="#152039"/>
                        <TextBlock x:Name="TxtCurTotal" Text="0.00" FontWeight="Bold" FontSize="15" Foreground="#23968A" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Equivalent in INR (₹):" Foreground="#48546F"/>
                        <TextBlock x:Name="TxtInrTotal" Text="₹0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="Received Now (Cur):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPaidNow" Text="0.00" Width="90" HorizontalAlignment="Right" Padding="4"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="Save Export Invoice" Click="Save_Click" Padding="18,8" Background="#23968A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
