<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.BulkProductImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk CSV Product Import"
        Height="700" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="850" MinHeight="550"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Light Theme Dropdown / ComboBox Style -->
        <Style x:Key="LightComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LightComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bulk CSV Upload &amp; Product Import" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Upload multiple products, shoes, raw materials, or packaging at once with automatic barcode generation." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Sample CSV Button in Header -->
                <Button DockPanel.Dock="Right" Content="📄 Download Sample CSV" Click="DownloadSampleCsv_Click"
                        Padding="16,8" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                        Cursor="Hand" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- Main Content Area: Options & Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Options Card -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Product Type Target -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Import Target Category *" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CbTargetType" Height="38" Style="{StaticResource LightComboBoxStyle}" ItemContainerStyle="{StaticResource LightComboBoxItemStyle}" SelectedIndex="0" SelectionChanged="TargetType_Changed">
                                <ComboBoxItem Content="👞 Finished Footwear (Mfg)" Tag="mfg"/>
                                <ComboBoxItem Content="👕 Readymade Goods (Resale)" Tag="ready"/>
                                <ComboBoxItem Content="🧵 Raw Materials (Leather/Sole)" Tag="raw"/>
                                <ComboBoxItem Content="📦 General Packaging &amp; Boxes" Tag="gen"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- File Picker & Info -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Select CSV File From Computer *" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                            <DockPanel>
                                <Button Content="📂 Browse CSV File..." Click="BrowseFile_Click"
                                        Padding="16,0" Height="38" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                        Cursor="Hand" BorderThickness="0" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBox x:Name="TxtFilePath" IsReadOnly="True" Height="38" Background="#F8FAFC" Foreground="#334155"
                                         BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,8" VerticalContentAlignment="Center" FontSize="12"
                                         Text="No file selected yet... Click 'Browse CSV File' or download sample template above."/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Import Settings Checkboxes -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="ChkAutoBarcode" Content="⚡ Automatically generate unique Barcode (ASI-XXXXXX) if empty in CSV"
                                  IsChecked="True" Foreground="#334155" FontSize="11.5" Cursor="Hand" Margin="0,0,28,0"/>
                        <CheckBox x:Name="ChkUpdateExisting" Content="🔄 Update price &amp; stock if SKU/Name already exists in database"
                                  IsChecked="True" Foreground="#334155" FontSize="11.5" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview DataGrid Card -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Preview Title & Stats -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="CSV Data Preview" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock x:Name="TxtPreviewCount" Text="0 rows ready to import" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Border>
                    </DockPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="DgPreview" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              Foreground="#0F172A" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="34">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,18,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready. Choose a CSV file to review and import." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Cancel_Click" Width="96" Height="40" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,12,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnStartImport" Content="🚀 Import All Items to Database" Click="StartImport_Click"
                            IsEnabled="False" Height="40" Padding="22,0" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
