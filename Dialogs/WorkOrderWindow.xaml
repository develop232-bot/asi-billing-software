<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.WorkOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Order" Height="760" Width="920" MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="#E5A62E" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock x:Name="TxtTitle" Text="New Production Work Order" FontSize="20" FontWeight="Bold" Foreground="#152039" VerticalAlignment="Center"/>
                    <TextBlock Text="Work orders track customer allocations, production stages, raw material consumption and finished goods." FontSize="11.5" Foreground="#78839A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Basic Info Card -->
            <Border Grid.Row="1" Background="White" Padding="16" Margin="0,0,0,14" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: Order No, Customer, Order Type -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Work Order No." FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtOrderNo" IsReadOnly="True" Background="#F6F7FA" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Customer / Order For" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCustomer" BorderBrush="#E1E5EC" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Order Type" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbOrderType" Height="36" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="General / stock" Tag="general" IsSelected="True"/>
                            <ComboBoxItem Content="Domestic" Tag="domestic"/>
                            <ComboBoxItem Content="Export" Tag="export"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 2: Order Date, Due Date, Status -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Date Order Came" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpOrderDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Due Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDueDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Production Status" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbStatus" Height="36" VerticalContentAlignment="Center" SelectionChanged="CbStatus_SelectionChanged">
                            <ComboBoxItem Content="Pending" IsSelected="True"/>
                            <ComboBoxItem Content="Cutting"/>
                            <ComboBoxItem Content="Stitching"/>
                            <ComboBoxItem Content="Lasting &amp; pressing"/>
                            <ComboBoxItem Content="Finishing"/>
                            <ComboBoxItem Content="Packing"/>
                            <ComboBoxItem Content="Completed"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 3: Production Started, Production Ended -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Production Started" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpStartDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Production Ended" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpEndDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dual Tables: Raw Material Consumed & Products to Make -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Raw Material Consumed -->
                <Border Grid.Column="0" Background="White" Padding="14" Margin="0,0,7,0" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Raw Material Consumed" FontWeight="Bold" FontSize="13.5" Foreground="#152039" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⚡ Recipe" Click="SuggestRecipe_Click" Padding="8,4" Background="#FBF0D6" Foreground="#7A5210" BorderBrush="#E5A62E" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                                <Button Content="+ Add Material" Click="AddMat_Click" Padding="8,4" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="DgMaterials" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White"
                                  RowHeight="48" MinHeight="160">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Raw Material" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableRawMaterials}"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                      IsEditable="True" IsTextSearchEnabled="True"
                                                      Height="34" Padding="6,0" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                                      SelectionChanged="MaterialSelectionChanged" LostFocus="MaterialComboBox_LostFocus"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit: Typeable / Editable -->
                                <DataGridTemplateColumn Header="Unit" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="12">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Qty -->
                                <DataGridTemplateColumn Header="Qty" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="12">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Click="DeleteMat_Click" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0"
                                                    Width="28" Height="28" Cursor="Hand" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Right: Products to Make -->
                <Border Grid.Column="1" Background="White" Padding="14" Margin="7,0,0,0" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Products to Make" FontWeight="Bold" FontSize="13.5" Foreground="#152039" VerticalAlignment="Center"/>
                            <Button Content="+ Add Finished Good" Click="AddItem_Click" HorizontalAlignment="Right" Padding="8,4" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </DockPanel>

                        <DataGrid x:Name="DgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White"
                                  RowHeight="48" MinHeight="160">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Finished Product" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ManufacturedProducts}"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                      IsEditable="True" IsTextSearchEnabled="True"
                                                      Height="34" Padding="6,0" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                                      SelectionChanged="ProductSelectionChanged" LostFocus="ProductComboBox_LostFocus"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit: Typeable / Editable -->
                                <DataGridTemplateColumn Header="Unit" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="12">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Size -->
                                <DataGridTemplateColumn Header="Size" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="12">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Qty -->
                                <DataGridTemplateColumn Header="Qty" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="12">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Click="DeleteItem_Click" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0"
                                                    Width="28" Height="28" Cursor="Hand" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Notes Section -->
            <Border Grid.Row="3" Background="White" Padding="14" Margin="0,0,0,14" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNotes" Height="50" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#E1E5EC" Padding="8,6"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <DockPanel Grid.Row="4" Margin="0,4,0,0">
                <Button x:Name="BtnDeleteOrder" Content="🗑 Delete Order" Click="Delete_Click" Height="36" Padding="14,0"
                        Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" FontWeight="SemiBold" Cursor="Hand" Visibility="Collapsed">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Height="36" Padding="16,0" Background="White" BorderBrush="#E1E5EC" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="Save Work Order" Click="Save_Click" Height="36" Padding="18,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
