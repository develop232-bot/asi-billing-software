<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.WorkOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Order" Height="730" Width="880"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E5A62E" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="New Production Work Order" FontSize="20" FontWeight="Bold" Foreground="#152039"/>
        </Border>

        <!-- Basic Info -->
        <Border Grid.Row="1" Background="White" Padding="18" Margin="0,0,0,14" BorderBrush="#E1E5EC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Work Order No." FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOrderNo" IsReadOnly="True" Background="#F6F7FA" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Customer / Order For" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCustomer" Padding="8" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Order Type" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbOrderType" Padding="8">
                        <ComboBoxItem Content="General / stock" Tag="general" IsSelected="True"/>
                        <ComboBoxItem Content="Domestic" Tag="domestic"/>
                        <ComboBoxItem Content="Export" Tag="export"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Order Date" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpOrderDate" Padding="6"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Due Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDueDate" Padding="6"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Production Status" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbStatus" Padding="8">
                        <ComboBoxItem Content="Pending" IsSelected="True"/>
                        <ComboBoxItem Content="Cutting"/>
                        <ComboBoxItem Content="Stitching"/>
                        <ComboBoxItem Content="Lasting &amp; pressing"/>
                        <ComboBoxItem Content="Finishing"/>
                        <ComboBoxItem Content="Packing"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Products to make & Raw Material Consumed -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Products to make -->
            <Border Grid.Column="0" Background="White" Padding="14" Margin="0,0,8,0" BorderBrush="#E1E5EC" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Products to Make" FontWeight="Bold" FontSize="14" Foreground="#152039" VerticalAlignment="Center"/>
                        <Button Content="+ Add Product" Click="AddItem_Click" Margin="12,0,0,0" Padding="8,3" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid x:Name="DgItems" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Finished Product" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ManufacturedProducts}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="ProductSelectionChanged" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="65"/>

                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="DeleteItem_Click" Foreground="#C23A32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Raw Material Consumed -->
            <Border Grid.Column="1" Background="White" Padding="14" Margin="8,0,0,0" BorderBrush="#E1E5EC" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Raw Material Consumed" FontWeight="Bold" FontSize="14" Foreground="#152039" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="⚡ Suggest from Recipe" Click="SuggestRecipe_Click" Padding="8,3" Background="#E5A62E" Foreground="#7A5210" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <Button Content="+ Add" Click="AddMat_Click" Padding="8,3" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="DgMaterials" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Raw Material" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableRawMaterials}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="MaterialSelectionChanged" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="70"/>

                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="DeleteMat_Click" Foreground="#C23A32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="Save Work Order" Click="Save_Click" Padding="18,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
