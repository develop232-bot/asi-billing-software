<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Logins &amp; Access Control"
        Height="700" Width="1060"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="960" MinHeight="580"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Light Theme Dropdown / ComboBox Style -->
        <Style x:Key="LightComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LightComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="12" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Staff Logins &amp; Role Access Control" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Create, configure credentials, and manage role permissions for Admin, Store Keeper, and Finance staff." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Grid: Left Form (Create) + Right List (Existing) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Add New User Form Card -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="20,18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Create Staff Login" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="New User" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                        </DockPanel>

                        <!-- Full Name -->
                        <TextBlock Text="Full Name" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFullName" Height="34" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="12.5"/>

                        <!-- Username -->
                        <TextBlock Text="Username / Login ID *" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="34" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="12.5"/>

                        <!-- Password -->
                        <TextBlock Text="Password *" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" Height="34" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,12,0" VerticalContentAlignment="Center" FontSize="12.5"/>

                        <!-- Role Selection (Direct Clickable Cards - No Dropdown Glitches) -->
                        <TextBlock Text="Panel Role &amp; Permissions *" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,14">
                            <!-- Administrator Option -->
                            <Border x:Name="CardRoleAdmin" Cursor="Hand" MouseLeftButtonDown="CardRoleAdmin_MouseDown" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <RadioButton x:Name="RbRoleAdmin" GroupName="StaffRole" IsChecked="True" Checked="RoleRadio_Checked" Tag="admin" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="👑 Administrator (Full Access)" FontWeight="Bold" FontSize="12" Foreground="#1E3A8A"/>
                                        <TextBlock Text="Complete ERP, financials, analytics, user logins" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Store Keeper Option -->
                            <Border x:Name="CardRoleStore" Cursor="Hand" MouseLeftButtonDown="CardRoleStore_MouseDown" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <RadioButton x:Name="RbRoleStore" GroupName="StaffRole" Checked="RoleRadio_Checked" Tag="storekeeper" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="📦 Store Keeper (Stock &amp; Billing)" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="Stock, materials, production, POS billing &amp; barcodes" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Finance Option -->
                            <Border x:Name="CardRoleFinance" Cursor="Hand" MouseLeftButtonDown="CardRoleFinance_MouseDown" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <RadioButton x:Name="RbRoleFinance" GroupName="StaffRole" Checked="RoleRadio_Checked" Tag="finance" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="💰 Finance &amp; Accounts (Billing &amp; Financials)" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="Retail POS, B2B wholesale, accounts, income &amp; expenses" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button Content="➕ Create Staff Login" Click="CreateUser_Click" Height="40" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Existing Staff Accounts List (Spacious Card Layout - Zero Overlap!) -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20,18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Active Staff Accounts" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock Text="☁️ Auto-synced with Cloud Firestore" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListView x:Name="UsersList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              Padding="0,2,6,2"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="12" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="8" ShadowDepth="1"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Avatar + Full Name + Username Handle + Role Pill Badge -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                            <!-- Right: Role Pill Badge -->
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{Binding RoleBadgeColor}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RoleTitle}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Left: Avatar Circle + Name & Handle -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="19" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Login ID: @" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Username}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Separator Line between Info and Action Buttons -->
                                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#E2E8F0" Margin="0,0,0,-2"/>

                                        <!-- Row 1: Status on Left, Action Buttons on Right -->
                                        <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                            <!-- Left Status indicator -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🟢 Active Staff" FontSize="11.5" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,8,0"/>
                                                <TextBlock Text="• Panel Access Granted" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>

                                            <!-- Right Action Buttons -->
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Reset Password Button -->
                                                <Button Content="🔑 Reset Password" Click="ResetPassword_Click" Tag="{Binding Id}"
                                                        Padding="12,6" Height="32" Background="#FFFFFF" Foreground="#2563EB" BorderBrush="#CBD5E1" BorderThickness="1"
                                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Content="🗑 Delete" Click="DeleteUser_Click" Tag="{Binding Id}"
                                                        Padding="12,6" Height="32" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock Text="☁️ Logins are synchronized with Firebase Cloud Firestore and cached locally for offline sign-in." FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click" Width="100" Height="36" DockPanel.Dock="Right" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
