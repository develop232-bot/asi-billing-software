<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.StockAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Inventory Stock" Height="360" Width="460"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TxtItemName" Text="Item Name" FontSize="16" FontWeight="Bold" Foreground="#152039"/>
                <TextBlock x:Name="TxtCurrentStock" Text="Current Stock: 0" Foreground="#78839A" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Adjustment Type" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbDirection" Padding="8" Margin="0,0,0,12">
                <ComboBoxItem Content="Add to Stock (Received / Found / Opening)" IsSelected="True"/>
                <ComboBoxItem Content="Remove from Stock (Damaged / Sample / Loss)"/>
            </ComboBox>

            <TextBlock Text="Quantity *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtQty" Text="1" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Use this for opening balance adjustments, factory floor corrections, or damaged goods." FontSize="11" Foreground="#78839A" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,6" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Update Stock" Click="Save_Click" Padding="16,6" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
