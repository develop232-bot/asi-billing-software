<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.DomesticInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AsiErp.Helpers"
        Title="New Domestic Tax Invoice" Height="730" Width="960"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E5A62E" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New Domestic Tax Invoice" FontSize="20" FontWeight="Bold" Foreground="#152039"/>
                <TextBlock Text=" (Within India / GST B2B Wholesale)" FontSize="13" Foreground="#78839A" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Customer & Invoice Info (3 Columns Grid) -->
        <Border Grid.Row="1" Background="White" Padding="18" Margin="0,0,0,14" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Company name *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbParty" IsEditable="True" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Invoice no." FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInvoiceNo" Height="36" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F6F7FA" BorderBrush="#E1E5EC" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Company person name" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPerson" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Contact number *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Customer GSTIN" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtGstin" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <!-- Row 3 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Place of supply" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbTaxType" Height="36" SelectionChanged="TaxType_Changed" Padding="10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Within state (CGST + SGST)" IsSelected="True"/>
                        <ComboBoxItem Content="Other state (IGST)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Vehicle no." FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtVehicle" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#E1E5EC"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Sale type" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <Border Background="#F1F3F7" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="RbCash" Content="Cash sale" IsChecked="True" Checked="Terms_Changed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            <RadioButton x:Name="RbCredit" Content="Credit sale" Checked="Terms_Changed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- Row 4 (Credit details) -->
                <StackPanel x:Name="CreditWrap" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Credit period (days):" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCreditDays" Text="30" Width="60" Height="26" Padding="3,0" VerticalContentAlignment="Center" TextAlignment="Center" TextChanged="CreditDays_Changed" FontWeight="Bold"/>
                            <TextBlock Text="days" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="6,0,16,0"/>
                            <TextBlock Text="Payment due:" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtPaymentDueDisplay" FontWeight="Bold" FontSize="12" Foreground="#B45309" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line Items Table -->
        <Border Grid.Row="2" Background="White" Padding="14" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Invoice Items" FontWeight="Bold" FontSize="14" Foreground="#152039" VerticalAlignment="Center"/>
                    <Button Content="+ Add line" Click="AddLine_Click" Margin="16,0,0,0" Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                    <DataGrid x:Name="DgLines" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="48">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- 1. Item -->
                            <DataGridTemplateColumn Header="Item" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableProducts}"
                                                  DisplayMemberPath="FullDisplayName" SelectedValuePath="Id" SelectedValue="{Binding Pid, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" IsTextSearchEnabled="True"
                                                  SelectionChanged="ProductSelectionChanged" Margin="2" Height="34" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. HSN -->
                            <DataGridTextColumn Header="HSN" Binding="{Binding Hsn}" Width="75"/>

                            <!-- 3. Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="75"/>

                            <!-- 4. Qty -->
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="65"/>

                            <!-- 5. Unit -->
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>

                            <!-- 6. Rate (₹) -->
                            <DataGridTextColumn Header="Rate (₹)" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Width="90"/>

                            <!-- 7. Disc % -->
                            <DataGridTextColumn Header="Disc %" Binding="{Binding DiscPercent, UpdateSourceTrigger=PropertyChanged}" Width="65"/>

                            <!-- 8. GST % -->
                            <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent}" Width="70" IsReadOnly="True"/>

                            <!-- 9. Amount -->
                            <DataGridTextColumn Header="Amount (₹)" Binding="{Binding NetAmount, StringFormat={}{0:N2}}" Width="105" IsReadOnly="True"/>

                            <!-- 10. Delete -->
                            <DataGridTemplateColumn Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="DeleteLine_Click" Width="30" Height="30" Cursor="Hand" ToolTip="Remove item" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="7">
                                                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Terms & Tax Summary -->
        <Grid Grid.Row="3" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Info Note -->
            <Border Grid.Column="0" Background="#F8FAFC" Padding="14" Margin="0,0,16,0" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="GST &amp; Billing Notes" FontWeight="Bold" FontSize="12.5" Foreground="#152039" Margin="0,0,0,4"/>
                    <TextBlock Text="• Footwear &amp; Apparel GST: 5% up to ₹2,500/unit, 18% above (GST 2.0)." FontSize="11.5" Foreground="#64748B" Margin="0,0,0,2"/>
                    <TextBlock Text="• Within state supply splits into CGST (50%) + SGST (50%). Other state supply applies IGST (100%)." FontSize="11.5" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Right: Totals Box -->
            <Border Grid.Column="1" Background="White" Padding="14" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Subtotal (Taxable):" Foreground="#48546F" FontSize="12"/>
                        <TextBlock x:Name="TxtSubtotal" Text="₹0.00" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </DockPanel>
                    <DockPanel x:Name="RowCgst" Margin="0,2">
                        <TextBlock Text="CGST:" Foreground="#48546F" FontSize="12"/>
                        <TextBlock x:Name="TxtCgst" Text="₹0.00" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>
                    <DockPanel x:Name="RowSgst" Margin="0,2">
                        <TextBlock Text="SGST:" Foreground="#48546F" FontSize="12"/>
                        <TextBlock x:Name="TxtSgst" Text="₹0.00" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>
                    <DockPanel x:Name="RowIgst" Margin="0,2" Visibility="Collapsed">
                        <TextBlock Text="IGST:" Foreground="#48546F" FontSize="12"/>
                        <TextBlock x:Name="TxtIgst" Text="₹0.00" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>

                    <Border BorderBrush="#E5A62E" BorderThickness="0,2,0,0" Margin="0,6,0,6" Padding="0,6,0,0">
                        <DockPanel>
                            <TextBlock Text="Total:" FontWeight="Bold" FontSize="14" Foreground="#152039"/>
                            <TextBlock x:Name="TxtGrossTotal" Text="₹0.00" FontWeight="Bold" FontSize="16" Foreground="#152039" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <DockPanel Margin="0,2" VerticalAlignment="Center">
                        <TextBlock Text="Received now (₹):" VerticalAlignment="Center" Foreground="#48546F" FontSize="12"/>
                        <TextBox x:Name="TxtPaidNow" Text="0.00" Width="100" Height="36" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextChanged="PaidNow_Changed" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Balance:" Foreground="#48546F" FontSize="12"/>
                        <TextBlock x:Name="TxtBalance" Text="₹0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#DC2626" FontSize="12"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Save invoice" Click="Save_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
