<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment" Height="330" Width="440"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TxtDocHeader" Text="Record Payment" FontSize="16" FontWeight="Bold" Foreground="#152039"/>
                <TextBlock x:Name="TxtBalanceDue" Text="Balance Due: ₹0.00" Foreground="#C23A32" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Payment Amount (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAmount" Padding="8" Margin="0,0,0,14"/>

            <TextBlock Text="Payment Mode" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbMode" Padding="8">
                <ComboBoxItem Content="Bank Transfer / NEFT / RTGS" IsSelected="True"/>
                <ComboBoxItem Content="UPI"/>
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Cheque"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,6" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Save Payment" Click="Save_Click" Padding="16,6" Background="#1B8556" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
