<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.BarcodePrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Barcode Label" Height="520" Width="480"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" ResizeMode="NoResize">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🖨️ Product Barcode Label" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Standard retail sticker label for price tags and packaging" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Label Preview Container (Exact representation of standard 50mm x 35mm label) -->
        <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Actual Printable Label Element -->
            <Border x:Name="PrintableLabel" Background="White" Width="360" CornerRadius="8" Padding="14,12" BorderBrush="#94A3B8" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Brand Name -->
                    <TextBlock Text="AFRAH SAMIYA INDUSTRIES" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="SHOES &amp; UNIFORMS · FOOTWEAR DIVISION" FontSize="8.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,1,0,6"/>

                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,6"/>

                    <!-- Product Name -->
                    <TextBlock x:Name="TxtProdName" Text="Leather Formal Shoe" FontWeight="Bold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>

                    <!-- Category / SKU / Size Tag Line -->
                    <DockPanel HorizontalAlignment="Center" Margin="0,3,0,6">
                        <TextBlock x:Name="TxtSku" Text="SKU: ASI-MFG-001" FontSize="10" Foreground="#475569" Margin="0,0,10,0"/>
                        <TextBlock Text="·" Foreground="#94A3B8" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtSize" Text="Size: 8" FontWeight="Bold" FontSize="10" Foreground="#1E293B"/>
                    </DockPanel>

                    <!-- Real Vector Barcode Image -->
                    <Border Background="White" Padding="6,4" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Image x:Name="ImgBarcode" Width="260" Height="78" Stretch="Uniform"/>
                    </Border>

                    <Border Height="1" Background="#E2E8F0" Margin="0,4,0,6"/>

                    <!-- MRP and Tax info -->
                    <DockPanel HorizontalAlignment="Stretch" Margin="8,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MAX RETAIL PRICE" FontSize="8" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="(Incl. of all taxes)" FontSize="7.5" Foreground="#94A3B8"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMrp" Text="₹ 2,499.00" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Options: Size selection and Copies -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14,10" Margin="0,14,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Size Selector -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Select Size on Label" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbSize" IsEditable="True" IsTextSearchEnabled="True"
                              SelectionChanged="CbSize_SelectionChanged" LostFocus="CbSize_LostFocus" KeyUp="CbSize_KeyUp"
                              Padding="6,4" FontSize="12"/>
                </StackPanel>

                <!-- Copies -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Number of Labels / Copies" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Click="DecCopies_Click" Width="32" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                        <TextBox x:Name="TxtCopies" Text="1" Width="60" Height="32" Margin="6,0" Padding="0"
                                 Background="White" Foreground="#0F172A" CaretBrush="#0F172A"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 FontWeight="Bold" FontSize="15" BorderBrush="#0284C7" BorderThickness="1.5"/>
                        <Button Content="+" Click="IncCopies_Click" Width="32" Height="32" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#CBD5E1" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="🖨️ Print Labels" Click="Print_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>