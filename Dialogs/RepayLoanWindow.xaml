<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.RepayLoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repay Loan" Height="480" Width="480"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="CanResizeWithGrip"
        MinWidth="420" MinHeight="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="💳" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Repay Loan" FontSize="16" FontWeight="Bold" Foreground="#152039"/>
                    <TextBlock Text="Record an installment or partial repayment for this loan." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Loan info banner -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtLenderBanner" Text="State Bank term loan" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtBalanceBanner" Text="Balance: ₹9,50,000" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Repayment Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Padding="6"/>
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Loan Part (Principal ₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPrincipal" Text="0" Padding="8" FontWeight="Bold" FontSize="13" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Interest Part (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInterest" Text="0" Padding="8" FontWeight="Bold" FontSize="13" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBlock Text="Your bank statement splits each instalment into a loan principal part and an interest part. Interest is counted as an expense in Profit &amp; Loss." FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Save Payment" Click="Save_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
