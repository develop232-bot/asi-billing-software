<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.InvestmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Capital Investment" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" Background="#F1F3F7" ResizeMode="CanResizeWithGrip"
        MinWidth="480" MinHeight="480">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="💎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Record Capital Investment" FontSize="16" FontWeight="Bold" Foreground="#152039"/>
                    <TextBlock Text="Log equity, partner capital, machinery funding, or seed investments." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Investment Date *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpDate" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Amount (₹) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAmount" Padding="8" FontWeight="Bold" FontSize="13" BorderBrush="#E1E5EC"/>
                    </StackPanel>
                </Grid>

                <!-- Invested By with dropdown choices -->
                <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Invested By (Investor / Partner) *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" VerticalAlignment="Center"/>
                        <TextBlock Text="Choose preset or type name" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="CbInvestedBy" IsEditable="True" Text="Promoter – Director 1" Padding="8" BorderBrush="#E1E5EC">
                        <ComboBoxItem Content="Promoter – Director 1"/>
                        <ComboBoxItem Content="Promoter – Director 2"/>
                        <ComboBoxItem Content="Managing Director"/>
                        <ComboBoxItem Content="Working Partner"/>
                        <ComboBoxItem Content="External Angel / Seed Capital"/>
                        <ComboBoxItem Content="Retained Profits Reinvestment"/>
                    </ComboBox>
                </StackPanel>

                <!-- Purpose / Allocation with dropdown choices -->
                <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Purpose / Capital Allocation *" FontWeight="SemiBold" FontSize="12" Foreground="#48546F" VerticalAlignment="Center"/>
                        <TextBlock Text="Select allocation or type custom" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="CbPurpose" IsEditable="True" Text="Shoe Stitching &amp; Sole Moulding Machinery" Padding="8" BorderBrush="#E1E5EC">
                        <ComboBoxItem Content="Shoe Stitching &amp; Sole Moulding Machinery"/>
                        <ComboBoxItem Content="Factory Infrastructure &amp; Electric Power Setup"/>
                        <ComboBoxItem Content="Bulk Raw Material Purchase Advance"/>
                        <ComboBoxItem Content="Sole Moulds, Lasts &amp; Tooling Dies"/>
                        <ComboBoxItem Content="Showroom &amp; Retail Outlet Interior Setup"/>
                        <ComboBoxItem Content="Working Capital &amp; Liquidity Buffer"/>
                        <ComboBoxItem Content="Delivery Van / Logistics Vehicle"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="ChkPre" Content="Capital invested prior to commercial operations commencement" IsChecked="True" Margin="0,4,0,10" Foreground="#334155" FontSize="11.5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Background="White" BorderBrush="#E1E5EC" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Content="Save Investment" Click="Save_Click" Padding="20,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
