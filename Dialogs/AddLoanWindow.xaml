<Window Icon="pack://application:,,,/Assets/app.ico" x:Class="AsiErp.Dialogs.AddLoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Loan" Height="720" Width="720"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" ResizeMode="CanResizeWithGrip"
        MinWidth="640" MinHeight="580">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="🏦" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Add Loan" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtHeaderSub" Text="Record borrowed money or edit full loan details, interest rates, and repayment history." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- Live KPI Summary Banner -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <!-- 1. Total Loan Amount -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="LOAN AMOUNT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSummaryAmount" Text="₹0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Total Principal Repaid -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL REPAID" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSummaryRepaid" Text="₹0" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Remaining Balance -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="REMAINING BALANCE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSummaryBalance" Text="₹0" FontSize="16" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Status Badge -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="LOAN STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <Border x:Name="BorderSummaryStatus" Background="#FEF3C7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtSummaryStatus" Text="Open" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- SECTION 1: Loan Information -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Loan Terms &amp; Primary Details" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Lender & Date -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Lender (Bank or Person) *" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtLender" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Date Taken / Received *" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DpDate" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Loan Amount & Interest Rate -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Loan Amount (₹) *" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAmount" TextChanged="TxtAmount_TextChanged" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Interest % per year *" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtInterestRate" Text="10.0" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status & Purpose / Note -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Loan Status *" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CbStatus" SelectionChanged="CbStatus_SelectionChanged" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" SelectedIndex="0">
                                    <ComboBoxItem Content="Open (Active Loan)"/>
                                    <ComboBoxItem Content="Closed (Fully Settled / Repaid)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Purpose / Note (e.g. MACHINERY, Working Capital)" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtNote" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Repayment History & Installments -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Repayment History &amp; Installments" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Edit recorded payments, delete errors, or record installments to update balance." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Repayments DataGrid -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Margin="0,0,0,12" MaxHeight="220">
                            <DataGrid x:Name="DgRepayments" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                                      Background="Transparent" MinRowHeight="38" CellEditEnding="DgRepayments_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Payment Date" Binding="{Binding Date, UpdateSourceTrigger=LostFocus}" Width="140"/>
                                    <DataGridTextColumn Header="Principal (₹)" Binding="{Binding Principal, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}" Width="140" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Interest (₹)" Binding="{Binding Interest, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}" Width="120"/>
                                    <DataGridTextColumn Header="Total Paid (₹)" Binding="{Binding TotalPayment, Mode=OneWay, StringFormat={}{0:N0}}" Width="130" IsReadOnly="True" FontWeight="Bold" Foreground="#0F172A"/>
                                    <DataGridTemplateColumn Header="Action" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑 Delete" Click="DeleteRepayment_Click" Padding="6,2" Background="White" Foreground="#DC2626"
                                                        BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Empty State Notice -->
                        <TextBlock x:Name="TxtNoRepayments" Text="No repayment installments recorded yet for this loan." FontSize="11.5" Foreground="#94A3B8" FontStyle="Italic" Margin="4,0,0,10" Visibility="Collapsed"/>

                        <!-- Add Installment Form -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="+ Record New Repayment Installment" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Date" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <DatePicker x:Name="DpNewRepDate" Height="32" Padding="4,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Principal (₹)" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtNewRepPrincipal" Text="0" Height="32" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Interest (₹)" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtNewRepInterest" Text="0" Height="32" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                        <Button Content="+ Add Installment" Click="BtnAddInstallment_Click" Height="32" Padding="14,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="11.5">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtFooterHint" Text="Principal reduces loan liability on Balance Sheet; interest is counted as an expense." VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Height="36" Padding="16,0" Background="White" BorderBrush="#CBD5E1" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnSave" Content="Save Loan" Click="Save_Click" Height="36" Padding="20,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>