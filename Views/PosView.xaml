<UserControl x:Class="AsiErp.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Retail Billing (POS)" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Showroom and exhibition counter. Fast billing with automatic barcode scanning and bulk rates." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#FEF3C7" CornerRadius="10" Padding="14,6" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextBillNo, StringFormat='Next Bill: {0}'}" FontWeight="Bold" Foreground="#92400E" FontSize="12"/>
                </Border>
            </DockPanel>

            <!-- Main POS Layout: Catalog on Left, Cart on Right -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Catalog -->
                <Border Grid.Column="0" Background="White" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <DockPanel>
                        <!-- Quick Add Bar & Barcode Scanner -->
                        <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                            <StackPanel>
                                <!-- Barcode Quick Scanner Line -->
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" BorderBrush="#C7D2FE" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Scan &amp; Add" Command="{Binding ScanBarcodeCommand}" Background="#4F46E5" Foreground="White" BorderThickness="0" Padding="16,6" Cursor="Hand" FontWeight="Bold" FontSize="11.5" Margin="8,0,0,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📷" FontSize="13" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="TxtBarcodeScan" Text="{Binding ScannedBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Foreground="#0F172A" CaretBrush="#0F172A"
                                                         Padding="4,0" FontSize="12.5" FontFamily="Consolas, Segoe UI" VerticalContentAlignment="Center"
                                                         ToolTip="Scan barcode or type SKU and press Enter">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding ScanBarcodeCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="⚡ Quick Add to Bill" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <TextBlock Text="Select item from dropdown or scan barcode directly" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product Dropdown with Type-to-Search and Choose from Dropdown -->
                                    <ComboBox x:Name="CbQuickAdd" Grid.Column="0"
                                              ItemsSource="{Binding AvailableProducts}"
                                              SelectedItem="{Binding QuickAddItem}"
                                              Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              TextSearch.TextPath="Name"
                                              DropDownOpened="CbQuickAdd_DropDownOpened"
                                              Padding="10,6" Margin="0,0,8,0"
                                              Height="36" FontSize="12.5" VerticalContentAlignment="Center">
                                        <ComboBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding QuickAddCommand}"/>
                                        </ComboBox.InputBindings>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,4">
                                                    <DockPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayBarcode, StringFormat='[{0}]'}" FontSize="9.5" Foreground="#4F46E5" FontFamily="Consolas, Segoe UI" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Stock, StringFormat='{}{0:N0} in stock'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RetailPrice, Converter={StaticResource InrConv}}" FontWeight="Bold" FontSize="12.5" Foreground="#1D4ED8" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding BulkPrice, StringFormat='Bulk: ₹{0:N0}'}" FontSize="10" Foreground="#D97706" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="1" Text="{Binding QuickAddQty}" Padding="4,0" Margin="0,0,8,0" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                                    <Button Grid.Column="2" Content="+ Add to Bill" Command="{Binding QuickAddCommand}" Background="#172443" Foreground="White" BorderThickness="0" Padding="18,0" Height="36" Cursor="Hand" FontWeight="Bold" FontSize="12">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Search & Filter Bar -->
                        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="240" Padding="10,7" Margin="0,0,14,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetCategoryCommand}" CommandParameter="all" Margin="0,0,6,0" Padding="14,6"
                                            Background="{Binding SelectedCategory, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedCategory, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedCategory, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="Shoe" Command="{Binding SetCategoryCommand}" CommandParameter="Shoe" Margin="0,0,6,0" Padding="14,6"
                                            Background="{Binding SelectedCategory, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Shoe}"
                                            Foreground="{Binding SelectedCategory, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Shoe}"
                                            BorderBrush="{Binding SelectedCategory, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Shoe}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="Uniform" Command="{Binding SetCategoryCommand}" CommandParameter="Uniform" Margin="0,0,6,0" Padding="14,6"
                                            Background="{Binding SelectedCategory, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Uniform}"
                                            Foreground="{Binding SelectedCategory, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Uniform}"
                                            BorderBrush="{Binding SelectedCategory, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Uniform}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="Accessory" Command="{Binding SetCategoryCommand}" CommandParameter="Accessory" Padding="14,6"
                                            Background="{Binding SelectedCategory, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Accessory}"
                                            Foreground="{Binding SelectedCategory, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Accessory}"
                                            BorderBrush="{Binding SelectedCategory, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Accessory}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Products List -->
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <StackPanel MaxWidth="320">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,3,0,0">
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Stock, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Unit, Mode=OneWay}"/>
                                                        <Run Text=" in stock"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#475569" FontFamily="Consolas, Segoe UI" Margin="0,2,0,0">
                                                        <Run Text="Barcode: "/><Run Text="{Binding DisplayBarcode, Mode=OneWay}" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Right" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding RetailPrice, Converter={StaticResource InrConv}}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding BulkPrice, StringFormat='Bulk: ₹{0:N0}'}" FontSize="11" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right"/>
                                                    </StackPanel>

                                                    <Button Content="+ Add" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Background="#172443" Foreground="White" BorderThickness="0" Padding="14,6" Cursor="Hand" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- RIGHT: Cart -->
                <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Current Bill" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding CartItems.Count, StringFormat='({0} items)'}" Foreground="#64748B" Margin="6,2,0,0"/>
                        </DockPanel>

                        <!-- Cart Line Items -->
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding CartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <StackPanel MaxWidth="190">
                                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <!-- Size Dropdown -->
                                                        <ComboBox ItemsSource="{Binding Product.Sizes}" SelectedItem="{Binding SelectedSize}" Width="65" Margin="0,0,6,0" Padding="3" FontSize="11"/>
                                                        <!-- Qty Controls -->
                                                        <Button Content="−" Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" Padding="0"/>
                                                        <TextBlock Text="{Binding Qty}" Width="26" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Button Content="+" Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" Padding="0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LineTotal, Converter={StaticResource InrConv}}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Bulk Rate Applied" Visibility="{Binding IsBulkRateApplied, Converter={StaticResource BoolToVis}}" FontSize="9" Foreground="#D97706" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bill Totals -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="Subtotal (MRP):" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding Subtotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="Discount %:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" Padding="4" HorizontalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="GST Included:" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding GstIncluded, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Border BorderBrush="#F59E0B" BorderThickness="0,1,0,0" Margin="0,8" Padding="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Payable:" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding GrandTotal, Converter={StaticResource InrConv}}" FontWeight="Bold" FontSize="18" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Payment & Customer Inputs -->
                        <StackPanel Margin="0,0,0,8">
                            <!-- Payment Mode Chips -->
                            <TextBlock Text="Payment Mode" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button Content="Cash" Command="{Binding SetPaymentModeCommand}" CommandParameter="Cash" Margin="0,0,4,0" Padding="8"
                                        Background="{Binding PaymentMode, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Cash}"
                                        Foreground="{Binding PaymentMode, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Cash}"
                                        BorderBrush="{Binding PaymentMode, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Cash}"
                                        BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="UPI" Command="{Binding SetPaymentModeCommand}" CommandParameter="UPI" Margin="0,0,4,0" Padding="8"
                                        Background="{Binding PaymentMode, Converter={StaticResource TabActiveBgConv}, ConverterParameter=UPI}"
                                        Foreground="{Binding PaymentMode, Converter={StaticResource TabActiveFgConv}, ConverterParameter=UPI}"
                                        BorderBrush="{Binding PaymentMode, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=UPI}"
                                        BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Card" Command="{Binding SetPaymentModeCommand}" CommandParameter="Card" Padding="8"
                                        Background="{Binding PaymentMode, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Card}"
                                        Foreground="{Binding PaymentMode, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Card}"
                                        BorderBrush="{Binding PaymentMode, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Card}"
                                        BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                            </UniformGrid>

                            <!-- Location -->
                            <TextBlock Text="Sold At Location" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SoldAtLocation, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"/>

                            <!-- Customer Info -->
                            <TextBlock Text="Customer Name *" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"/>

                            <TextBlock Text="Phone Number *" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,14"/>

                            <!-- Complete Sale Button -->
                            <Button Content="Complete Sale &amp; Print Bill" Command="{Binding CompleteSaleCommand}" Height="42" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#10B981" Opacity="0.25"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Retail Bills Table -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent Retail Bills" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding RecentBills}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38" MinWidth="750">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bill No" Binding="{Binding InvoiceNo}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                <DataGridTemplateColumn Header="Customer" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Sold At" Binding="{Binding Event}" Width="130"/>
                                <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="80"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="110" FontWeight="SemiBold"/>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="View" Command="{Binding DataContext.ViewBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>