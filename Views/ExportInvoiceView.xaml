<UserControl x:Class="AsiErp.Views.ExportInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 1. Top Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Sales &amp; Billing · Export Invoice" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Overseas direct export billing (Zero-Rated GST supply under Letter of Undertaking - LUT)" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Reset" Command="{Binding ResetFormCommand}"
                            Padding="12,6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                            Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Save Export Invoice" Command="{Binding SaveInvoiceCommand}"
                            Padding="16,8" Background="#0D9488" Foreground="#FFFFFF" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold" FontSize="12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- 2. Form Grid (3 Columns) - Matching Prototype Option & Alignment -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ROW 1 -->
                    <!-- Company name (buyer) with suggestions -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Company name (buyer) *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BuyerSuggestions}"
                                  Text="{Binding BuyerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"/>
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Date *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding InvoiceDate, Mode=TwoWay}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Invoice no. -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Invoice no." FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InvoiceNo}" IsReadOnly="True" Background="#F8FAFC" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>

                    <!-- ROW 2 -->
                    <!-- Company person name -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Company person name" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Contact number * -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Contact number *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Sale type (Cash / Credit) -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Sale type" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="36" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Cash sale"
                                             IsChecked="{Binding IsCash, Mode=TwoWay}"
                                             GroupName="ExpSaleType"
                                             Style="{StaticResource SegmentRadioButtonStyle}"/>
                                <Rectangle Grid.Column="1" Fill="#CBD5E1"/>
                                <RadioButton Grid.Column="2" Content="Credit sale"
                                             IsChecked="{Binding IsCredit, Mode=TwoWay}"
                                             GroupName="ExpSaleType"
                                             Style="{StaticResource SegmentRadioButtonStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ROW 3 -->
                    <!-- Destination Country -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Country" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Country, Mode=TwoWay}" IsEditable="True" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12">
                            <ComboBoxItem Content="UAE"/>
                            <ComboBoxItem Content="Saudi Arabia"/>
                            <ComboBoxItem Content="Qatar"/>
                            <ComboBoxItem Content="Oman"/>
                            <ComboBoxItem Content="Kuwait"/>
                            <ComboBoxItem Content="Bahrain"/>
                            <ComboBoxItem Content="Other (USD)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Currency -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Currency" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Currency, Mode=TwoWay}" IsEditable="True" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12">
                            <ComboBoxItem Content="AED"/>
                            <ComboBoxItem Content="SAR"/>
                            <ComboBoxItem Content="QAR"/>
                            <ComboBoxItem Content="OMR"/>
                            <ComboBoxItem Content="KWD"/>
                            <ComboBoxItem Content="BHD"/>
                            <ComboBoxItem Content="USD"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- ₹ per 1 Currency -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4">
                            <Run Text="₹ per 1 "/>
                            <Run Text="{Binding Currency, Mode=OneWay}"/>
                            <Run Text=" (edit for today's rate)"/>
                        </TextBlock>
                        <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- ROW 4 -->
                    <!-- Incoterm -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Incoterm" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding Incoterm, Mode=TwoWay}" IsEditable="True" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12">
                            <ComboBoxItem Content="FOB"/>
                            <ComboBoxItem Content="CIF"/>
                            <ComboBoxItem Content="CFR"/>
                            <ComboBoxItem Content="EXW"/>
                            <ComboBoxItem Content="DDP"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Port of Loading -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Port of loading" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PortOfLoading, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Port of Discharge -->
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Port of discharge" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PortOfDischarge, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- ROW 5 (Credit details if Credit sale) -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Credit period (days):" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding CreditDays, UpdateSourceTrigger=PropertyChanged}" Width="65" Height="28" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold" BorderBrush="#F59E0B"/>
                                <TextBlock Text="days" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="8,0,16,0"/>
                                <TextBlock Text="Payment due:" FontWeight="SemiBold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PaymentDueDateDisplay}" FontWeight="Bold" FontSize="12" Foreground="#B45309" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Export Line Items Table Card -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Export Line Items" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="+ Add line" Command="{Binding AddLineCommand}" HorizontalAlignment="Right"
                                Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </DockPanel>

                    <!-- ScrollViewer with Hidden horizontal scrollbar and ample row height so controls never cut off -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White"
                                  RowHeight="50">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- 1. Item -->
                                <DataGridTemplateColumn Header="Item" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.AvailableProducts}"
                                                      SelectedValuePath="Id" SelectedValue="{Binding Pid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="2,0" FontSize="12"
                                                      IsTextSearchEnabled="True" TextSearch.TextPath="FullDisplayName"
                                                      SelectionChanged="ProductSelectionChanged" LostFocus="ProductComboBox_LostFocus">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,3">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Stock, StringFormat='{}{0:N0} in stock'}" FontSize="10.5" Foreground="#64748B" Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 2. HSN -->
                                <DataGridTemplateColumn Header="HSN" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Hsn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                                                     FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 3. Size -->
                                <DataGridTemplateColumn Header="Size" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableSizes}"
                                                      Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                      FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 4. Qty -->
                                <DataGridTemplateColumn Header="Qty" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 5. Unit -->
                                <DataGridTemplateColumn Header="Unit" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                                                     FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 6. Rate (Foreign Currency) -->
                                <DataGridTemplateColumn Header="Rate" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 7. Disc % -->
                                <DataGridTemplateColumn Header="Disc %" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DiscPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontSize="12" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 8. Amount (Foreign Currency) -->
                                <DataGridTemplateColumn Header="Amount" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="6" Height="34" Padding="8,0" Margin="2,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NetAmount, Converter={StaticResource InrConv}}"
                                                           FontWeight="Bold" FontSize="12" Foreground="#0D9488" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 9. Delete Button (Prominent, unclipped X) -->
                                <DataGridTemplateColumn Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteLineCommand}" CommandParameter="{Binding}"
                                                    Width="30" Height="30" Cursor="Hand" ToolTip="Remove item"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="7">
                                                            <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 4. Bottom Summary & Totals Box (Matching HTML Prototype) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Right: Totals Box -->
                <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <!-- Subtotal -->
                        <DockPanel Margin="0,3">
                            <TextBlock Foreground="#64748B" FontSize="12.5">
                                <Run Text="Subtotal ("/>
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12.5">
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SubtotalCurrency, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- GST (export under LUT - zero rated) -->
                        <DockPanel Margin="0,3">
                            <TextBlock Text="GST (export under LUT – zero rated)" Foreground="#64748B" FontSize="12.5"/>
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#10B981" FontSize="12.5">
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=" 0.00"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Total (Large Bold with Dashed Border) -->
                        <Border BorderBrush="#E5A62E" BorderThickness="0,2,0,0" Margin="0,8,0,8" Padding="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="#0F172A">
                                    <Run Text="{Binding Currency, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding GrossAmountCurrency, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Equivalent in rupees -->
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Equivalent in rupees" Foreground="#64748B" FontSize="12.5"/>
                            <TextBlock Text="{Binding GrossAmountInr, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0D9488" FontSize="13.5"/>
                        </DockPanel>

                        <!-- Received Now (Cur) Display -->
                        <DockPanel Margin="0,4" VerticalAlignment="Center">
                            <TextBlock Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center">
                                <Run Text="Received now ("/>
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#10B981" FontSize="12.5">
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding PaidNow, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Balance -->
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Balance" Foreground="#64748B" FontSize="12.5"/>
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#DC2626" FontSize="12.5">
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding BalanceAmountCurrency, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Payment due (if credit) -->
                        <DockPanel Margin="0,4" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Payment due" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding PaymentDueDateDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#D97706" FontSize="12"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Advance / payment received Section (Exact Match to Prototype & Screenshot) -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,16,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header with Quick fill: 25%, 50%, 100% -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Quick fill" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="25%" Command="{Binding QuickFillCommand}" CommandParameter="25"
                                    Padding="12,5" Margin="0,0,6,0" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Cursor="Hand" FontSize="11.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="50%" Command="{Binding QuickFillCommand}" CommandParameter="50"
                                    Padding="12,5" Margin="0,0,6,0" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Cursor="Hand" FontSize="11.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="100%" Command="{Binding QuickFillCommand}" CommandParameter="100"
                                    Padding="12,5" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Cursor="Hand" FontSize="11.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Advance / payment received" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Divider -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>

                    <!-- 4 Fields in One Row: Amount received, Received on, Mode, Reference / cheque no. -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <!-- 1. Amount received (Cur) -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6">
                                <Run Text="Amount received ("/>
                                <Run Text="{Binding Currency, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <TextBox Text="{Binding PaidNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                     Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"
                                     FontWeight="SemiBold" FontSize="12.5">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- 2. Received on -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Received on" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding ReceivedDate, Mode=TwoWay}" Height="36" Padding="6,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- 3. Mode -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Mode" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailablePaymentModes}" SelectedItem="{Binding PaymentMode, Mode=TwoWay}"
                                      Height="36" Padding="8,0" VerticalContentAlignment="Center">
                                <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>

                        <!-- 4. Reference / cheque no. -->
                        <StackPanel>
                            <TextBlock Text="Reference / cheque no." FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PaymentReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12.5">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Bottom Buttons: Cancel and Save invoice -->
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding BackToSalesCommand}"
                                    Height="38" Padding="20,0" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Cursor="Hand" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Save invoice" Command="{Binding SaveInvoiceCommand}"
                                    Height="38" Padding="24,0" Background="#0D9488" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" FontWeight="Bold" FontSize="12.5">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
