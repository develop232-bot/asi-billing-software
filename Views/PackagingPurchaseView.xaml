<UserControl x:Class="AsiErp.Views.PackagingPurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToIndexConverter x:Key="BoolToIndexConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Top Header & Navigation -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="📦 General Packaging Sourcing" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Reset" Command="{Binding ResetFormCommand}"
                            Padding="12,6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                            Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="💾 Save Bill" Command="{Binding SaveBillCommand}"
                            Padding="16,8" Background="#0891B2" Foreground="#FFFFFF" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold" FontSize="12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Vendor & Inward Bill Information Card -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Supplier Name -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Packaging Supplier Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Phone Number -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Supplier Phone Number *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VendorPhone, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Inward Bill Date -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Bill Date *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding BillDate, Mode=TwoWay}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Vendor Invoice / Challan Ref -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Supplier Invoice / Challan No." FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VendorInvoiceRef, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Vendor GSTIN -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Supplier GSTIN (Optional)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VendorGstin, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Purchase type (Segmented Control matching prototype) -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Purchase type" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="36" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Cash purchase"
                                             IsChecked="{Binding IsCash, Mode=TwoWay}"
                                             GroupName="TermsGenTop"
                                             Style="{StaticResource SegmentRadioButtonStyle}"/>
                                <Rectangle Grid.Column="1" Fill="#CBD5E1"/>
                                <RadioButton Grid.Column="2" Content="Credit purchase"
                                             IsChecked="{Binding IsCredit, Mode=TwoWay}"
                                             GroupName="TermsGenTop"
                                             Style="{StaticResource SegmentRadioButtonStyle}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Credit period:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding CreditDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" BorderBrush="#CBD5E1" FontWeight="Bold"/>
                            <TextBlock Text="days" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Line Items Table Card -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Packaging Items" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock Text=" (Boxes, Poly Bags, Cartons, Tapes, Hang Tags, Consumables)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="➕ Add Packaging Item" Command="{Binding AddLineCommand}" HorizontalAlignment="Right"
                                Padding="14,6" Background="#0891B2" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White"
                                  RowHeight="50" MinWidth="850">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Packaging Item Selection / Custom Name -->
                                <DataGridTemplateColumn Header="Packaging Item (Select or Type Name)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.AvailableItems}"
                                                      DisplayMemberPath="DisplayText" SelectedValuePath="Id" SelectedValue="{Binding ItemId, Mode=TwoWay}"
                                                      Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                      IsEditable="True" Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="2,0" FontSize="12.5"
                                                      IsTextSearchEnabled="True" TextSearch.TextPath="DisplayText">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,3">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Border Background="#ECFEFF" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                                        <TextBlock Text="{Binding Sku}" FontSize="10" FontWeight="Bold" Foreground="#0891B2"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Stock, StringFormat='{}{0:N0} in stock'}" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit -->
                                <DataGridTemplateColumn Header="Unit" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Inward Quantity -->
                                <DataGridTemplateColumn Header="Qty" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Rate (₹) -->
                                <DataGridTemplateColumn Header="Unit Rate (₹)" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="8,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- GST % -->
                                <DataGridTemplateColumn Header="GST %" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding GstPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Gross Amount -->
                                <DataGridTemplateColumn Header="Total (₹)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="6" Height="34" Padding="8,0" Margin="2,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GrossAmount, StringFormat='{}{0:N2}'}"
                                                           FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete Row Button -->
                                <DataGridTemplateColumn Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteLineCommand}"
                                                    CommandParameter="{Binding}" Width="30" Height="30" Cursor="Hand" ToolTip="Remove item"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="7">
                                                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom Summary & Actions -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Right: Totals Box -->
                <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Subtotal (Taxable):" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Subtotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Input GST Credit:" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TaxAmount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </DockPanel>
                        <Border Background="#E2E8F0" Height="1" Margin="0,8"/>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Total Bill:" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding GrossAmount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="17" Foreground="#0891B2"/>
                        </DockPanel>

                        <DockPanel Margin="0,10,0,6" VerticalAlignment="Center">
                            <TextBlock Text="Paid Now (₹):" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PaidNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                     Width="130" Height="36" HorizontalAlignment="Right" Padding="8,0" VerticalContentAlignment="Center" TextAlignment="Right" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,14" VerticalAlignment="Center">
                            <TextBlock Text="Balance Payable (₹):" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BalancePayable, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#DC2626"/>
                        </DockPanel>

                        <Button Content="💾 Save Purchase Bill" Command="{Binding SaveBillCommand}"
                                Height="42" Background="#0891B2" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="13">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Bills Section -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recent Packaging Bills" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock Text="Audit log and invoices of all recent packaging and supplies purchases" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding RecentBills}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeight="42" MinWidth="850">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                <DataGridTextColumn Header="Bill No." Binding="{Binding BillNo}" Width="135" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Supplier" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Contact" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Supplier Ref" Binding="{Binding VendorBillRef}" Width="110"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="120" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Payment" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="175" MinWidth="175">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="View / Print" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ViewBillCommand}"
                                                        CommandParameter="{Binding}" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11" Margin="0,0,6,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteBillCommand}"
                                                        CommandParameter="{Binding}" Padding="8,4" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
