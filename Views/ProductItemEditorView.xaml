<UserControl x:Class="AsiErp.Views.ProductItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch">
            <!-- Top Header & Navigation Bar (Responsive WrapPanel) -->
            <DockPanel Margin="0,0,0,14">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Print Barcode" Command="{Binding PrintBarcodeCommand}"
                            Visibility="{Binding ProductVisibility}"
                            Height="34" Padding="12,0" Background="#EEF2FF" Foreground="#4338CA" BorderBrush="#C7D2FE" BorderThickness="1"
                            Cursor="Hand" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Bulk CSV Upload" Command="{Binding BulkUploadCommand}"
                            Height="34" Padding="12,0" Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1"
                            Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="{Binding TopSaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                            Height="34" Padding="16,0" Background="#172443" Foreground="#FFFFFF" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold" FontSize="12" Margin="0,0,0,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </WrapPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Product &amp; Item Master Record Editor" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- Card 1: Item Classification / Type -->
            <Border Background="White" Padding="20" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ITEM CLASSIFICATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <ComboBox SelectedValue="{Binding ItemType, Mode=TwoWay}" SelectedValuePath="Tag"
                              IsEnabled="{Binding CanChangeType}" IsEditable="True" IsTextSearchEnabled="True">
                        <ComboBoxItem Content="Raw Material Stock" Tag="raw"/>
                        <ComboBoxItem Content="Finished Product" Tag="mfg"/>
                        <ComboBoxItem Content="Readymade Stock" Tag="ready"/>
                        <ComboBoxItem Content="General Supplies" Tag="gen"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Card 2: Details & Inventory -->
            <Border Background="White" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Edit Mode / Same SKU Variant Notice & Reset to New Product Banner -->
                    <Border Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVis}}"
                            Background="{Binding NoticeBg}" BorderBrush="{Binding NoticeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding NoticeBtnText}" Command="{Binding ResetToNewCommand}"
                                    Padding="10,5" Background="White" BorderBrush="{Binding NoticeBorder}" Foreground="{Binding NoticeFg}" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NoticeIcon}" FontSize="12.5" Foreground="{Binding NoticeFg}"/>
                                <TextBlock Text="{Binding NoticePrefix}" FontWeight="Bold" Foreground="{Binding NoticeTitleFg}" FontSize="12"/>
                                <TextBlock Text="{Binding ExistingRecordNotice}" Foreground="{Binding NoticeFg}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- ITEM & READYMADE PRODUCT FORM                 -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding ProductVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="130"/>
                            <ColumnDefinition Width="1*" MinWidth="130"/>
                            <ColumnDefinition Width="2*" MinWidth="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- ROW 0: Category, Unit, Item Name in that order -->
                        <!-- Category (Only for products, same size as Unit) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,16">
                            <TextBlock Text="Category" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}"
                                      Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      IsEditable="True" IsTextSearchEnabled="True"/>
                        </StackPanel>

                        <!-- Unit of Measurement (Manual input, same size as Category) -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,16">
                            <TextBlock Text="Unit of Measurement *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Item Name (Full remaining width with Autocomplete Suggestions) -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="Item Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox x:Name="TxtProductName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="ItemName_PreviewKeyDown" LostFocus="ItemName_LostFocus"/>
                                <Popup x:Name="PopupProductSuggestions" PlacementTarget="{Binding ElementName=TxtProductName}"
                                       Placement="Bottom" IsOpen="{Binding IsProductSuggestionsOpen, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                            MaxHeight="260" MinWidth="340" Width="{Binding ActualWidth, ElementName=TxtProductName}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.12"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredSuggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="10,8" Margin="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <!-- ROW 1: Sizes and Quantity in row (same size) -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sizes -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Sizes" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Sizes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Quantity *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding InwardNoticeText}" Visibility="{Binding IsInwardNoticeVisible, Converter={StaticResource BoolToVis}}"
                                           FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 2: SKU, HSN, Barcode in down next row -->
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SKU -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="SKU" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- HSN -->
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="HSN" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barcode -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Barcode" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 3: Cost price, Selling price, GST Rate in next down row -->
                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cost Price -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Cost Price (₹)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Selling Price -->
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Selling Price (₹)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- GST Rate % -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GST Rate (%)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding GstPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 4: Low Alert, Medium Alert in down row -->
                        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Low Alert -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Low Alert" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LowAlertLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Medium Alert -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Medium Alert" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MediumAlertLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- RAW MATERIAL & GENERAL / PACKAGING FORM        -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding RawOrGenVisibility}">
                        <!-- ROW 0: Item Name (Long size / full width as Item Classification with Autocomplete Suggestions) -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Item Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox x:Name="TxtRawName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="ItemName_PreviewKeyDown" LostFocus="ItemName_LostFocus"/>
                                <Popup x:Name="PopupRawSuggestions" PlacementTarget="{Binding ElementName=TxtRawName}"
                                       Placement="Bottom" IsOpen="{Binding IsRawSuggestionsOpen, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                            MaxHeight="260" MinWidth="340" Width="{Binding ActualWidth, ElementName=TxtRawName}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.12"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredSuggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="10,8" Margin="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <!-- ROW 1: Sizes, Unit of Measurement & Quantity -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sizes -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Sizes" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Sizes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Unit of Measurement -->
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Unit of Measurement *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding InwardNoticeText}" Visibility="{Binding IsInwardNoticeVisible, Converter={StaticResource BoolToVis}}"
                                           FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 2: SKU, HSN, Barcode below Unit & Quantity -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SKU -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="SKU" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- HSN -->
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="HSN" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Barcode -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Barcode" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 3: Cost Price & GST Rate % below SKU -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cost Price -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Cost Price (₹)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- GST Rate % -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GST Rate (%)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding GstPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 4: Low Alert & Medium Alert (without numbers) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Low Alert -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Low Alert" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LowAlertLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Medium Alert -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Medium Alert" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MediumAlertLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom Sticky Action Bar -->
            <Border Background="White" Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.05"/>
                </Border.Effect>
                <DockPanel>
                    <Button Content="Print Barcode Label" Command="{Binding PrintBarcodeCommand}"
                            Visibility="{Binding ProductVisibility}"
                            Padding="16,9" Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1"
                            Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Padding="18,9" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                Cursor="Hand" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0"/>

                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                                Padding="24,9" Background="#172443" Foreground="#FFFFFF" BorderThickness="0"
                                Cursor="Hand" FontWeight="Bold" FontSize="12.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
