<UserControl x:Class="AsiErp.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- 1. Hero Purchase Dashboard Section (Clean Light/Dark Responsive, No Black Box) -->
            <StackPanel Margin="0,0,0,22">
                <!-- Top Bar: Heading + Action Buttons -->
                <DockPanel Margin="0,0,0,14">
                    <!-- Action Buttons on Right -->
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Raw Material Stock" Command="{Binding NavigateCommand}" CommandParameter="pur:raw"
                                Padding="14,7" Background="#EAB308" Foreground="#0F172A" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button Content="+ Readymade Stock" Command="{Binding NavigateCommand}" CommandParameter="pur:ready"
                                Padding="14,7" Background="#6366F1" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button Content="+ General Supplies" Command="{Binding NavigateCommand}" CommandParameter="pur:gen"
                                Padding="14,7" Background="#2DD4BF" Foreground="#042F2E" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </WrapPanel>

                    <!-- Heading and Subtitle on Left -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Purchase" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Raw material stock, readymade stock and general purchases for the month you pick, with the amount still to pay vendors." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Yellow Dotted Line Separator -->
                <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

                <!-- Month Navigation Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <Button Content="&lt; Prev Month" Command="{Binding PreviousMonthCommand}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#1E293B"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>

                    <Button Content="{Binding SelectedMonthDisplay}" Command="{Binding CurrentMonthCommand}" ToolTip="Click to return to Current Month"
                            Background="#EAB308" BorderThickness="0" Foreground="#0F172A"
                            Padding="16,6" Cursor="Hand" FontSize="11" FontWeight="Bold" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Next Month &gt;" Command="{Binding NextMonthCommand}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#1E293B"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- 2 Rows x 4 Columns KPI Cards Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ROW 0, COL 0: Raw Material Purchase (Blue) -->
                    <Border Grid.Row="0" Grid.Column="0" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#2563EB" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 2,7 L 9,3 L 16,7 L 9,11 Z M 2,7 L 2,13 L 9,17 L 9,11 M 16,7 L 16,13 L 9,17"
                                      Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Raw Material Stock Purchase" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0E7FF" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthRawTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#BFDBFE" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 1: Readymade Purchase (Green) -->
                    <Border Grid.Row="0" Grid.Column="1" Tag="PreserveTheme" Background="#15803D" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#15803D" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 4,6 L 14,6 L 15,16 L 3,16 Z M 6,6 A 3,3 0 0,1 12,6"
                                      Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Readymade Stock Purchase" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCFCE7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthReadyTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#BBF7D0" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 2: General Purchase (Teal) -->
                    <Border Grid.Row="0" Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0D9488" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 2,2 L 8,2 L 16,10 L 10,16 L 2,8 Z M 5,5 A 1,1 0 1,1 5,5.01"
                                      Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="General Purchase" FontSize="11.5" FontWeight="SemiBold" Foreground="#CCFBF1" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthGenTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#99F6E4" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 3: Total Purchase (Purple) -->
                    <Border Grid.Row="0" Grid.Column="3" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#7C3AED" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 2,12 L 6,8 L 10,11 L 16,4 M 11,4 L 16,4 L 16,9"
                                      Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Purchase" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDE9FE" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthGrandTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#DDD6FE" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 0: Raw Material Outstanding to Pay (Amber) -->
                    <Border Grid.Row="1" Grid.Column="0" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Raw Material Stock Outstanding to Pay" FontSize="11" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthRawOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to pay" FontSize="10" Foreground="#FDE68A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 1: Readymade Outstanding to Pay (Amber) -->
                    <Border Grid.Row="1" Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Readymade Stock Outstanding to Pay" FontSize="11" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthReadyOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to pay" FontSize="10" Foreground="#FDE68A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 2: General Outstanding to Pay (Amber) -->
                    <Border Grid.Row="1" Grid.Column="2" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="General Outstanding to Pay" FontSize="11" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthGenOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to pay" FontSize="10" Foreground="#FDE68A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 3: Total Outstanding to Pay (Red) -->
                    <Border Grid.Row="1" Grid.Column="3" Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="16,14" Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#DC2626" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Outstanding to Pay" FontSize="11" FontWeight="SemiBold" Foreground="#FEE2E2" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthTotalOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to pay" FontSize="10" Foreground="#FECACA" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 3. Custom Report & Data Table Section -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>

                <DockPanel>
                    <!-- Custom Report Filter Bar (Exact Match to Prototype & Screenshot) -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Box (Left) + Category Chips (Right) -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetKindCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Raw Material Stock" Command="{Binding SetKindCommand}" CommandParameter="raw" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=raw}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=raw}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=raw}"/>

                                    <Button Content="Readymade Stock" Command="{Binding SetKindCommand}" CommandParameter="ready" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=ready}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=ready}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=ready}"/>

                                    <Button Content="General Supplies" Command="{Binding SetKindCommand}" CommandParameter="gen"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=gen}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=gen}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=gen}"/>
                                </StackPanel>

                                <!-- Search Box with Hint & Clean Focus -->
                                <Border Style="{StaticResource SearchContainerBorderStyle}" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Grid.Column="1" Text="Search vendor, invoice no..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtPurSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtPurSearch}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtPurSearch" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CleanSearchTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Row 2: Custom report From/To (Left) + Status Chips & Download file (Right) -->
                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetStatusCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Unpaid" Command="{Binding SetStatusCommand}" CommandParameter="Unpaid" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Unpaid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Unpaid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Unpaid}"/>

                                    <Button Content="Paid" Command="{Binding SetStatusCommand}" CommandParameter="Paid" Margin="0,0,8,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Paid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Paid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Paid}"/>

                                    <!-- Single Download file button asking PDF or CSV -->
                                    <Button Content="Download file" Command="{Binding DownloadFileCommand}"
                                            Height="32" Padding="16,0" Background="#172443" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Custom report From & To -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Custom report" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="From" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportFromDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="To" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportToDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <Button Content="Clear" Command="{Binding ClearCustomDatesCommand}"
                                            Visibility="{Binding HasCustomDates, Converter={StaticResource BoolToVis}}"
                                            Height="28" Padding="10,0" Margin="8,0,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Table Summary Bar: "0 entries · Total ₹0 · Balance ₹0" -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,2,2,10">
                        <TextBlock Text="{Binding FilteredSummaryText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 4. Table Columns in exact requested order: -->
                    <!-- Date | Invoice no | Type | Vendor | Contact | Amount | Paid | Balance | Terms | Status | Actions -->
                    <DataGrid ItemsSource="{Binding FilteredPurchases}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              MaxHeight="680"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 1. Date -->
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="80"/>

                            <!-- 2. Invoice no -->
                            <DataGridTextColumn Header="Invoice no" Binding="{Binding InvoiceNo}" Width="105" FontWeight="Bold"/>

                            <!-- 3. Type -->
                            <DataGridTemplateColumn Header="Type" Width="125" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="#EEF2FF">
                                            <TextBlock Text="{Binding KindLabel}" Foreground="#4338CA" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. Vendor -->
                            <DataGridTemplateColumn Header="Vendor" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. Contact -->
                            <DataGridTextColumn Header="Contact" Binding="{Binding Phone}" Width="105"/>

                            <!-- 6. Amount -->
                            <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="85" FontWeight="Bold"/>

                            <!-- 7. Paid -->
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, Converter={StaticResource InrConv}}" Width="80"/>

                            <!-- 8. Balance -->
                            <DataGridTemplateColumn Header="Balance" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceAmount, Converter={StaticResource InrConv}}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 9. Terms -->
                            <DataGridTextColumn Header="Terms" Binding="{Binding SaleType}" Width="65"/>

                            <!-- 10. Status -->
                            <DataGridTemplateColumn Header="Status" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 11. Actions (View | Pay | Delete) -->
                            <DataGridTemplateColumn Width="185" MinWidth="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="View" Command="{Binding DataContext.ViewPurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Pay" Visibility="{Binding PayVisibility}" Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Delete" Command="{Binding DataContext.DeletePurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
