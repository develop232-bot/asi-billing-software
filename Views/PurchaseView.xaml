<UserControl x:Class="AsiErp.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- 1. Header with Top Action Buttons (Responsive WrapPanel) -->
            <DockPanel Margin="0,0,0,16">
                <!-- Action Buttons on Right (Wraps cleanly if screen is smaller) -->
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🧵 Raw Material" Command="{Binding NavigateCommand}" CommandParameter="pur:raw"
                            Padding="11,6" Background="#172443" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="👞 Ready Made" Command="{Binding NavigateCommand}" CommandParameter="pur:ready"
                            Padding="11,6" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="📦 General" Command="{Binding NavigateCommand}" CommandParameter="pur:gen"
                            Padding="11,6" Background="#0891B2" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="+ New Purchase Bill" Command="{Binding NavigateCommand}" CommandParameter="pur:raw"
                            Padding="13,6" Background="#7C3AED" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </WrapPanel>

                <!-- Title & Subtitle on Left -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,6">
                    <TextBlock Text="Purchase &amp; Sourcing" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Vendor bills register across Raw Material, Ready Made Products &amp; General Packaging." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- 2. Particular Month Purchase Amount Section (Always Reflects) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Month Selector & Header -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 Purchase Breakdown:" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedMonthDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="#7C3AED" Margin="6,0,12,0" VerticalAlignment="Center"/>

                            <!-- Month Step Controls -->
                            <Button Content="◀ Prev" Command="{Binding PreviousMonthCommand}" ToolTip="Previous Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Next ▶" Command="{Binding NextMonthCommand}" ToolTip="Next Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Current Month" Command="{Binding CurrentMonthCommand}" ToolTip="This Calendar Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Live spend breakdown across all 3 sourcing categories" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 4 Summary KPI Cards (Row 1: Purchases) -->
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <!-- Raw Material -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="🧵 Raw Material" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="FACTORY" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthRawTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Ready Made Products -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="👞 Ready Made" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="TRADING" FontSize="9" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthReadyTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#4F46E5" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- General Packaging -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="📦 General Packaging" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="SUPPLIES" FontSize="9" FontWeight="Bold" Foreground="#0891B2" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthGenTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#0891B2" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Month Purchase -->
                        <Border Background="#FAF5FF" Padding="14,12" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="💰 Total Month Sourced" FontSize="11.5" Foreground="#6B21A8" FontWeight="Bold"/>
                                    <TextBlock Text="COMBINED" FontSize="9" FontWeight="Bold" Foreground="#9333EA" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthGrandTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#7E22CE" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 4 Summary KPI Cards (Row 2: Outstanding to Pay) -->
                    <UniformGrid Columns="4">
                        <!-- Raw Material Outstanding -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="🧵 Raw Mat. To Pay" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="VENDORS" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthRawOutstanding, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                                <TextBlock Text="unpaid raw material bills" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Ready Made Outstanding -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="👞 Readymade To Pay" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="VENDORS" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthReadyOutstanding, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                                <TextBlock Text="unpaid readymade bills" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- General Packaging Outstanding -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="📦 General To Pay" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="VENDORS" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthGenOutstanding, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                                <TextBlock Text="unpaid packaging bills" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total to Pay -->
                        <Border Background="#FEF2F2" Padding="14,12" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="⚠️ Total to Pay" FontSize="11.5" Foreground="#991B1B" FontWeight="Bold"/>
                                    <TextBlock Text="PENDING" FontSize="9" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthTotalOutstanding, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                                <TextBlock Text="still to pay vendors" FontSize="10" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 3. Custom Report & Data Table Section -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>

                <DockPanel>
                    <!-- Custom Report Filter Bar (Exact Match to Prototype & Screenshot) -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Box (Left) + Category Chips (Right) -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetKindCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Raw Material" Command="{Binding SetKindCommand}" CommandParameter="raw" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=raw}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=raw}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=raw}"/>

                                    <Button Content="Ready Made" Command="{Binding SetKindCommand}" CommandParameter="ready" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=ready}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=ready}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=ready}"/>

                                    <Button Content="General Packaging" Command="{Binding SetKindCommand}" CommandParameter="gen"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=gen}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=gen}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=gen}"/>
                                </StackPanel>

                                <!-- Search Box with Hint & Clean Focus -->
                                <Border Style="{StaticResource SearchContainerBorderStyle}" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Grid.Column="1" Text="Search vendor, bill no..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtPurSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtPurSearch}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtPurSearch" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CleanSearchTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Row 2: Custom report From/To (Left) + Status Chips & Download file (Right) -->
                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetStatusCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Unpaid" Command="{Binding SetStatusCommand}" CommandParameter="Unpaid" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Unpaid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Unpaid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Unpaid}"/>

                                    <Button Content="Paid" Command="{Binding SetStatusCommand}" CommandParameter="Paid" Margin="0,0,8,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Paid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Paid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Paid}"/>

                                    <!-- Single Download file button asking PDF or CSV -->
                                    <Button Content="Download file" Command="{Binding DownloadFileCommand}"
                                            Height="32" Padding="16,0" Background="#172443" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Custom report From & To -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Custom report" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="From" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportFromDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="To" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportToDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <Button Content="Clear" Command="{Binding ClearCustomDatesCommand}"
                                            Visibility="{Binding HasCustomDates, Converter={StaticResource BoolToVis}}"
                                            Height="28" Padding="10,0" Margin="8,0,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Table Summary Bar: "0 entries · Total ₹0 · Balance ₹0" -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,2,2,10">
                        <TextBlock Text="{Binding FilteredSummaryText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 4. Table Columns in exact requested order: -->
                    <!-- Bill | Type | Vendor | Date | Amount | Paid | Balance | Terms | Status | Actions -->
                    <DataGrid ItemsSource="{Binding FilteredPurchases}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <!-- 1. Bill -->
                            <DataGridTextColumn Header="Bill" Binding="{Binding BillNo}" Width="100" FontWeight="Bold"/>

                            <!-- 2. Type -->
                            <DataGridTemplateColumn Header="Type" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="#EEF2FF">
                                            <TextBlock Text="{Binding KindLabel}" Foreground="#4338CA" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Vendor -->
                            <DataGridTemplateColumn Header="Vendor" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. Date -->
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="80"/>

                            <!-- 5. Amount -->
                            <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="90" FontWeight="Bold"/>

                            <!-- 6. Paid -->
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, Converter={StaticResource InrConv}}" Width="85"/>

                            <!-- 7. Balance -->
                            <DataGridTemplateColumn Header="Balance" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceAmount, Converter={StaticResource InrConv}}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 8. Terms -->
                            <DataGridTextColumn Header="Terms" Binding="{Binding SaleType}" Width="60"/>

                            <!-- 9. Status -->
                            <DataGridTemplateColumn Header="Status" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 10. Actions -->
                            <DataGridTemplateColumn Width="185" MinWidth="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="View" Command="{Binding DataContext.ViewPurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Pay" Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Delete" Command="{Binding DataContext.DeletePurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="8,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
