<UserControl x:Class="AsiErp.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 1. Header with Top 3 Action Buttons -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Purchase &amp; Sourcing" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Vendor bills register across Raw Material, Ready Made Products &amp; General Packaging." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Top 3 Action Buttons requested by user -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🧵 Raw Material" Command="{Binding SetKindCommand}" CommandParameter="raw"
                            Padding="14,8" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>

                    <Button Content="👞 Ready Made Products" Command="{Binding SetKindCommand}" CommandParameter="ready"
                            Padding="14,8" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>

                    <Button Content="📦 General Packaging" Command="{Binding SetKindCommand}" CommandParameter="gen"
                            Padding="14,8" Background="#0891B2" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>

                    <Button Content="+ New Purchase Bill" Command="{Binding NewPurchaseBillCommand}"
                            Padding="16,8" Background="#7C3AED" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 2. Particular Month Purchase Amount Section (Always Reflects) -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Month / Custom Date Range Selector & Header -->
                    <DockPanel Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 Purchase Breakdown:" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedMonthDisplay}" FontWeight="Bold" FontSize="13.5" Foreground="#7C3AED" Margin="6,0,12,0" VerticalAlignment="Center"/>

                            <!-- Month Step Controls -->
                            <Button Content="◀ Prev" Command="{Binding PreviousMonthCommand}" ToolTip="Previous Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Next ▶" Command="{Binding NextMonthCommand}" ToolTip="Next Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Current Month" Command="{Binding CurrentMonthCommand}" ToolTip="This Calendar Month" Padding="8,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,14,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>

                            <!-- Custom Date Pick Option (From - To) -->
                            <Border BorderBrush="#CBD5E1" BorderThickness="1,0,0,0" Margin="0,0,12,0" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="From:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker SelectedDate="{Binding SummaryFromDate, Mode=TwoWay}" Width="125" Height="28" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                            <TextBlock Text="To:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker SelectedDate="{Binding SummaryToDate, Mode=TwoWay}" Width="125" Height="28" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                            <Button Content="Reset" Command="{Binding ResetSummaryDatesCommand}" ToolTip="Reset to Current Month" Padding="9,3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="Live spend breakdown across all 3 sourcing categories" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 4 Summary KPI Cards -->
                    <UniformGrid Columns="4">
                        <!-- Raw Material -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="🧵 Raw Material" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="FACTORY" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthRawTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Ready Made Products -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="👞 Ready Made" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="TRADING" FontSize="9" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthReadyTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#4F46E5" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- General Packaging -->
                        <Border Background="White" Padding="14,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="📦 General Packaging" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="SUPPLIES" FontSize="9" FontWeight="Bold" Foreground="#0891B2" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthGenTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#0891B2" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Month Purchase -->
                        <Border Background="#FAF5FF" Padding="14,12" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="💰 Total Month Sourced" FontSize="11.5" Foreground="#6B21A8" FontWeight="Bold"/>
                                    <TextBlock Text="COMBINED" FontSize="9" FontWeight="Bold" Foreground="#9333EA" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonthGrandTotal, Converter={StaticResource InrConv}}" FontSize="20" FontWeight="Bold" Foreground="#7E22CE" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 3. Custom Report & Data Table Section -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>

                <DockPanel>
                    <!-- Custom Report Filter Bar -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Title & Download buttons -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊 Custom Report:" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="Filter by custom dates &amp; sourcing category, then export" FontSize="11" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Download File Buttons (PDF & EXCEL) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Download file:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}"
                                            Padding="12,5" Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11" Margin="0,0,6,0">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="📊 EXCEL" Command="{Binding ExportExcelCommand}"
                                            Padding="12,5" Background="#16A34A" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Row 2: From, To, Category Chips, Status, Search -->
                            <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- From Date -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="From:" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportFromDate, Mode=TwoWay}" Width="120" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- To Date -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                    <TextBlock Text="To:" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportToDate, Mode=TwoWay}" Width="120" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Category Chips: All, Raw Material, Ready Made Products, General Packaging -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                    <TextBlock Text="Category:" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <Button Content="🌐 All" Command="{Binding SetKindCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="10,4"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="🧵 Raw Material" Command="{Binding SetKindCommand}" CommandParameter="raw" Margin="0,0,4,0" Padding="10,4"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=raw}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=raw}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=raw}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="👞 Ready Made" Command="{Binding SetKindCommand}" CommandParameter="ready" Margin="0,0,4,0" Padding="10,4"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=ready}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=ready}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=ready}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="📦 General Packaging" Command="{Binding SetKindCommand}" CommandParameter="gen" Padding="10,4"
                                            Background="{Binding ActiveKind, Converter={StaticResource TabActiveBgConv}, ConverterParameter=gen}"
                                            Foreground="{Binding ActiveKind, Converter={StaticResource TabActiveFgConv}, ConverterParameter=gen}"
                                            BorderBrush="{Binding ActiveKind, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=gen}"
                                            BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Status Filter -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                    <Button Content="All Status" Command="{Binding SetStatusCommand}" CommandParameter="all" Margin="0,0,3,0" Padding="8,4"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                            BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="Unpaid" Command="{Binding SetStatusCommand}" CommandParameter="Unpaid" Margin="0,0,3,0" Padding="8,4"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Unpaid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Unpaid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Unpaid}"
                                            BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="Paid" Command="{Binding SetStatusCommand}" CommandParameter="Paid" Padding="8,4"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Paid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Paid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Paid}"
                                            BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Search Box -->
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28" Padding="6,4"
                                         VerticalContentAlignment="Center" Margin="0,0,8,6"/>

                                <!-- Reset Dates / Filters -->
                                <Button Content="Reset" Command="{Binding ResetFilterDatesCommand}" Padding="8,4" Background="#F1F5F9"
                                        BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="10.5" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Table Summary Bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock Text="{Binding FilteredPurchases.Count, StringFormat='Showing {0} Purchase Bills'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                    </DockPanel>

                    <!-- 4. Table Columns in EXACT requested order: -->
                    <!-- | DATE | Channel | Invoice | Vendor | Contact no | Amount | Rest in purchase (Vendor Ref, Terms, Payment, Actions) | -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding FilteredPurchases}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40" MinWidth="980">
                            <DataGrid.Columns>
                            <!-- 1. DATE -->
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="100"/>

                            <!-- 2. Channel -->
                            <DataGridTemplateColumn Header="Channel" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="#EEF2FF">
                                            <TextBlock Text="{Binding KindLabel}" Foreground="#4338CA" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Invoice -->
                            <DataGridTextColumn Header="Invoice" Binding="{Binding BillNo}" Width="135" FontWeight="Bold"/>

                            <!-- 4. Vendor -->
                            <DataGridTemplateColumn Header="Vendor" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. Contact no -->
                            <DataGridTextColumn Header="Contact no" Binding="{Binding Phone}" Width="125"/>

                            <!-- 6. Amount -->
                            <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="125" FontWeight="Bold"/>

                            <!-- 7. Vendor Ref -->
                            <DataGridTextColumn Header="Vendor Ref" Binding="{Binding VendorBillRef}" Width="110"/>

                            <!-- 8. Terms -->
                            <DataGridTextColumn Header="Terms" Binding="{Binding SaleType}" Width="85"/>

                            <!-- 9. Payment -->
                            <DataGridTemplateColumn Header="Payment" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 10. Actions -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Command="{Binding DataContext.ViewPurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="12,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11" HorizontalAlignment="Center">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
