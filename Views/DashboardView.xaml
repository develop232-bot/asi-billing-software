<UserControl x:Class="AsiErp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="#F8FAFC" VerticalScrollBarVisibility="Auto" Padding="24" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- TOP BAR: Dashboard Title & Period Selector -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Welcome back, Admin! Here is how the company is doing today." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: Top-sellers period dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Top-sellers period" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="36" Padding="12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="This month" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="▾" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 10 KPI CARDS (2 rows of 5) -->
            <!-- ROW 1: Retail, Domestic, Export, Total Sales, Expenses -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <!-- 1. Retail Sales -->
                <Border Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#2563EB" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="🛒" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Retail Sales" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdRetailSales, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Domestic Sales -->
                <Border Background="#059669" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#059669" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="📄" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Domestic Sales" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdDomesticSales, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Export Sales -->
                <Border Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0D9488" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Export Sales" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdExportSales, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. Total Sales -->
                <Border Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#7C3AED" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="📈" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Total Sales" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdTotalSales, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5. Expenses -->
                <Border Background="#D97706" CornerRadius="12" Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="₹" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Expenses" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdExpenses, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ROW 2: Profit/Loss, Outstanding, Vendor Payments, Pending Loans, Low Stock -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <!-- 6. Profit / Loss -->
                <Border Background="{Binding MtdProfitBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding MtdProfitIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding MtdProfitLabel}" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdProfitDisplayValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 7. Outstanding - To Receive -->
                <Border Background="#EA580C" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#EA580C" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="₹" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Outstanding - To Receive" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding OutstandingToReceive, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 8. Vendor Payments - To Pay -->
                <Border Background="#0891B2" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0891B2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="💼" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Vendor Payments - To Pay" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding VendorToPay, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 9. Pending Loans -->
                <Border Background="#6366F1" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#6366F1" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="🏛️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Pending Loans" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding PendingLoans, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 10. Low Stock Alerts -->
                <Border Background="#DC2626" CornerRadius="12" Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#DC2626" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="⚠️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Low Stock Alerts" FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding LowStockAlertsCount}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3 MAIN CARDS: Sales Overview (Line chart), Top Selling Products (Donut), Quick Actions -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: SALES OVERVIEW (LINE CHART) -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Top Header with legends -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Legends on Right -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Width="10" Height="10" Background="#3B82F6" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Domestic" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#14B8A6" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#F59E0B" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retail" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#A855F7" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Expenses" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Title on Left -->
                            <TextBlock Text="Sales Overview" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Vector Line Chart Canvas inside Viewbox for Sharp Scaling -->
                        <Viewbox Stretch="Uniform" Height="200" VerticalAlignment="Center">
                            <Canvas Width="480" Height="210" ClipToBounds="False">
                                <!-- Horizontal Grid Lines and Y-Axis Ticks -->
                                <ItemsControl ItemsSource="{Binding OverviewYAxisTicks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <!-- Tick text (e.g. 15L, 10L, 5L, 0) -->
                                                <TextBlock Canvas.Left="0" Canvas.Top="{Binding LabelTop}" Width="38"
                                                           TextAlignment="Right" Text="{Binding Text}"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <!-- Dashed Grid Line -->
                                                <Line X1="45" Y1="{Binding Y}" X2="465" Y2="{Binding Y}"
                                                      Stroke="#E2E8F0" StrokeDashArray="3,3" StrokeThickness="1"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- X-Axis Labels (Jun, Jul, Aug, Sep, Oct, Nov) -->
                                <ItemsControl ItemsSource="{Binding OverviewXAxisLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <TextBlock Canvas.Left="{Binding XLabelLeft}" Canvas.Top="{Binding Y}" Width="32"
                                                           TextAlignment="Center" Text="{Binding Text}"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Soft glowing area gradient under domestic trend -->
                                <Polygon Points="{Binding SalesOverviewAreaPoints}" Opacity="0.10">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>

                                <!-- 4 Series Polylines -->
                                <!-- Expenses Line (Purple) -->
                                <Polyline Points="{Binding ExpenseLinePoints}" Stroke="#A855F7" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Retail Line (Amber) -->
                                <Polyline Points="{Binding RetailLinePoints}" Stroke="#F59E0B" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Export Line (Teal) -->
                                <Polyline Points="{Binding ExportLinePoints}" Stroke="#14B8A6" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Domestic Line (Blue) -->
                                <Polyline Points="{Binding DomesticLinePoints}" Stroke="#3B82F6" StrokeThickness="2.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Interactive Data Point Dots -->
                                <ItemsControl ItemsSource="{Binding OverviewDots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <Ellipse Canvas.Left="{Binding DotLeft}" Canvas.Top="{Binding DotTop}"
                                                         Width="8" Height="8"
                                                         Fill="{Binding ColorBrush}" Stroke="White" StrokeThickness="1.5"
                                                         ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- CARD 2: TOP SELLING PRODUCTS (DONUT CHART + LIST) -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="this month" FontSize="11.5" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="Top Selling Products" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Content: Donut Chart on Left, Breakdown List on Right -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Donut Viewbox -->
                            <Viewbox Grid.Column="0" Stretch="Uniform" Width="145" Height="145" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="176" Height="176">
                                    <!-- Donut Slices -->
                                    <ItemsControl ItemsSource="{Binding TopProductsPieSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Donut Center Label -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total sales" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MtdTotalSales, Converter={StaticResource InrShortConv}}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <!-- Product Items Breakdown -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding TopProductsPieSlices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" Background="{Binding FillBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Channel}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentageDisplay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- CARD 3: QUICK ACTIONS (2x3 GRID OF ROUNDED ACTION TILES) -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top" Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- 2 Columns x 3 Rows Action Tiles -->
                        <UniformGrid Columns="2" Rows="3" VerticalAlignment="Center">
                            <!-- 1. New Retail Bill -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#1E293B" BorderThickness="0"
                                    Command="{Binding NavigateCommand}" CommandParameter="sales:retail">
                                <StackPanel>
                                    <TextBlock Text="🛒" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="New Retail Bill" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Domestic Invoice -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#3B82F6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="domestic_invoice">
                                <StackPanel>
                                    <TextBlock Text="📄" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="Domestic Invoice" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Export Invoice -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#14B8A6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="export_invoice">
                                <StackPanel>
                                    <TextBlock Text="🌐" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="Export Invoice" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. New Work Order -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#F59E0B"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="work_order">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="New Work Order" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Add Product -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#8B5CF6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="product_edit_mfg">
                                <StackPanel>
                                    <TextBlock Text="🏷️" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="Add Product" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Payment Entry -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#EF4444"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="payment_quick">
                                <StackPanel>
                                    <TextBlock Text="₹" FontSize="18" FontWeight="Bold" Foreground="White"/>
