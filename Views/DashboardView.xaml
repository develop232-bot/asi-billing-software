<UserControl x:Class="AsiErp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="#F8FAFC" VerticalScrollBarVisibility="Auto" Padding="18,16" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- TOP BAR: Dashboard Title & Period Selector -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Welcome back, Admin! Here is how the company is doing today." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: Period dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Period" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding TopSellersPeriods}"
                              SelectedValue="{Binding TopSellersPeriod, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              DisplayMemberPath="Display"
                              Height="36" Width="170"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              FontSize="12"
                              FontWeight="SemiBold"
                              VerticalContentAlignment="Center"
                              Padding="10,0"/>
                </StackPanel>
            </Grid>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- 10 KPI CARDS (2 rows x 5 columns Grid) -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 0, COL 0: Retail Sales (Blue) -->
                <Border Grid.Row="0" Grid.Column="0" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,10,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#2563EB" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 2,3 L 5,3 L 7,12 L 17,12 L 19,6 L 6,6 M 7.5,15 A 1.5,1.5 0 1,1 7.5,15.01 M 15.5,15 A 1.5,1.5 0 1,1 15.5,15.01"
                                  Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Retail Sales" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0E7FF" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdRetailSales, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 0, COL 1: Domestic Sales (Green) -->
                <Border Grid.Row="0" Grid.Column="1" Tag="PreserveTheme" Background="#15803D" CornerRadius="12" Padding="16,14" Margin="0,0,10,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#15803D" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 3,2 L 10,2 L 14,6 L 14,16 L 3,16 Z M 10,2 L 10,6 L 14,6 M 5,9 L 11,9 M 5,12 L 11,12"
                                  Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Domestic Sales" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCFCE7" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdDomesticSales, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 0, COL 2: Export Sales (Teal) -->
                <Border Grid.Row="0" Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,10,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0D9488" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 11,2 L 13,2 L 13,9 L 20,13 L 20,15 L 13,13 L 13,18 L 15,20 L 15,21.5 L 12,20.5 L 9,21.5 L 9,20 L 11,18 L 11,13 L 4,15 L 4,13 L 11,9 Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Export Sales" FontSize="11.5" FontWeight="SemiBold" Foreground="#CCFBF1" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdExportSales, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 0, COL 3: Total Sales (Purple) -->
                <Border Grid.Row="0" Grid.Column="3" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,10,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#7C3AED" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 2,12 L 6,8 L 10,11 L 16,4 M 11,4 L 16,4 L 16,9"
                                  Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Sales" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDE9FE" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdTotalSales, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 0, COL 4: Expenses (Amber) -->
                <Border Grid.Row="0" Grid.Column="4" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Expenses" FontSize="11.5" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdExpenses, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1, COL 0: Profit / Loss (Green #15803D / Red #DC2626) -->
                <Border Grid.Row="1" Grid.Column="0" Tag="PreserveTheme" Background="{Binding MtdProfitBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Visibility="{Binding MtdProfitIsPositive, Converter={StaticResource BoolToVis}}"
                                      Data="M 2,12 L 6,8 L 10,11 L 16,4 M 11,4 L 16,4 L 16,9"
                                      Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Visibility="{Binding MtdProfitIsPositive, Converter={StaticResource InverseBoolToVis}}"
                                      Data="M 5,2 L 13,2 L 17,6 L 17,12 L 13,16 L 5,16 L 1,12 L 1,6 Z M 9,5 L 9,9.5 M 9,12.5 L 9,13"
                                      Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding MtdProfitLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCFCE7" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding MtdProfitDisplayValue, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1, COL 1: Outstanding · To Receive (Amber) -->
                <Border Grid.Row="1" Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#D97706" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Outstanding · To Receive" FontSize="11.5" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding OutstandingToReceive, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1, COL 2: Vendor Payments · To Pay (Teal) -->
                <Border Grid.Row="1" Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0D9488" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 4,6 L 14,6 L 15,16 L 3,16 Z M 6,6 A 3,3 0 0,1 12,6"
                                  Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Vendor Payments · To Pay" FontSize="11.5" FontWeight="SemiBold" Foreground="#CCFBF1" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding VendorToPay, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1, COL 3: Pending Loans (Purple) -->
                <Border Grid.Row="1" Grid.Column="3" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#7C3AED" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 2,5 C 2,3.9 2.9,3 4,3 L 15,3 C 16.1,3 17,3.9 17,5 L 17,13 C 17,14.1 16.1,15 15,15 L 4,15 C 2.9,15 2,14.1 2,13 Z M 13,8 L 17,8 L 17,11 L 13,11 C 12.2,11 11.5,10.3 11.5,9.5 C 11.5,8.7 12.2,8 13,8 Z M 14,9.5 A 0.5,0.5 0 1,1 14,9.51"
                                  Stroke="#FFFFFF" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Pending Loans" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDE9FE" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding PendingLoans, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ROW 1, COL 4: Low Stock Alerts (Red) -->
                <Border Grid.Row="1" Grid.Column="4" Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="16,14" Margin="0,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#DC2626" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                            <Path Data="M 5,2 L 13,2 L 17,6 L 17,12 L 13,16 L 5,16 L 1,12 L 1,6 Z M 9,5 L 9,9.5 M 9,12.5 L 9,13"
                                  Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Low Stock Alerts" FontSize="11.5" FontWeight="SemiBold" Foreground="#FEE2E2" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding LowStockAlertsCount}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3 MAIN CARDS: Sales Overview (Line chart), Top Selling Products (Donut), Quick Actions -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: SALES OVERVIEW (LINE CHART) -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Top Header with legends -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Legends on Right -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Width="10" Height="10" Background="#3B82F6" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Domestic" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#14B8A6" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#F59E0B" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retail" FontSize="11.5" Foreground="#64748B" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="10" Height="10" Background="#A855F7" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Expenses" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Title on Left -->
                            <TextBlock Text="Sales Overview" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Vector Line Chart Canvas inside Viewbox for Sharp Scaling -->
                        <Viewbox Stretch="Uniform" Height="200" VerticalAlignment="Center">
                            <Canvas Width="480" Height="210" ClipToBounds="False">
                                <!-- Horizontal Grid Lines and Y-Axis Ticks -->
                                <ItemsControl ItemsSource="{Binding OverviewYAxisTicks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <!-- Tick text (e.g. 15L, 10L, 5L, 0) -->
                                                <TextBlock Canvas.Left="0" Canvas.Top="{Binding LabelTop}" Width="38"
                                                           TextAlignment="Right" Text="{Binding Text}"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <!-- Dashed Grid Line -->
                                                <Line X1="45" Y1="{Binding Y}" X2="465" Y2="{Binding Y}"
                                                      Stroke="#E2E8F0" StrokeDashArray="3,3" StrokeThickness="1"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- X-Axis Labels (Jun, Jul, Aug, Sep, Oct, Nov) -->
                                <ItemsControl ItemsSource="{Binding OverviewXAxisLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <TextBlock Canvas.Left="{Binding XLabelLeft}" Canvas.Top="{Binding Y}" Width="32"
                                                           TextAlignment="Center" Text="{Binding Text}"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Soft glowing area gradient under domestic trend -->
                                <Polygon Points="{Binding SalesOverviewAreaPoints}" Opacity="0.10">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>

                                <!-- 4 Series Polylines -->
                                <!-- Expenses Line (Purple) -->
                                <Polyline Points="{Binding ExpenseLinePoints}" Stroke="#A855F7" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Retail Line (Amber) -->
                                <Polyline Points="{Binding RetailLinePoints}" Stroke="#F59E0B" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Export Line (Teal) -->
                                <Polyline Points="{Binding ExportLinePoints}" Stroke="#14B8A6" StrokeThickness="2.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Domestic Line (Blue) -->
                                <Polyline Points="{Binding DomesticLinePoints}" Stroke="#3B82F6" StrokeThickness="2.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Interactive Data Point Dots -->
                                <ItemsControl ItemsSource="{Binding OverviewDots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="480" Height="210"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="480" Height="210">
                                                <Ellipse Canvas.Left="{Binding DotLeft}" Canvas.Top="{Binding DotTop}"
                                                         Width="8" Height="8"
                                                         Fill="{Binding ColorBrush}" Stroke="White" StrokeThickness="1.5"
                                                         ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- CARD 2: TOP SELLING PRODUCTS (DONUT CHART + LIST) -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="{Binding TopSellersPeriodLabel}" FontSize="11.5" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="Top Selling Products" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Content: Donut Chart on Left, Breakdown List on Right -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Donut Viewbox -->
                            <Viewbox Grid.Column="0" Stretch="Uniform" Width="145" Height="145" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="176" Height="176">
                                    <!-- Donut Slices -->
                                    <ItemsControl ItemsSource="{Binding TopProductsPieSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Donut Center Label -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total sales" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TopSellersTotalSales, Converter={StaticResource InrShortConv}}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <!-- Product Items Breakdown -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding TopProductsPieSlices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" Background="{Binding FillBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Channel}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentageDisplay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- CARD 3: QUICK ACTIONS (2x3 GRID OF ROUNDED ACTION TILES) -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top" Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- 2 Columns x 3 Rows Action Tiles -->
                        <UniformGrid Columns="2" Rows="3" VerticalAlignment="Center">
                            <!-- 1. New Retail Bill -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#1E293B" BorderThickness="0"
                                    Command="{Binding NavigateCommand}" CommandParameter="sales:retail">
                                <StackPanel>
                                    <Path Data="M 3,4 L 6,4 L 7.5,12 L 15,12 L 16.5,6 L 6.5,6 M 7.5,14 A 1.2,1.2 0 1,0 7.5,16.4 A 1.2,1.2 0 1,0 7.5,14 M 14.5,14 A 1.2,1.2 0 1,0 14.5,16.4 A 1.2,1.2 0 1,0 14.5,14" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="New Retail Bill" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Domestic Invoice -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#3B82F6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="domestic_invoice">
                                <StackPanel>
                                    <Path Data="M 3,2 L 11,2 L 15,6 L 15,18 L 3,18 Z M 11,2 L 11,6 L 15,6 M 5,9 L 13,9 M 5,12 L 13,12 M 5,15 L 10,15" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Domestic Invoice" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Export Invoice -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#14B8A6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="export_invoice">
                                <StackPanel>
                                    <Path Data="M 2,11 L 8,11 L 11,3 L 13,3 L 11,11 L 17,11 L 18,8 L 19.5,8 L 19,12 L 19.5,16 L 18,16 L 17,13 L 11,13 L 13,21 L 11,21 L 8,13 L 2,13 Z" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Export Invoice" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. New Work Order -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#F59E0B"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="work_order">
                                <StackPanel>
                                    <Path Data="M 6,3 L 14,3 L 14,5 L 16,5 L 16,19 L 4,19 L 4,5 L 6,5 Z M 8,1 L 12,1 L 12,4 L 8,4 Z" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="14" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="New Work Order" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Add Product -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#8B5CF6"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="product_edit_mfg">
                                <StackPanel>
                                    <Path Data="M 2,10 L 10,2 L 18,2 L 18,10 L 10,18 Z M 14,6 A 1.5,1.5 0 1,0 14,9 A 1.5,1.5 0 1,0 14,6" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add Product" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Payment Entry -->
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Background="#EF4444"
                                    Command="{Binding OpenDialogCommand}" CommandParameter="payment_quick">
                                <StackPanel>
                                    <TextBlock Text="₹" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Payment Entry" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
