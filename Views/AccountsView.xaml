<UserControl x:Class="AsiErp.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:RouteToActiveIndicatorConverter x:Key="RouteToActiveIndicatorConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveTabTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Overall summary of income, expenses, profit, loans, assets and your balance sheet." FontSize="12.5" Foreground="{DynamicResource AppTextSecondary}" Margin="0,3,0,0"
                               Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=dashboard}"/>
                </StackPanel>

                <!-- Period Dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Period: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppTextSecondary}"/>
                    <ComboBox ItemsSource="{Binding AccountsPeriods}"
                              SelectedValue="{Binding SelectedPeriod, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              DisplayMemberPath="Display"
                              Width="180" Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- TAB 0: FINANCE & ACCOUNTS DASHBOARD -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=dashboard}">

                <!-- 1. INCOME -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Income" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="income"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Retail Sales (Blue) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,4 L 6,4 L 7.5,12 L 15,12 L 16.5,6 L 6.5,6 M 7.5,14 A 1.2,1.2 0 1,0 7.5,16.4 A 1.2,1.2 0 1,0 7.5,14 M 14.5,14 A 1.2,1.2 0 1,0 14.5,16.4 A 1.2,1.2 0 1,0 14.5,14" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Retail Sales" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Domestic Sales (Green) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#16A34A" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,2 L 11,2 L 15,6 L 15,18 L 3,18 Z M 11,2 L 11,6 L 15,6 M 5,9 L 13,9 M 5,12 L 13,12 M 5,15 L 10,15" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Domestic Sales" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Export Sales (Teal) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 9,1 A 8,8 0 1,0 9,17 A 8,8 0 1,0 9,1 M 1,9 L 17,9 M 9,1 C 6,4 6,14 9,17 M 9,1 C 12,4 12,14 9,17" Stroke="White" StrokeThickness="1.3" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Export Sales" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Total Income (Purple) -->
                        <Border Grid.Column="3" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,13 L 6,8 L 10,11 L 16,3 M 11,3 L 16,3 L 16,8" Stroke="White" StrokeThickness="1.6" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Income" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PlTotalIncome, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 2. EXPENSES -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Expenses" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="exp"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Employee (Amber) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Employee" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EmployeeExpenseTotal, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Utility (Purple) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Utility" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UtilityExpenseTotal, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Misc Exp (Blue) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Misc Exp" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MiscExpenseTotal, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Purchase Bills (Teal Green) -->
                        <Border Grid.Column="3" Tag="PreserveTheme" Background="#059669" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,5 L 15,5 M 6,5 L 6,2 L 12,2 L 12,5 M 4,5 L 5,17 L 13,17 L 14,5" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Purchase Bills" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PurchaseExpenseTotal, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 3. PROFIT & LOSS -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Profit &amp; Loss" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="pl"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Total Income (Purple) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,13 L 6,8 L 10,11 L 16,3 M 11,3 L 16,3 L 16,8" Stroke="White" StrokeThickness="1.6" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Income" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PlTotalIncome, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Total Expenses (Amber) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Expenses" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PlTotalExpense, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Profit (Green) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#16A34A" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,13 L 6,8 L 10,11 L 16,3 M 11,3 L 16,3 L 16,8" Stroke="White" StrokeThickness="1.6" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding PlCardLabel}" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PlValueDisplay}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Loan Interest & Depreciation (Blue) -->
                        <Border Grid.Column="3" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,2 L 11,2 L 15,6 L 15,18 L 3,18 Z M 11,2 L 11,6 L 15,6 M 5,9 L 13,9 M 5,12 L 13,12 M 5,15 L 10,15" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Loan Interest &amp; Depreciation" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PlLoanInterestAndDepreciation, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 4. LOANS -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Loans" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="loans"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Loans Taken (Purple) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,2 L 13,2 L 15,4 L 15,18 L 3,18 Z M 6,6 L 12,6 M 6,10 L 12,10 M 6,14 L 10,14" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Loans Taken" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalLoansTaken, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Interest Paid (Amber) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Interest Paid" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalLoanInterestPaid, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Principal Paid (Teal) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Principal Paid" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalLoanPrincipalPaid, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Outstanding to Pay (Red) -->
                        <Border Grid.Column="3" Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,2 L 13,2 L 15,4 L 15,18 L 3,18 Z M 6,6 L 12,6 M 6,10 L 12,10 M 6,14 L 10,14" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Outstanding to Pay" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalLoansOutstanding, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 5. ASSETS -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Assets" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="assets"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Bought For (Blue) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 9,1 L 17,5 L 9,9 L 1,5 Z M 1,5 L 1,13 L 9,17 L 9,9 M 17,5 L 17,13 L 9,17" Stroke="White" StrokeThickness="1.3" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Bought For" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalAssetsCost, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Value Lost So Far (Amber) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,13 L 6,8 L 10,11 L 16,3 M 11,3 L 16,3 L 16,8" Stroke="White" StrokeThickness="1.6" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Value Lost So Far" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalAssetsDepreciation, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Worth Today (Green) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#16A34A" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 9,1 L 17,5 L 9,9 L 1,5 Z M 1,5 L 1,13 L 9,17 L 9,9 M 17,5 L 17,13 L 9,17" Stroke="White" StrokeThickness="1.3" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Worth Today" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalAssetsBookValue, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 6. BALANCE SHEET -->
                <StackPanel Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Balance Sheet" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="bs"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Total Owned (Purple) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,3 L 7,3 L 9,5 L 16,5 L 16,15 L 2,15 Z" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Owned" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BsAssetsTotal, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Cash & Bank (Green) -->
                        <Border Grid.Column="1" Tag="PreserveTheme" Background="#16A34A" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="₹" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Cash &amp; Bank" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BsCash, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Customers Owe You (Teal) -->
                        <Border Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,2 L 11,2 L 15,6 L 15,18 L 3,18 Z M 11,2 L 11,6 L 15,6 M 5,9 L 13,9 M 5,12 L 13,12 M 5,15 L 10,15" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Customers Owe You" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BsRecv, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Vendors to Pay (Red) -->
                        <Border Grid.Column="3" Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 3,5 L 15,5 M 6,5 L 6,2 L 12,2 L 12,5 M 4,5 L 5,17 L 13,17 L 14,5" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Vendors to Pay" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BsPay, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 7. INVESTMENT -->
                <StackPanel Margin="0,0,0,24">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Investment" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="View details" Command="{Binding SetTabCommand}" CommandParameter="inv"
                                DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" Background="#172443" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="11" Cursor="Hand" Tag="PreserveTheme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Capital Invested (Teal) -->
                        <Border Grid.Column="0" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Data="M 2,4 L 16,4 L 16,14 L 2,14 Z M 12,8 L 16,8 L 16,11 L 12,11 Z" Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Capital Invested" Foreground="White" Opacity="0.9" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DashCapital, Converter={StaticResource InrShortConv}}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- TAB 1: INCOME -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=income}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- 1. Retail Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Retail Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Domestic Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Domestic Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Export Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Export Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Total Income -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Income" FontSize="11.5" Foreground="#166534" FontWeight="Bold"/>
                            <TextBlock Text="{Binding IncomeTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Income Register (Net Revenue without GST)" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <!-- Channel Filter Row Options with Dynamic Active Colors -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All Channels" Command="{Binding SetIncomeChannelCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Retail" Command="{Binding SetIncomeChannelCommand}" CommandParameter="retail" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=retail}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=retail}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=retail}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Domestic" Command="{Binding SetIncomeChannelCommand}" CommandParameter="domestic" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Export" Command="{Binding SetIncomeChannelCommand}" CommandParameter="export" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding IncomeRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                    <DataGridTemplateColumn Header="Document" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding InvoiceNo}" ToolTip="{Binding InvoiceNo}" Command="{Binding DataContext.ViewDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Padding="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelLabel}" Width="95"/>
                                    <DataGridTemplateColumn Header="Customer" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding NetAmount, Converter={StaticResource InrConv}}" Width="135" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="GST (₹)" Binding="{Binding TaxAmount, Converter={StaticResource InrConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Total Billed (₹)" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 2: EXPENSES -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=exp}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- Subtitle -->
                <TextBlock Text="Employee, utility and miscellaneous costs. Purchase bills are added automatically." FontSize="12.5" Foreground="#64748B" Margin="0,0,0,16"/>

                <!-- 5 KPI Cards: Employee, Utility, Misc Exp, Purchase bills, Total Expenses -->
                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <!-- Employee -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Employee" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EmployeeExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Utility -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Utility" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UtilityExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Misc Exp -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Misc Exp" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MiscExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Purchase bills -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Purchase bills" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PurchaseExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Expenses -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Expenses" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalExpenseOverall, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Expense Table with Search & Chips -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Controls Row: Search on Left, Filter Chips & Add Expense on Right -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Search... Box -->
                            <Border DockPanel.Dock="Left" Style="{StaticResource SearchContainerBorderStyle}" Width="240" VerticalAlignment="Center">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="Search expenses..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtExpSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtExpSearch}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtExpSearch" Grid.Column="1" Text="{Binding ExpenseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CleanSearchTextBoxStyle}"/>
                                </Grid>
                            </Border>

                            <!-- Chips: All, Employee, Utility, Misc Exp, Purchase bills + Add Expense -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="All" Command="{Binding SetExpenseFreqCommand}" CommandParameter="all" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Employee" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Employee" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Employee}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Employee}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Employee}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Utility" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Utility" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Utility}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Utility}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Utility}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Misc Exp" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Misc Exp" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Misc Exp}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Misc Exp}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Misc Exp}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Purchase bills" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Purchase" Margin="0,0,12,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Purchase}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Purchase}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Purchase}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="+ Add Expense" Command="{Binding AddExpenseCommand}" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid with Columns: Date, Category, Type, Details, Amount, Delete -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="44">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>

                                    <DataGridTemplateColumn Header="Category" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding GroupPillBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupDisplay}" Foreground="{Binding GroupPillBrush}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Type" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                                                    <TextBlock Text="{Binding EmployeeSubtitle}" Foreground="#64748B" FontSize="10.5"
                                                               Visibility="{Binding HasEmployeeInfo, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Details" Binding="{Binding DisplayDetails}" Width="*" Foreground="#475569"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold" Foreground="#0F172A"/>

                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVis}}"
                                                        Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 3: INVESTMENT -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=inv}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Capital Invested" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalInvested, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Recovered from Net Profit" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecoveryPercent, StringFormat='{}{0:F0}%'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="8" Background="#F1F5F9" CornerRadius="4" Margin="0,8">
                                <Border HorizontalAlignment="Left" Width="{Binding RecoveryPercent}" Background="#10B981" CornerRadius="4"/>
                            </Border>
                            <TextBlock Text="{Binding AllTimeProfit, StringFormat='Cumulative net profit: ₹{0:N0}'}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Investment Ledger" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Add Investment" Command="{Binding AddInvestmentCommand}" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding InvestmentRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                    <DataGridTextColumn Header="Invested By" Binding="{Binding InvestedBy}" Width="180" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Purpose / Allocation" Binding="{Binding Purpose}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold"/>

                                    <DataGridTemplateColumn Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteInvestmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 4: PROFIT & LOSS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=pl}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- P&L Running Statement -->
                <Border Background="White" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding PlPeriodLabel, StringFormat='Profit &amp; Loss Statement · {0}'}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expenses Side -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="Expenses (Trading &amp; Factory)" FontWeight="Bold" FontSize="14" Foreground="#DC2626" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding PlExpenseCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="12"/>
                                                    <TextBlock Text="{Binding Amount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Profit Balancer Line if in profit -->
                                    <Border Visibility="{Binding PlIsProfit, Converter={StaticResource BoolToVis}}" Background="#FEF3C7" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Net Profit" FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="{Binding PlNetProfit, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#92400E"/>
                                        </DockPanel>
                                    </Border>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Income Side -->
                            <Border Grid.Column="1" Padding="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Income (Sales)" FontWeight="Bold" FontSize="14" Foreground="#10B981" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Retail &amp; Exhibitions" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Domestic B2B Sales" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Export Overseas Sales" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,20,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Month-by-Month Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Monthly Financial Breakdown" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding PlMonthBreakdowns}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Income (₹)" Binding="{Binding Income, Converter={StaticResource InrConv}}" Width="140" Foreground="#10B981"/>
                                    <DataGridTextColumn Header="Expenses (₹)" Binding="{Binding Expenses, Converter={StaticResource InrConv}}" Width="140" Foreground="#DC2626"/>
                                    <DataGridTextColumn Header="Net Profit / Loss (₹)" Binding="{Binding ProfitLoss, Converter={StaticResource InrConv}}" Width="170" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Margin %" Binding="{Binding MarginText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 5: LOANS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=loans}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Loans" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Money borrowed from banks or people. A loan adds to your cash but is not income. Repayments reduce the loan, and the interest becomes an expense in Profit &amp; Loss." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 4 KPI Tiles: Loan, Principal, Interest, Outstanding -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Loans Taken" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansTaken, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Principal Paid" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanPrincipalPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Interest Paid" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanInterestPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Outstanding to Pay" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansOutstanding, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- INLINE ADD LOAN ROW (All inputs in one row below the 4 boxes) -->
                <Border Background="White" Padding="16,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lender -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lender (Bank or Person) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanLender, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Date Received -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date Received *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding NewLoanDate}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Loan Amount -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Loan Amount (₹) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanAmount, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Interest % / yr -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Interest % / yr *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanInterestRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Note / Purpose -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Note (What was it for?)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanNote, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- + Add Loan Button -->
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <Button Content="+ Add Loan" Command="{Binding SaveInlineLoanCommand}" Height="36" Padding="18,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loans Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Loan Register &amp; Active Borrowings" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding LoanRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" MinRowHeight="46" RowDetailsVisibilityMode="Visible">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8,16,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LastPaymentInfoText}" FontSize="11.5" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <Grid Height="7" Margin="0,2">
                                                    <ProgressBar Value="{Binding RepaidPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="7" BorderThickness="0" Background="Transparent">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid x:Name="Root">
                                                                    <Border x:Name="PART_Track" Background="#E2E8F0" CornerRadius="3.5"/>
                                                                    <Border x:Name="PART_Indicator" Background="#10B981" CornerRadius="3.5" HorizontalAlignment="Left"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </Grid>
                                                <TextBlock Text="{Binding RepaidSummaryText}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Lender" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Lender}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Note}" Foreground="#64748B" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Taken On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Loan Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Interest" Binding="{Binding InterestRate, StringFormat={}{0}% a year}" Width="110"/>

                                    <DataGridTemplateColumn Header="Repaid" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalPrincipalPaid, Converter={StaticResource InrConv}}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Repayments.Count, StringFormat={}{0} payments}" FontSize="10.5" Foreground="#64748B"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceRemaining, Converter={StaticResource InrConv}}" Width="130" FontWeight="Bold" Foreground="#0F172A"/>

                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Actions" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" Command="{Binding DataContext.EditLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Padding="10,4" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                    <Button Content="Repay" Command="{Binding DataContext.RepayLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                            Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                    <Button Content="Delete" Command="{Binding DataContext.DeleteLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 6: ASSETS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=assets}">
                <DockPanel Margin="0,0,0,14">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Assets" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Things the company owns for a long time, such as machines, vehicles and furniture. They lose value every year (depreciation), which is counted as an expense in Profit &amp; Loss." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 4 KPI Tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Assets" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AssetsCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Bought For" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsCost, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Value Lost So Far" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsDepreciation, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Worth Today" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsBookValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- INLINE ADD ASSET ROW (All inputs in one row below the 4 boxes) -->
                <Border Background="White" Padding="16,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Asset Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Asset Name *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Kind -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kind *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AssetKinds}" SelectedItem="{Binding NewAssetKind}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Bought On -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Bought On *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding NewAssetDate}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Cost (₹) -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Cost (₹) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetCost, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Depreciation % / yr -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Loses Value % / yr *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- + Add Asset Button -->
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <Button Content="+ Add Asset" Command="{Binding SaveInlineAssetCommand}" Height="36" Padding="18,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Assets Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fixed Assets Register" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding AssetRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Header="Kind" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" Foreground="#2563EB" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Bought On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Cost (₹)" Binding="{Binding Cost, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Loses Value" Binding="{Binding DepreciationRate, StringFormat={}{0}% a year}" Width="110"/>
                                    <DataGridTextColumn Header="Worth Today (₹)" Binding="{Binding BookValue, Converter={StaticResource InrConv}}" Width="130" FontWeight="Bold" Foreground="#0F172A"/>

                                    <DataGridTemplateColumn Header="Actions" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 7: BALANCE SHEET -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=bs}">
                <DockPanel Margin="0,0,0,16">
                    <Button Content="← Back to Overview" Command="{Binding SetTabCommand}" CommandParameter="dashboard"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Tag="PreserveTheme">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Balance Sheet" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="What the company owns, what it owes, and what the owners have in it. Worked out from the bills, purchases, expenses, loans and assets you have already entered." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Balance Sheet Statement Panel -->
                <Border Background="{DynamicResource AppCardBackground}" Padding="24" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with Match indicator -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Balance Sheet" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text=" · " FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Text="{Binding BsTodayDate}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AppTextSecondary}"/>
                            </StackPanel>
                            <!-- Pill: Both sides match vs difference -->
                            <Border Background="#D1FAE5" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource BoolToVis}}" Tag="PreserveTheme">
                                <TextBlock Text="✓ Both sides match" Foreground="#065F46" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource InverseBoolToVis}}" Tag="PreserveTheme">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Difference: " Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding BsDifference, Converter={StaticResource InrConv}}" Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Two-Column Statement -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Assets -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <Border Background="{DynamicResource AppSubtleBg}" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Assets (what it owns)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                                </Border>

                                <!-- Machines, vehicles & other assets -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Machines, vehicles &amp; other assets" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsFixedAssets, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Stock in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Customers owe you -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Customers owe you" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsRecv, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Cash & bank -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Cash &amp; bank" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCash, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Assets -->
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="0,96,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Assets" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{Binding BsAssetsTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Stretch" Width="1"/>

                            <!-- RIGHT COLUMN: Liabilities & Capital -->
                            <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                <Border Background="{DynamicResource AppSubtleBg}" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Liabilities &amp; Capital (what it owes + owners' share)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                                </Border>

                                <!-- Capital -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Capital — money the owners put in" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCap, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Profit so far -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Profit so far" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsProfit, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Stock still in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock still in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Loans to repay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Loans to repay" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsLoans, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- Vendors to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Vendors to pay" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsPay, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="{DynamicResource AppBorderBrush}"/>

                                <!-- GST to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="GST to pay government" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsGst, Converter={StaticResource InrConv}}" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Liabilities & Capital -->
                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Liabilities &amp; Capital" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{Binding BsLiabilitiesTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footnote note -->
                        <Border Background="{DynamicResource AppSubtleBg}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,24,0,0">
                            <TextBlock Text="💡 Cash &amp; bank is calculated from the payments recorded in this software. If you had cash or bank money before you started using it, add it under Investment so it is counted." FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>