<UserControl x:Class="AsiErp.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:RouteToActiveIndicatorConverter x:Key="RouteToActiveIndicatorConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                            Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=dashboard}">
                    <TextBlock Text="Finance and Accounts" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Income, expenses, profit and the money tied up in loans, investment and assets." FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Period Dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Period: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppTextSecondary}"/>
                    <ComboBox SelectedValue="{Binding SelectedPeriod, Mode=TwoWay}" SelectedValuePath="Tag" Width="180" Height="36" Padding="10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="This month" Tag="m0"/>
                        <ComboBoxItem Content="Last month" Tag="m1"/>
                        <ComboBoxItem Content="Last 3 months" Tag="q"/>
                        <ComboBoxItem Content="Calendar Year (Jan - Dec)" Tag="fy"/>
                        <ComboBoxItem Content="All time" Tag="all"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- TAB 0: FINANCE & ACCOUNTS DASHBOARD -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=dashboard}">
                <!-- 6 Colorful KPI Cards (3x2 Grid) -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <!-- (1) Total Income (Purple #8B5CF6) -->
                    <Border Tag="PreserveTheme" Background="#8B5CF6" CornerRadius="12" Padding="18,16" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Path Data="M 6,18 L 12,12 L 16,16 L 22,8 M 17,8 L 22,8 L 22,13" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Income" FontSize="11.5" FontWeight="SemiBold" Foreground="#DDD6FE"/>
                            <TextBlock Text="{Binding PlTotalIncome, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (2) Total Expenses (Amber #D97706) -->
                    <Border Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="18,16" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="₹" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Expenses" FontSize="11.5" FontWeight="SemiBold" Foreground="#FEF3C7"/>
                            <TextBlock Text="{Binding PlTotalExpense, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (3) Profit & Loss (Green #10B981 / Red #DC2626) -->
                    <Border Tag="PreserveTheme" Background="{Binding PlProfitLossColor}" CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Path Data="M 6,18 L 12,12 L 16,16 L 22,8 M 17,8 L 22,8 L 22,13" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Profit &amp; Loss" FontSize="11.5" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                            <TextBlock Text="{Binding PlNetProfit, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (4) Loan Outstanding (Red #DC2626) -->
                    <Border Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Path Data="M 4,7 C 4,5.9 4.9,5 6,5 L 18,5 C 19.1,5 20,5.9 20,7 L 20,17 C 20,18.1 19.1,19 18,19 L 6,19 C 4.9,19 4,18.1 4,17 Z M 4,9 L 20,9 M 15,14 L 17,14" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Loan Outstanding" FontSize="11.5" FontWeight="SemiBold" Foreground="#FEE2E2"/>
                            <TextBlock Text="{Binding TotalLoansOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (5) Investment (Teal #0D9488) -->
                    <Border Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="18,16" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Path Data="M 4,6 C 4,4.9 4.9,4 6,4 L 10,4 L 12,6 L 18,6 C 19.1,6 20,6.9 20,8 L 20,18 C 20,19.1 19.1,20 18,20 L 6,20 C 4.9,20 4,19.1 4,18 Z" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Investment" FontSize="11.5" FontWeight="SemiBold" Foreground="#CCFBF1"/>
                            <TextBlock Text="{Binding TotalInvested, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (6) Asset Value (Blue #2563EB) -->
                    <Border Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="18,16" Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Path Data="M 12,3 L 20,7.5 L 20,16.5 L 12,21 L 4,16.5 L 4,7.5 Z M 12,3 L 12,21 M 20,7.5 L 12,12 L 4,7.5" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Asset Value" FontSize="11.5" FontWeight="SemiBold" Foreground="#DBEAFE"/>
                            <TextBlock Text="{Binding TotalAssetsBookValue, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Explanatory Text Note -->
                <TextBlock Text="{Binding PlExplanationText}" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" Margin="0,10,0,16" TextWrapping="Wrap"/>

                <!-- ROW 1 CHARTS: Grouped Bar Chart (Income vs Expenses) & Donut (Income by sales type) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- (A) Income vs Expenses · last 6 months -->
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="9" Height="9" CornerRadius="2" Background="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Income" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <Border Width="9" Height="9" CornerRadius="2" Background="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Expenses" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Income vs Expenses · last 6 months" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Plot Area with Y-Axis and Grouped Bars -->
                            <Grid Height="165">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Y-Axis Labels -->
                                <Grid Grid.Column="0" Margin="0,0,6,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding IncExpYMaxLabel}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="{Binding IncExpY2Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Text="{Binding IncExpY1Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="6" Text="{Binding IncExpY0Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Plot area -->
                                <Grid Grid.Column="1">
                                    <!-- Horizontal Gridlines -->
                                    <Grid Margin="0,6,0,26">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Line Grid.Row="0" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="2" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="4" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="6" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" Opacity="0.7"/>
                                    </Grid>

                                    <!-- Monthly Grouped Bars -->
                                    <ItemsControl ItemsSource="{Binding MonthlyBarChartItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0,2,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                                        <Border Width="16" Height="{Binding IncomeBarHeight}" Background="#3B82F6" CornerRadius="3,3,0,0" ToolTip="{Binding IncomeTooltip}" Margin="0,0,2.5,0" VerticalAlignment="Bottom"/>
                                                        <Border Width="16" Height="{Binding ExpenseBarHeight}" Background="#F59E0B" CornerRadius="3,3,0,0" ToolTip="{Binding ExpenseTooltip}" Margin="2.5,0,0,0" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- (B) Income by sales type (Donut Chart) -->
                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="View" Command="{Binding SetTabCommand}" CommandParameter="income"
                                        DockPanel.Dock="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="4,2"/>
                                <TextBlock Text="Income by sales type" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Donut + Legend -->
                            <Grid VerticalAlignment="Center" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut Left -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid Width="110" Height="110">
                                        <Viewbox Width="110" Height="110">
                                            <ItemsControl ItemsSource="{Binding IncomeBySalesTypeSlices}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="160" Height="160"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Total" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding IncomeBySalesTypeTotalDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="this month" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Legend Right -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding IncomeBySalesTypeSlices}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4" LastChildFill="True">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{Binding FillBrush}" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValueAndPct}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW 2 CHARTS: Single Bar Chart (Profit & Loss) & Donut (Expenses by type) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- (A) Profit & Loss · last 6 months -->
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="9" Height="9" CornerRadius="2" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Profit" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <Border Width="9" Height="9" CornerRadius="2" Background="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Loss" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Profit &amp; Loss · last 6 months" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Plot Area with Y-Axis and Single Bars -->
                            <Grid Height="165">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Y-Axis Labels -->
                                <Grid Grid.Column="0" Margin="0,0,6,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding PlYMaxLabel}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="{Binding PlY3Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Text="{Binding PlY2Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="6" Text="{Binding PlY1Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="8" Text="{Binding PlY0Label}" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Plot area -->
                                <Grid Grid.Column="1">
                                    <!-- Horizontal Gridlines -->
                                    <Grid Margin="0,6,0,26">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Line Grid.Row="0" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="2" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="4" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="6" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                        <Line Grid.Row="8" X1="0" X2="1" Stretch="Fill" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" Opacity="0.7"/>
                                    </Grid>

                                    <!-- Monthly Profit/Loss Bars -->
                                    <ItemsControl ItemsSource="{Binding MonthlyBarChartItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0,2,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Width="22" Height="{Binding PlBarHeight}" Background="{Binding PlBarBrush}" CornerRadius="3,3,0,0" ToolTip="{Binding PlTooltip}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding MonthLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- (B) Expenses by type (Donut Chart) -->
                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="View" Command="{Binding SetTabCommand}" CommandParameter="exp"
                                        DockPanel.Dock="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="4,2"/>
                                <TextBlock Text="Expenses by type" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Donut + Legend -->
                            <Grid VerticalAlignment="Center" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut Left -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid Width="110" Height="110">
                                        <Viewbox Width="110" Height="110">
                                            <ItemsControl ItemsSource="{Binding ExpensesByTypeSlices}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="160" Height="160"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Total" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExpensesByTypeTotalDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="this month" FontSize="9.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Legend Right -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ExpensesByTypeSlices}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4" LastChildFill="True">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{Binding FillBrush}" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValueAndPct}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW 3 CHARTS: 3 Donut Cards side-by-side -->
                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <!-- Donut Card 1: Loan outstanding by lender -->
                    <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="View" Command="{Binding SetTabCommand}" CommandParameter="loans"
                                        DockPanel.Dock="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="4,2"/>
                                <TextBlock Text="Loan outstanding by lender" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid VerticalAlignment="Center" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,8,0">
                                    <Viewbox Width="100" Height="100">
                                        <ItemsControl ItemsSource="{Binding LoanByLenderSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="160" Height="160"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Total" FontSize="9" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LoanByLenderTotalDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding LoanByLenderSlices}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3.5" LastChildFill="True">
                                                <Border Width="7" Height="7" CornerRadius="2" Background="{Binding FillBrush}" DockPanel.Dock="Left" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValueAndPct}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Donut Card 2: Investment by person -->
                    <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="View" Command="{Binding SetTabCommand}" CommandParameter="inv"
                                        DockPanel.Dock="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="4,2"/>
                                <TextBlock Text="Investment by person" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid VerticalAlignment="Center" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,8,0">
                                    <Viewbox Width="100" Height="100">
                                        <ItemsControl ItemsSource="{Binding InvestmentByPersonSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="160" Height="160"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Total" FontSize="9" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding InvestmentByPersonTotalDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding InvestmentByPersonSlices}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3.5" LastChildFill="True">
                                                <Border Width="7" Height="7" CornerRadius="2" Background="{Binding FillBrush}" DockPanel.Dock="Left" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValueAndPct}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Donut Card 3: Asset value by kind -->
                    <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Content="View" Command="{Binding SetTabCommand}" CommandParameter="assets"
                                        DockPanel.Dock="Right" Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="4,2"/>
                                <TextBlock Text="Asset value by kind" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid VerticalAlignment="Center" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,8,0">
                                    <Viewbox Width="100" Height="100">
                                        <ItemsControl ItemsSource="{Binding AssetByKindSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="160" Height="160"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Total" FontSize="9" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding AssetByKindTotalDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding AssetByKindSlices}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3.5" LastChildFill="True">
                                                <Border Width="7" Height="7" CornerRadius="2" Background="{Binding FillBrush}" DockPanel.Dock="Left" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ValueAndPct}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- TAB 1: INCOME -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=income}">
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- 1. Retail Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Retail Sales" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Domestic Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Domestic Sales" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Export Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Export Sales" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Total Income -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Income" FontSize="11.5" Foreground="#166534" FontWeight="Bold"/>
                            <TextBlock Text="{Binding IncomeTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Income Register (Net Revenue without GST)" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            <!-- Channel Filter Row Options with Dynamic Active Colors -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All Channels" Command="{Binding SetIncomeChannelCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Retail" Command="{Binding SetIncomeChannelCommand}" CommandParameter="retail" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=retail}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=retail}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=retail}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Domestic" Command="{Binding SetIncomeChannelCommand}" CommandParameter="domestic" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Export" Command="{Binding SetIncomeChannelCommand}" CommandParameter="export" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding IncomeRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" helpers:SmoothScrollHelper.BubbleMouseWheel="True" MaxHeight="600">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                    <DataGridTemplateColumn Header="Document" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding InvoiceNo}" ToolTip="{Binding InvoiceNo}" Command="{Binding DataContext.ViewDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Padding="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelLabel}" Width="95"/>
                                    <DataGridTemplateColumn Header="Customer" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding NetAmount, Converter={StaticResource InrConv}}" Width="135" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="GST (₹)" Binding="{Binding TaxAmount, Converter={StaticResource InrConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Total Billed (₹)" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 2: EXPENSES -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=exp}">
                <!-- Subtitle -->
                <TextBlock Text="Employee, utility and miscellaneous costs. Purchase bills are added automatically." FontSize="12.5" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,16"/>

                <!-- 5 KPI Cards: Employee, Utility, Misc Exp, Purchase bills, Total Expenses -->
                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <!-- Employee -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Employee" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EmployeeExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Utility -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Utility" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UtilityExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Misc Exp -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Misc Exp" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MiscExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Purchase bills -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Purchase bills" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PurchaseExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Expenses -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Expenses" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalExpenseOverall, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Expense Table with Search & Chips -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Controls Row: Search on Left, Filter Chips & Add Expense on Right -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Search... Box -->
                            <Border DockPanel.Dock="Left" Style="{StaticResource SearchContainerBorderStyle}" Width="240" VerticalAlignment="Center">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1" Text="Search expenses..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtExpSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtExpSearch}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtExpSearch" Grid.Column="1" Text="{Binding ExpenseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CleanSearchTextBoxStyle}"/>
                                </Grid>
                            </Border>

                            <!-- Chips: All, Employee, Utility, Misc Exp, Purchase bills + Add Expense -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="All" Command="{Binding SetExpenseFreqCommand}" CommandParameter="all" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Employee" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Employee" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Employee}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Employee}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Employee}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Utility" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Utility" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Utility}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Utility}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Utility}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Misc Exp" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Misc Exp" Margin="0,0,4,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Misc Exp}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Misc Exp}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Misc Exp}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Purchase bills" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Purchase" Margin="0,0,12,0" Height="36" Padding="12,0"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Purchase}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Purchase}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Purchase}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="+ Add Expense" Command="{Binding AddExpenseCommand}" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid with Columns: Date, Category, Type, Details, Amount, Delete -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="44"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" helpers:SmoothScrollHelper.BubbleMouseWheel="True" MaxHeight="600">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>

                                    <DataGridTemplateColumn Header="Category" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding GroupPillBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupDisplay}" Foreground="{Binding GroupPillBrush}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Type" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" FontSize="12"/>
                                                    <TextBlock Text="{Binding EmployeeSubtitle}" Foreground="{DynamicResource AppTextSecondary}" FontSize="10.5"
                                                               Visibility="{Binding HasEmployeeInfo, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Details" Binding="{Binding DisplayDetails}" Width="*" Foreground="#475569"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>

                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVis}}"
                                                        Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 3: INVESTMENT -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=inv}">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Investment" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Capital invested into the company. Adds to cash and increases owner equity." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Capital Invested" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalInvested, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Recovered from Net Profit" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecoveryPercent, StringFormat='{}{0:F0}%'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="8" Background="#F1F5F9" CornerRadius="4" Margin="0,8">
                                <Border HorizontalAlignment="Left" Width="{Binding RecoveryPercent}" Background="#10B981" CornerRadius="4"/>
                            </Border>
                            <TextBlock Text="{Binding AllTimeProfit, StringFormat='Cumulative net profit: ₹{0:N0}'}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Investment Ledger" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Add Investment" Command="{Binding AddInvestmentCommand}" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding InvestmentRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                    <DataGridTextColumn Header="Invested By" Binding="{Binding InvestedBy}" Width="180" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Purpose / Allocation" Binding="{Binding Purpose}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold"/>

                                    <DataGridTemplateColumn Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteInvestmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 4: PROFIT & LOSS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=pl}">
                <!-- P&L Running Statement -->
                <Border Background="White" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding PlPeriodLabel, StringFormat='Profit &amp; Loss Statement · {0}'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expenses Side -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="Expenses (Trading &amp; Factory)" FontWeight="Bold" FontSize="14" Foreground="#DC2626" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding PlExpenseCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Amount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Profit Balancer Line if in profit -->
                                    <Border Visibility="{Binding PlIsProfit, Converter={StaticResource BoolToVis}}" Background="#FEF3C7" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Net Profit" FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="{Binding PlNetProfit, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#92400E"/>
                                        </DockPanel>
                                    </Border>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Income Side -->
                            <Border Grid.Column="1" Padding="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Income (Sales)" FontWeight="Bold" FontSize="14" Foreground="#10B981" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Retail &amp; Exhibitions" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Domestic B2B Sales" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Export Overseas Sales" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,20,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Month-by-Month Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Monthly Financial Breakdown" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding PlMonthBreakdowns}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Income (₹)" Binding="{Binding Income, Converter={StaticResource InrConv}}" Width="140" Foreground="#10B981"/>
                                    <DataGridTextColumn Header="Expenses (₹)" Binding="{Binding Expenses, Converter={StaticResource InrConv}}" Width="140" Foreground="#DC2626"/>
                                    <DataGridTextColumn Header="Net Profit / Loss (₹)" Binding="{Binding ProfitLoss, Converter={StaticResource InrConv}}" Width="170" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Margin %" Binding="{Binding MarginText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 5: LOANS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=loans}">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Loans" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Money borrowed from banks or people. A loan adds to your cash but is not income. Repayments reduce the loan, and the interest becomes an expense in Profit &amp; Loss." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 4 KPI Tiles: Loan, Principal, Interest, Outstanding -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Loans Taken" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansTaken, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Principal Paid" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanPrincipalPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Interest Paid" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanInterestPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Outstanding to Pay" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansOutstanding, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- INLINE ADD LOAN ROW (All inputs in one row below the 4 boxes) -->
                <Border Background="White" Padding="16,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lender -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lender (Bank or Person) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanLender, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Date Received -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date Received *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding NewLoanDate}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Loan Amount -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Loan Amount (₹) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanAmount, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Interest % / yr -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Interest % / yr *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanInterestRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Note / Purpose -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Note (What was it for?)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLoanNote, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- + Add Loan Button -->
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <Button Content="+ Add Loan" Command="{Binding SaveInlineLoanCommand}" Height="36" Padding="18,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loans Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Loan Register &amp; Active Borrowings" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding LoanRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" MinRowHeight="46" RowDetailsVisibilityMode="Visible"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" helpers:SmoothScrollHelper.BubbleMouseWheel="True" MaxHeight="550">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8,16,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LastPaymentInfoText}" FontSize="11.5" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <Grid Height="7" Margin="0,2">
                                                    <ProgressBar Value="{Binding RepaidPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="7" BorderThickness="0" Background="Transparent">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid x:Name="Root">
                                                                    <Border x:Name="PART_Track" Background="#E2E8F0" CornerRadius="3.5"/>
                                                                    <Border x:Name="PART_Indicator" Background="#10B981" CornerRadius="3.5" HorizontalAlignment="Left"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </Grid>
                                                <TextBlock Text="{Binding RepaidSummaryText}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Lender" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Lender}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Taken On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Loan Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Interest" Binding="{Binding InterestRate, StringFormat={}{0}% a year}" Width="110"/>

                                    <DataGridTemplateColumn Header="Repaid" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalPrincipalPaid, Converter={StaticResource InrConv}}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Repayments.Count, StringFormat={}{0} payments}" FontSize="10.5" Foreground="{DynamicResource AppTextSecondary}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceRemaining, Converter={StaticResource InrConv}}" Width="130" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>

                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Actions" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" Command="{Binding DataContext.EditLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Padding="10,4" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                    <Button Content="Repay" Command="{Binding DataContext.RepayLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                            Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                    <Button Content="Delete" Command="{Binding DataContext.DeleteLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 6: ASSETS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=assets}">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Assets" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Things the company owns for a long time, such as machines, vehicles and furniture. They lose value every year (depreciation), which is counted as an expense in Profit &amp; Loss." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 4 KPI Tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Assets" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AssetsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Bought For" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsCost, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Value Lost So Far" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsDepreciation, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Worth Today" FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsBookValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- INLINE ADD ASSET ROW (All inputs in one row below the 4 boxes) -->
                <Border Background="White" Padding="16,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Asset Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Asset Name *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Kind -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kind *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AssetKinds}" SelectedItem="{Binding NewAssetKind}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Bought On -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Bought On *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding NewAssetDate}" Height="36" Padding="4,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Cost (₹) -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Cost (₹) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetCost, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Depreciation % / yr -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Loses Value % / yr *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewAssetRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" FontSize="12.5"/>
                        </StackPanel>

                        <!-- + Add Asset Button -->
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <Button Content="+ Add Asset" Command="{Binding SaveInlineAssetCommand}" Height="36" Padding="18,0" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Assets Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fixed Assets Register" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,14"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid ItemsSource="{Binding AssetRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" helpers:SmoothScrollHelper.BubbleMouseWheel="True" MaxHeight="600">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Header="Kind" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" Foreground="#2563EB" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Bought On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                    <DataGridTextColumn Header="Cost (₹)" Binding="{Binding Cost, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Loses Value" Binding="{Binding DepreciationRate, StringFormat={}{0}% a year}" Width="110"/>
                                    <DataGridTextColumn Header="Worth Today (₹)" Binding="{Binding BookValue, Converter={StaticResource InrConv}}" Width="130" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>

                                    <DataGridTemplateColumn Header="Actions" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 7: BALANCE SHEET -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=bs}">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Balance Sheet" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="What the company owns, what it owes, and what the owners have in it. Worked out from the bills, purchases, expenses, loans and assets you have already entered." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Balance Sheet Statement Panel -->
                <Border Background="White" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with Match indicator -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Balance Sheet" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text=" · " FontWeight="Bold" FontSize="16" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding BsTodayDate}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AppTextSecondary}"/>
                            </StackPanel>
                            <!-- Pill: Both sides match vs difference -->
                            <Border Background="#D1FAE5" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✓ Both sides match" Foreground="#065F46" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Difference: " Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding BsDifference, Converter={StaticResource InrConv}}" Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Two-Column Statement -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Assets -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <Border Background="#F8FAFC" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Assets (what it owns)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                </Border>

                                <!-- Machines, vehicles & other assets -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Machines, vehicles &amp; other assets" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsFixedAssets, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Stock in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Customers owe you -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Customers owe you" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsRecv, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Cash & bank -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Cash &amp; bank" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCash, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Assets -->
                                <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,96,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Assets" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{Binding BsAssetsTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Fill="#E2E8F0" VerticalAlignment="Stretch" Width="1"/>

                            <!-- RIGHT COLUMN: Liabilities & Capital -->
                            <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                <Border Background="#F8FAFC" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Liabilities &amp; Capital (what it owes + owners' share)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                </Border>

                                <!-- Capital -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Capital — money the owners put in" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCap, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Profit so far -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Profit so far" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsProfit, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Stock still in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock still in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Loans to repay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Loans to repay" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsLoans, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Vendors to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Vendors to pay" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsPay, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- GST to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="GST to pay government" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsGst, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Liabilities & Capital -->
                                <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Liabilities &amp; Capital" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{Binding BsLiabilitiesTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footnote note -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,24,0,0">
                            <TextBlock Text="💡 Cash &amp; bank is calculated from the payments recorded in this software. If you had cash or bank money before you started using it, add it under Investment so it is counted." FontSize="11.5" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>