<UserControl x:Class="AsiErp.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:RouteToActiveIndicatorConverter x:Key="RouteToActiveIndicatorConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveTabTitle}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <!-- Period Dropdown -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Period: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <ComboBox SelectedValue="{Binding SelectedPeriod, Mode=TwoWay}" SelectedValuePath="Tag" Width="150" Padding="8,6">
                        <ComboBoxItem Content="This month" Tag="m0"/>
                        <ComboBoxItem Content="Last month" Tag="m1"/>
                        <ComboBoxItem Content="Last 3 months" Tag="q"/>
                        <ComboBoxItem Content="This FY" Tag="fy"/>
                        <ComboBoxItem Content="All time" Tag="all"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <!-- TAB 0: FINANCE & ACCOUNTS DASHBOARD -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=dashboard}">
                <!-- 7 KPI Tiles -->
                <!-- Row 1: Income, Expenses, Profit and Loss, Net P&L -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <!-- (1) INCOME -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="INCOME" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlTotalIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (2) EXPENSES -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="EXPENSES" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlTotalExpense, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (3) PROFIT AND LOSS (RED IN LOSS GREEN IN PROFIT) -->
                    <Border Background="{Binding PlCardBrush}" Padding="16,14" Margin="0,0,14,0" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.08"/>
                        </Border.Effect>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Profit Icon (Coin with ₹) -->
                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Visibility="{Binding PlIsProfit, Converter={StaticResource BoolToVis}}">
                                <Ellipse Fill="White" Opacity="0.22"/>
                                <Ellipse Stroke="White" StrokeThickness="2"/>
                                <TextBlock Text="₹" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Grid>

                            <!-- Loss Icon (Warning Triangle with !) -->
                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Visibility="{Binding PlIsProfit, Converter={StaticResource InverseBoolToVis}}">
                                <Path Data="M 18,3 L 34,31 H 2 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="!" Foreground="#DC2626" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0"/>
                            </Grid>

                            <!-- Label and Value -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlCardLabel}" FontSize="12.5" Foreground="White" FontWeight="SemiBold" Opacity="0.95"/>
                                <TextBlock Text="{Binding PlValueDisplay}" FontSize="21" FontWeight="Bold" Foreground="White" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- (4) NET P&L -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="NET P&amp;L" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlNetProfitDisplay}" FontSize="22" FontWeight="Bold" Foreground="{Binding PlProfitLossColor}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 2: Loan Outstanding, Investment, Asset Value -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <!-- (5) LOAN OUTSTANDING -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="LOAN OUTSTANDING" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DashTotalLoans, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (6) INVESTMENT -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="INVESTMENT" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DashCapital, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (7) ASSET VALUE -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ASSET VALUE" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DashFixedAssets, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- CHARTS: LINE CHART & PIE CHART -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINE CHART (Income vs Expenses Trend) -->
                    <Border Grid.Column="0" Background="White" Padding="20" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Line Chart Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Legend: Income -->
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Income" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <!-- Legend: Expenses -->
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Expenses" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Income &amp; Expenses Trend" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="6-month financial performance curve" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Line Chart Viewbox -->
                            <Viewbox Stretch="Uniform" Height="210">
                                <Canvas Width="500" Height="200" ClipToBounds="True">
                                    <!-- Grid lines and Y-axis labels -->
                                    <Line X1="50" Y1="20" X2="480" Y2="20" Stroke="#F1F5F9" StrokeThickness="1"/>
                                    <TextBlock Text="{Binding ChartYMaxLabel}" Canvas.Left="4" Canvas.Top="12" FontSize="9.5" Foreground="#94A3B8" Width="42" TextAlignment="Right"/>

                                    <Line X1="50" Y1="90" X2="480" Y2="90" Stroke="#F1F5F9" StrokeThickness="1"/>
                                    <TextBlock Text="{Binding ChartYMidLabel}" Canvas.Left="4" Canvas.Top="82" FontSize="9.5" Foreground="#94A3B8" Width="42" TextAlignment="Right"/>

                                    <Line X1="50" Y1="160" X2="480" Y2="160" Stroke="#E2E8F0" StrokeThickness="1.5"/>
                                    <TextBlock Text="{Binding ChartYZeroLabel}" Canvas.Left="4" Canvas.Top="152" FontSize="9.5" Foreground="#94A3B8" Width="42" TextAlignment="Right"/>

                                    <!-- Shaded Area Fills -->
                                    <Polygon Points="{Binding IncomeAreaPoints}" Fill="#2563EB" Opacity="0.08"/>
                                    <Polygon Points="{Binding ExpenseAreaPoints}" Fill="#DC2626" Opacity="0.06"/>

                                    <!-- Main Polylines -->
                                    <Polyline Points="{Binding IncomeLinePoints}" Stroke="#2563EB" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Polyline Points="{Binding ExpenseLinePoints}" Stroke="#DC2626" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <!-- Data Points & Tooltips -->
                                    <ItemsControl ItemsSource="{Binding LineChartPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="500" Height="200"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas Width="500" Height="200">
                                                    <!-- Vertical Guide Line -->
                                                    <Line X1="{Binding X}" Y1="20" X2="{Binding X}" Y2="160" Stroke="#F8FAFC" StrokeThickness="1" StrokeDashArray="2 2"/>

                                                    <!-- Month Label on X Axis -->
                                                    <TextBlock Text="{Binding MonthLabel}" Canvas.Left="{Binding X}" Canvas.Top="168"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                                                               HorizontalAlignment="Center" Margin="-16,0,0,0" Width="32" TextAlignment="Center"/>

                                                    <!-- Income Point (Blue Dot) -->
                                                    <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding IncomeY}"
                                                             Width="8" Height="8" Margin="-4,-4,0,0"
                                                             Fill="#2563EB" Stroke="White" StrokeThickness="2"
                                                             ToolTip="{Binding TooltipText}" Cursor="Hand"/>

                                                    <!-- Expense Point (Red Dot) -->
                                                    <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding ExpenseY}"
                                                             Width="8" Height="8" Margin="-4,-4,0,0"
                                                             Fill="#DC2626" Stroke="White" StrokeThickness="2"
                                                             ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </DockPanel>
                    </Border>

                    <!-- PIE / DONUT CHART (Expense Breakdown) -->
                    <Border Grid.Column="1" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Pie Chart Header -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalExpensesDisplay}" FontWeight="Bold" FontSize="12.5" Foreground="#DC2626" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Expense Breakdown" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="Category distribution" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Donut and Legend -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut Viewbox -->
                                <Viewbox Grid.Column="0" Stretch="Uniform" Width="145" Height="145" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="200" Height="200">
                                        <!-- Donut Slices -->
                                        <ItemsControl ItemsSource="{Binding PieChartSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding SliceGeometry}" Fill="{Binding FillBrush}" ToolTip="{Binding TooltipText}" Cursor="Hand"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Center text for Donut hole -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalExpensesDisplay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>

                                <!-- Legend List -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0" MaxHeight="190">
                                    <ItemsControl ItemsSource="{Binding PieChartSlices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding FillBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PercentageDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- TAB 1: INCOME -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=income}">
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- 1. Retail Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Retail Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Domestic Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Domestic Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Export Sales -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Export Sales" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Total Income -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Income" FontSize="11.5" Foreground="#166534" FontWeight="Bold"/>
                            <TextBlock Text="{Binding IncomeTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Income Register (Net Revenue without GST)" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <!-- Channel Filter Row Options with Dynamic Active Colors -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All Channels" Command="{Binding SetIncomeChannelCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Retail" Command="{Binding SetIncomeChannelCommand}" CommandParameter="retail" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=retail}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=retail}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=retail}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Domestic" Command="{Binding SetIncomeChannelCommand}" CommandParameter="domestic" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Export" Command="{Binding SetIncomeChannelCommand}" CommandParameter="export" Padding="12,5"
                                        Background="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                        Foreground="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                        BorderBrush="{Binding SelectedIncomeChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding IncomeRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                <DataGridTemplateColumn Header="Document" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding InvoiceNo}" ToolTip="{Binding InvoiceNo}" Command="{Binding DataContext.ViewDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Left" Padding="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Channel" Binding="{Binding ChannelLabel}" Width="95"/>
                                <DataGridTemplateColumn Header="Customer" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding NetAmount, Converter={StaticResource InrConv}}" Width="135" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="GST (₹)" Binding="{Binding TaxAmount, Converter={StaticResource InrConv}}" Width="110"/>
                                <DataGridTextColumn Header="Total Billed (₹)" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="130" FontWeight="SemiBold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 2: EXPENSES -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=exp}">
                <!-- Subtitle -->
                <TextBlock Text="Employee, utility and miscellaneous costs. Purchase bills are added automatically." FontSize="12.5" Foreground="#64748B" Margin="0,0,0,16"/>

                <!-- 4 KPI Cards: Employee, Utility, Misc Exp, Purchase bills -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- Employee -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Employee" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EmployeeExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Utility -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Utility" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UtilityExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Misc Exp -->
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Misc Exp" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MiscExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Purchase bills -->
                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Purchase bills" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PurchaseExpenseTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Expense Table with Search & Chips -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Controls Row: Search on Left, Filter Chips & Add Expense on Right -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <!-- Search... Box -->
                            <Border DockPanel.Dock="Left" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="220" VerticalAlignment="Center">
                                <Grid>
                                    <TextBox x:Name="TxtExpSearch" Text="{Binding ExpenseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#0F172A"/>
                                    <TextBlock Text="Search..." Foreground="#94A3B8" FontSize="12" Margin="10,6" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtExpSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Chips: All, Employee, Utility, Misc Exp, Purchase bills + Add Expense -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="All" Command="{Binding SetExpenseFreqCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Employee" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Employee" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Employee}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Employee}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Employee}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Utility" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Utility" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Utility}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Utility}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Utility}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Misc Exp" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Misc Exp" Margin="0,0,4,0" Padding="12,5"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Misc Exp}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Misc Exp}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Misc Exp}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Purchase bills" Command="{Binding SetExpenseFreqCommand}" CommandParameter="Purchase" Margin="0,0,12,0" Padding="12,5"
                                        Background="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Purchase}"
                                        Foreground="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Purchase}"
                                        BorderBrush="{Binding SelectedExpenseFreq, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Purchase}"
                                        BorderThickness="1" FontSize="11" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="+ Add Expense" Command="{Binding AddExpenseCommand}" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid with Columns: Date, Category, Type, Details, Amount, Delete -->
                        <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>

                                <DataGridTemplateColumn Header="Category" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding GroupPillBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GroupDisplay}" Foreground="{Binding GroupPillBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Type" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                                                <TextBlock Text="{Binding EmployeeSubtitle}" Foreground="#64748B" FontSize="10.5"
                                                           Visibility="{Binding HasEmployeeInfo, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Details" Binding="{Binding DisplayDetails}" Width="*" Foreground="#475569"/>
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold" Foreground="#0F172A"/>

                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsAuto, Converter={StaticResource InverseBoolToVis}}"
                                                    Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 3: INVESTMENT -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=inv}">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Capital Invested" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalInvested, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Recovered from Net Profit" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecoveryPercent, StringFormat='{}{0:F0}%'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="8" Background="#F1F5F9" CornerRadius="4" Margin="0,8">
                                <Border HorizontalAlignment="Left" Width="{Binding RecoveryPercent}" Background="#10B981" CornerRadius="4"/>
                            </Border>
                            <TextBlock Text="{Binding AllTimeProfit, StringFormat='Cumulative net profit: ₹{0:N0}'}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Investment Ledger" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="+ Add Investment" Command="{Binding AddInvestmentCommand}" HorizontalAlignment="Right" Padding="14,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding InvestmentRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                                <DataGridTextColumn Header="Invested By" Binding="{Binding InvestedBy}" Width="180" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Purpose / Allocation" Binding="{Binding Purpose}" Width="*"/>
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold"/>

                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteInvestmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="6,2" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 4: PROFIT & LOSS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=pl}">
                <!-- P&L Running Statement -->
                <Border Background="White" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding PlPeriodLabel, StringFormat='Profit &amp; Loss Statement · {0}'}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expenses Side -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="Expenses (Trading &amp; Factory)" FontWeight="Bold" FontSize="14" Foreground="#DC2626" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding PlExpenseCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="12"/>
                                                    <TextBlock Text="{Binding Amount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Profit Balancer Line if in profit -->
                                    <Border Visibility="{Binding PlIsProfit, Converter={StaticResource BoolToVis}}" Background="#FEF3C7" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Net Profit" FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="{Binding PlNetProfit, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#92400E"/>
                                        </DockPanel>
                                    </Border>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Income Side -->
                            <Border Grid.Column="1" Padding="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Income (Sales)" FontWeight="Bold" FontSize="14" Foreground="#10B981" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Retail &amp; Exhibitions" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding RetailIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Domestic B2B Sales" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding DomesticIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Export Overseas Sales" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding ExportIncome, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,20,0,0" Padding="0,6,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Total Side" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding PlTotalSide, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Month-by-Month Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Monthly Financial Breakdown" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding PlMonthBreakdowns}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Income (₹)" Binding="{Binding Income, Converter={StaticResource InrConv}}" Width="140" Foreground="#10B981"/>
                                <DataGridTextColumn Header="Expenses (₹)" Binding="{Binding Expenses, Converter={StaticResource InrConv}}" Width="140" Foreground="#DC2626"/>
                                <DataGridTextColumn Header="Net Profit / Loss (₹)" Binding="{Binding ProfitLoss, Converter={StaticResource InrConv}}" Width="170" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Margin %" Binding="{Binding MarginText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 5: LOANS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=loans}">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Loans" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Money borrowed from banks or people. A loan adds to your cash but is not income. Repayments reduce the loan, and the interest becomes an expense in Profit &amp; Loss." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="+ Add Loan" Command="{Binding AddLoanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </DockPanel>

                <!-- 4 KPI Tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Loans Taken" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansTaken, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Interest Paid" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanInterestPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Principal Paid" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoanPrincipalPaid, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Outstanding to Pay" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalLoansOutstanding, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Loans Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Loan Register &amp; Active Borrowings" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding LoanRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="48">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Lender" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Lender}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Note}" Foreground="#64748B" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Taken On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                <DataGridTextColumn Header="Loan Amount (₹)" Binding="{Binding Amount, Converter={StaticResource InrConv}}" Width="140" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Interest" Binding="{Binding InterestRate, StringFormat={}{0}% a year}" Width="120"/>

                                <DataGridTemplateColumn Header="Repaid" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalPrincipalPaid, Converter={StaticResource InrConv}}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Repayments.Count, StringFormat={}{0} payments}" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceRemaining, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold" Foreground="#0F172A"/>

                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBackground}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Actions" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Repay" Command="{Binding DataContext.RepayLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                        Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 6: ASSETS -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=assets}">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Assets" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Things the company owns for a long time, such as machines, vehicles and furniture. They lose value every year (depreciation), which is counted as an expense in Profit &amp; Loss." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="+ Add Asset" Command="{Binding AddAssetCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,8" Background="#172443" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </DockPanel>

                <!-- 4 KPI Tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Assets" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AssetsCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Bought For" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsCost, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Value Lost So Far" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsDepreciation, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Worth Today" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAssetsBookValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Assets Table -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Fixed Assets Register" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding AssetRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Kind" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" Foreground="#2563EB" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Bought On" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="110"/>
                                <DataGridTextColumn Header="Cost (₹)" Binding="{Binding Cost, Converter={StaticResource InrConv}}" Width="140" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Loses Value" Binding="{Binding DepreciationRate, StringFormat={}{0}% a year}" Width="120"/>
                                <DataGridTextColumn Header="Worth Today (₹)" Binding="{Binding BookValue, Converter={StaticResource InrConv}}" Width="140" FontWeight="Bold" Foreground="#0F172A"/>

                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="White" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- TAB 7: BALANCE SHEET -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource RouteToActiveIndicatorConv}, ConverterParameter=bs}">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Balance Sheet" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="What the company owns, what it owes, and what the owners have in it. Worked out from the bills, purchases, expenses, loans and assets you have already entered." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Balance Sheet Statement Panel -->
                <Border Background="White" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header with Match indicator -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Balance Sheet" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                <TextBlock Text=" · " FontWeight="Bold" FontSize="16" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding BsTodayDate}" FontWeight="SemiBold" FontSize="15" Foreground="#64748B"/>
                            </StackPanel>
                            <!-- Pill: Both sides match vs difference -->
                            <Border Background="#D1FAE5" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✓ Both sides match" Foreground="#065F46" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="16" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding BsIsBalanced, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Difference: " Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding BsDifference, Converter={StaticResource InrConv}}" Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Two-Column Statement -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Assets -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <Border Background="#F8FAFC" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Assets (what it owns)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                </Border>

                                <!-- Machines, vehicles & other assets -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Machines, vehicles &amp; other assets" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsFixedAssets, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Stock in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Customers owe you -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Customers owe you" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsRecv, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Cash & bank -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Cash &amp; bank" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCash, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Assets -->
                                <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,96,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Assets" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding BsAssetsTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Fill="#E2E8F0" VerticalAlignment="Stretch" Width="1"/>

                            <!-- RIGHT COLUMN: Liabilities & Capital -->
                            <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                <Border Background="#F8FAFC" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock Text="Liabilities &amp; Capital (what it owes + owners' share)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                </Border>

                                <!-- Capital -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Capital — money the owners put in" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsCap, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Profit so far -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Profit so far" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsProfit, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Stock still in hand -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Stock still in hand" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsStock, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Loans to repay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Loans to repay" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsLoans, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- Vendors to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="Vendors to pay" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsPay, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <Separator Margin="0,2" Background="#F1F5F9"/>

                                <!-- GST to pay -->
                                <DockPanel Margin="0,10">
                                    <TextBlock Text="GST to pay government" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BsGst, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <!-- Total Liabilities & Capital -->
                                <Border BorderBrush="#0F172A" BorderThickness="0,2,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Liabilities &amp; Capital" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding BsLiabilitiesTotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footnote note -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,24,0,0">
                            <TextBlock Text="💡 Cash &amp; bank is calculated from the payments recorded in this software. If you had cash or bank money before you started using it, add it under Investment so it is counted." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>