<UserControl x:Class="AsiErp.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Top Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding AddButtonText}" Command="{Binding AddItemCommand}" Padding="13,7" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="{Binding BuyButtonText}" Command="{Binding BuyItemCommand}" Padding="13,7" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="📥 Download CSV" Command="{Binding ExportCsvCommand}" Padding="13,7" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>


            <!-- 4 Stats Tiles -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total SKUs / Items" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Items.Count}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Stock Value" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- (3) Total Stock -->
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Stock" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalUnitsOnHand, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- (4) Low Stock -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Low Stock" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table Container -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="36" HorizontalAlignment="Left" Padding="10,0" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <!-- Stock Table -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42" MinWidth="920">
                            <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Item Description" Width="260" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" MinWidth="80" FontWeight="SemiBold" Foreground="#334155"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85" MinWidth="50" Foreground="#475569"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat={}{0:N0}}" Width="95" MinWidth="60" FontWeight="Bold" Foreground="#0F172A"/>
                            <DataGridTextColumn Header="Cost Price" Binding="{Binding RateOrCost, Converter={StaticResource InrConv}}" Width="110" MinWidth="70" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Stock Value" Binding="{Binding TotalValue, Converter={StaticResource InrConv}}" Width="115" MinWidth="80" FontWeight="Bold" Foreground="#0F172A"/>

                            <DataGridTemplateColumn Header="Level Meter" Width="120" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Height="6" Background="#F1F5F9" CornerRadius="3" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" Width="{Binding LevelMeterWidth}" Background="{Binding StatusLevel, Converter={StaticResource StatusBrushConv}}" CornerRadius="3"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="95" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding StatusLevel, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding StatusLevelText}" Foreground="{Binding StatusLevel, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="145" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Adjust" Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Edit" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Foreground="#0F172A" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
