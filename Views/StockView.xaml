<UserControl x:Class="AsiErp.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- Header (Responsive DockPanel + WrapPanel) -->
            <DockPanel Margin="0,0,0,16">
                <!-- Top Action Buttons (Wraps on smaller screens) -->
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding AddButtonText}" Command="{Binding AddItemCommand}" Padding="11,6" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="{Binding BuyButtonText}" Command="{Binding BuyItemCommand}" Padding="11,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="📥 Download CSV" Command="{Binding ExportCsvCommand}" Padding="11,6" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </WrapPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>


            <!-- 4 Stats Tiles -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total SKUs / Items" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Items.Count}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Stock Value" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- (3) Total Stock -->
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Stock" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalUnitsOnHand, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- (4) Low Stock -->
                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Low Stock" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table Container -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="36" HorizontalAlignment="Left" Padding="10,0" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <!-- Stock Table (Responsive, No Horizontal Scroll) -->
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42">
                        <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Item Description" Width="*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105" MinWidth="70" FontWeight="SemiBold" Foreground="#334155"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55" MinWidth="45" Foreground="#475569"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat={}{0:N0}}" Width="75" MinWidth="55" FontWeight="Bold" Foreground="#0F172A"/>
                        <DataGridTextColumn Header="Cost Price" Binding="{Binding RateOrCost, Converter={StaticResource InrConv}}" Width="85" MinWidth="65" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Stock Value" Binding="{Binding TotalValue, Converter={StaticResource InrConv}}" Width="90" MinWidth="70" FontWeight="Bold" Foreground="#0F172A"/>

                        <DataGridTemplateColumn Header="Level Meter" Width="80" MinWidth="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Height="6" Background="#F1F5F9" CornerRadius="3" VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left" Width="{Binding LevelMeterWidth}" Background="{Binding StatusLevel, Converter={StaticResource StatusBrushConv}}" CornerRadius="3"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="75" MinWidth="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding StatusLevel, Converter={StaticResource StatusBgConv}}">
                                        <TextBlock Text="{Binding StatusLevelText}" Foreground="{Binding StatusLevel, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Action" Width="125" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Adjust" Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="9,3" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="Edit" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="9,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Foreground="#0F172A" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
