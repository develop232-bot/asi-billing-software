<UserControl x:Class="AsiErp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- Header (Responsive DockPanel + WrapPanel) -->
            <DockPanel Margin="0,0,0,14">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📥 Upload CSV" Command="{Binding BulkImportCommand}" Padding="11,6" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="📤 Download file" Command="{Binding DownloadFileCommand}" Padding="11,6" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="+ Add Products" Command="{Binding AddItemCommand}" Padding="13,6" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </WrapPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Products" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Every item lives here: raw material and general packing (not for sale) plus your finished and readymade sale products with retail, domestic and export pricing." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Yellow Dotted Line Separator -->
            <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

            <!-- Stat Counters (5 KPI Boxes) -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <!-- 1. Total Active SKUs -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Active SKUs" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalSkusCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Raw Materials -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Raw Materials" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RawMaterialsCount}" FontSize="24" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 3. Finished Products -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Finished Products" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FinishedProductsCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 4. Readymade Products -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Readymade Products" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReadymadeProductsCount}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 5. General Packaging -->
                <Border Background="White" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="General Packaging" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GeneralItemsCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Master Table Card -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Filter Bar: Search, Date Range, and Category Tabs (Responsive WrapPanel) -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14" VerticalAlignment="Center">
                        <!-- Search Box with Hint & Clean Focus -->
                        <Border Style="{StaticResource SearchContainerBorderStyle}" Width="240" Margin="0,0,10,6" VerticalAlignment="Center">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="Search products, SKU..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtProdSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtProdSearch}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="TxtProdSearch" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanSearchTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Date Filter (From - To) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                            <TextBlock Text="From:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="105" Height="34" Padding="3,0" VerticalContentAlignment="Center" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="To:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="6,0,4,0"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="105" Height="34" Padding="3,0" VerticalContentAlignment="Center" FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="Reset" Command="{Binding ClearDateFilterCommand}" ToolTip="Reset Date Filter"
                                    Height="34" Padding="10,0" Margin="4,0,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Type Tabs -->
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                            <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="all" Margin="0,0,4,0" Height="34" Padding="10,0"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                    BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Raw Material" Command="{Binding SetFilterCommand}" CommandParameter="raw" Margin="0,0,4,0" Height="34" Padding="10,0"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=raw}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=raw}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=raw}"
                                    BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Finished Product" Command="{Binding SetFilterCommand}" CommandParameter="mfg" Margin="0,0,4,0" Height="34" Padding="10,0"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=mfg}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=mfg}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=mfg}"
                                    BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Readymade Product" Command="{Binding SetFilterCommand}" CommandParameter="ready" Margin="0,0,4,0" Height="34" Padding="10,0"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=ready}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=ready}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=ready}"
                                    BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="General Packaging" Command="{Binding SetFilterCommand}" CommandParameter="gen" Height="34" Padding="10,0"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=gen}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=gen}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=gen}"
                                    BorderThickness="1" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </WrapPanel>
                    </WrapPanel>

                    <!-- Catalog Table (Responsive, No Horizontal Scroll) -->
                    <DataGrid ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                        <!-- 1. Date -->
                        <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="75" MinWidth="60"/>

                        <!-- 2. Item Description -->
                        <DataGridTemplateColumn Header="Item Description" Width="*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Unit -->
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="50" MinWidth="40"/>

                        <!-- 4. Type -->
                        <DataGridTemplateColumn Header="Type" Width="85" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="#F1F5F9" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding TypeColor}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. SKU -->
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="85" MinWidth="65" FontWeight="SemiBold"/>

                        <!-- 6. HSN -->
                        <DataGridTextColumn Header="HSN" Binding="{Binding HsnDisplay}" Width="55" MinWidth="45"/>

                        <!-- 7. Cost Price -->
                        <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPriceDisplay}" Width="80" MinWidth="60"/>

                        <!-- 8. Selling Price -->
                        <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPriceDisplay}" Width="80" MinWidth="60"/>

                        <!-- 9. GST -->
                        <DataGridTextColumn Header="GST" Binding="{Binding GstDisplay}" Width="50" MinWidth="40"/>

                        <!-- 10. Stock -->
                        <DataGridTextColumn Header="Stock" Binding="{Binding QuantityDisplay}" Width="65" MinWidth="50" FontWeight="Bold"/>

                        <!-- 11. Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="140" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🖨️" ToolTip="Print Barcode" Command="{Binding DataContext.PrintBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanPrintBarcode, Converter={StaticResource BoolToVis}}"
                                                Padding="6,3" Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="Edit" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="8,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="6,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
