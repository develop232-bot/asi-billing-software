<UserControl x:Class="AsiErp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Product Master &amp; Items" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Manage Raw Materials, Finished Products, General Packaging." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📥 Upload CSV" Command="{Binding BulkImportCommand}" Padding="14,8" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="📤 Download CSV" Command="{Binding ExportCsvCommand}" Padding="14,8" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="+ Add New Item" Command="{Binding AddItemCommand}" Padding="16,8" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#172443" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Stat Counters (5 KPI Boxes) -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <!-- 1. Total Active SKUs -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Active SKUs" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalSkusCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Raw Materials -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Raw Materials" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RawMaterialsCount}" FontSize="24" FontWeight="Bold" Foreground="#0D9488" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 3. Finished Products -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Finished Products" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FinishedProductsCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 4. Readymade Products -->
                <Border Background="White" Padding="16,14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Readymade Products" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReadymadeProductsCount}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>

                <!-- 5. General Packaging -->
                <Border Background="White" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="General Packaging" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GeneralItemsCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,2"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Master Table Card -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Filter Bar: Search, Date Range (From - To), and Category Tabs -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <!-- Left: Search Box -->
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="10,6" Margin="0,0,14,0" VerticalAlignment="Center"/>

                        <!-- Center: Date Filter (From - To) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="From:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,5,0"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="120" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="To:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="10,0,5,0"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="120" FontSize="11.5" VerticalAlignment="Center"/>
                            <Button Content="Reset" Command="{Binding ClearDateFilterCommand}" ToolTip="Reset Date Filter"
                                    Padding="10,4" Margin="6,0,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Right: Type Tabs (Order: All, Raw Material, Finished Product, Readymade Product, General Packaging) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Raw Material" Command="{Binding SetFilterCommand}" CommandParameter="raw" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=raw}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=raw}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=raw}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Finished Product" Command="{Binding SetFilterCommand}" CommandParameter="mfg" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=mfg}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=mfg}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=mfg}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Readymade Product" Command="{Binding SetFilterCommand}" CommandParameter="ready" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=ready}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=ready}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=ready}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="General Packaging" Command="{Binding SetFilterCommand}" CommandParameter="gen" Padding="12,5"
                                    Background="{Binding ActiveFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=gen}"
                                    Foreground="{Binding ActiveFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=gen}"
                                    BorderBrush="{Binding ActiveFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=gen}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Catalog Table: Date / item description / unit of measurement / Type / SKU / barcode / cost price / selling price / GST / quantity -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="42" MinWidth="1350">
                            <DataGrid.Columns>
                            <!-- 1. Date -->
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="100" MinWidth="70"/>

                            <!-- 2. Item Description -->
                            <DataGridTemplateColumn Header="Item Description" Width="260" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Unit of Measurement -->
                            <DataGridTextColumn Header="Unit of Measurement" Binding="{Binding Unit}" Width="150" MinWidth="80"/>

                            <!-- 4. Type -->
                            <DataGridTemplateColumn Header="Type" Width="135" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="#F1F5F9" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding TypeColor}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. SKU -->
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" MinWidth="80" FontWeight="SemiBold"/>

                            <!-- 6. HSN -->
                            <DataGridTextColumn Header="HSN" Binding="{Binding HsnDisplay}" Width="85" MinWidth="60"/>

                            <!-- 7. Barcode -->
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" MinWidth="80" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold"/>

                            <!-- 7. Cost Price -->
                            <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPriceDisplay}" Width="105" MinWidth="70"/>

                            <!-- 8. Selling Price -->
                            <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPriceDisplay}" Width="105" MinWidth="70"/>

                            <!-- 9. GST -->
                            <DataGridTextColumn Header="GST" Binding="{Binding GstDisplay}" Width="80" MinWidth="55"/>

                            <!-- 10. Stock -->
                            <DataGridTextColumn Header="Stock" Binding="{Binding QuantityDisplay}" Width="95" MinWidth="60" FontWeight="Bold"/>

                            <!-- 11. Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="185" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🖨️ Barcode" Command="{Binding DataContext.PrintBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanPrintBarcode, Converter={StaticResource BoolToVis}}"
                                                    Padding="8,4" Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Edit" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11" Margin="0,0,6,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
