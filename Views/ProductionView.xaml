<UserControl x:Class="AsiErp.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Title & Subtitle -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Production &amp; Shop Floor" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Work orders track customer allocations, production stages, raw material consumption and finished goods." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="+ New Work Order" Command="{Binding NewWorkOrderCommand}" HorizontalAlignment="Right" Padding="16,8" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            </DockPanel>

            <!-- 4 Stats Tiles -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Pending Orders" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold" Foreground="#64748B" Margin="0,5,0,2"/>
                        <TextBlock Text="Awaiting material / start" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="In Progress" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InProgressCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,5,0,2"/>
                        <TextBlock Text="Cutting, stitching, lasting" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Completed This Month" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CompletedThisMonthCount}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,2"/>
                        <TextBlock Text="Moved into finished goods" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Overdue Orders" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,2"/>
                        <TextBlock Text="Past delivery deadline" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table Container -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Filter Tools with Dynamic Active Color Chips -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="10,6" Margin="0,0,16,0"/>

                        <!-- Type Chips -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All Orders" Command="{Binding SetTypeFilterCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="General / Stock" Command="{Binding SetTypeFilterCommand}" CommandParameter="general" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=general}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=general}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=general}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Domestic" Command="{Binding SetTypeFilterCommand}" CommandParameter="domestic" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Export" Command="{Binding SetTypeFilterCommand}" CommandParameter="export" Padding="12,5"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Work Orders Table -->
                    <DataGrid ItemsSource="{Binding FilteredOrders}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="120" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Customer" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Customer}" ToolTip="{Binding Customer}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Type" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="#F1F5F9">
                                            <TextBlock Text="{Binding OrderTypeLabel}" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Product(s) &amp; Quantity" Binding="{Binding ProductsSummary}" Width="*"/>
                            <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, Converter={StaticResource DateConv}}" Width="95"/>

                            <DataGridTemplateColumn Header="Due Date" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DateConv}}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" OVERDUE" Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}" Foreground="#DC2626" FontWeight="Bold" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Edit" Command="{Binding DataContext.EditWorkOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="10,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>