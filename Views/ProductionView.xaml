<UserControl x:Class="AsiErp.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- Title & Subtitle (Responsive DockPanel) -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="+ New Work Order" Command="{Binding NewWorkOrderCommand}"
                        VerticalAlignment="Center" Padding="13,7" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Production &amp; Shop Floor" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Work orders track customer allocations, production stages, raw material consumption and finished goods." FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- 5 Stats Tiles -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold" Foreground="#64748B" Margin="0,5,0,0"/>
                        <TextBlock Text="not started" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Started" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StartedCount}" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" Margin="0,5,0,0"/>
                        <TextBlock Text="work initiated" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="In Progress" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InProgressCount}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        <TextBlock Text="active factory stages" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Completed This Month" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CompletedThisMonthCount}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        <TextBlock Text="finished goods made" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Overdue" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        <TextBlock Text="past due date" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table Container -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Filter Tools with Dynamic Active Color Chips -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <!-- Search Box with Hint & Clean Focus -->
                        <Border Style="{StaticResource SearchContainerBorderStyle}" Width="260" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="Search orders, products..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtWoSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtWoSearch}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="TxtWoSearch" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanSearchTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Type Chips -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="All Orders" Command="{Binding SetTypeFilterCommand}" CommandParameter="all" Margin="0,0,4,0"
                                    Style="{StaticResource TabFilterButtonStyle}"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                            <Button Content="General / Stock" Command="{Binding SetTypeFilterCommand}" CommandParameter="general" Margin="0,0,4,0"
                                    Style="{StaticResource TabFilterButtonStyle}"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=general}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=general}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=general}"/>

                            <Button Content="Domestic" Command="{Binding SetTypeFilterCommand}" CommandParameter="domestic" Margin="0,0,4,0"
                                    Style="{StaticResource TabFilterButtonStyle}"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"/>

                            <Button Content="Export" Command="{Binding SetTypeFilterCommand}" CommandParameter="export"
                                    Style="{StaticResource TabFilterButtonStyle}"
                                    Background="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                    Foreground="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                    BorderBrush="{Binding SelectedTypeFilter, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Work Orders Table (Responsive, No Horizontal Scroll) -->
                    <DataGrid ItemsSource="{Binding FilteredOrders}" AutoGenerateColumns="False" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order No" Binding="{Binding OrderNo}" Width="95" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Customer" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Customer}" ToolTip="{Binding Customer}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Type" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="#F1F5F9">
                                            <TextBlock Text="{Binding OrderTypeLabel}" Foreground="#475569" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Product(s) &amp; Quantity" Binding="{Binding ProductsSummary}" Width="1.3*" MinWidth="120"/>
                            <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, Converter={StaticResource DateConv}}" Width="85"/>

                            <DataGridTemplateColumn Header="Due Date" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DateConv}}" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBlock Text=" OVERDUE" Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}" Foreground="#DC2626" FontWeight="Bold" FontSize="9" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Command="{Binding DataContext.EditWorkOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="9,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteWorkOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="7,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>