<UserControl x:Class="AsiErp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
        <StackPanel>
            <!-- 1. Hero Sales & Billing Dashboard Section (Clean Light/Dark Responsive, No Black Box) -->
            <StackPanel Margin="0,0,0,22">
                <!-- Top Bar: Heading + Action Buttons -->
                <DockPanel Margin="0,0,0,14">
                    <!-- Action Buttons on Right -->
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Retail billing" Command="{Binding NavigateCommand}" CommandParameter="pos"
                                Padding="14,7" Background="#EAB308" Foreground="#0F172A" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button Content="+ Domestic invoice" Command="{Binding NavigateCommand}" CommandParameter="sales:domestic"
                                Padding="14,7" Background="#6366F1" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button Content="+ Export invoice" Command="{Binding NavigateCommand}" CommandParameter="sales:export"
                                Padding="14,7" Background="#2DD4BF" Foreground="#042F2E" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </WrapPanel>

                    <!-- Heading and Subtitle on Left -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Sales &amp; Billing" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Retail, domestic and export sales for the month you pick, with the amount still to receive." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Yellow Dotted Line Separator -->
                <Line X1="0" X2="1" Stroke="#EAB308" StrokeThickness="1.2" StrokeDashArray="3 3" Stretch="Fill" Margin="0,4,0,16" Tag="PreserveTheme"/>

                <!-- Month Navigation Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <Button Content="&lt; Prev Month" Command="{Binding PreviousMonthCommand}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#1E293B"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>

                    <Button Content="{Binding SelectedMonthDisplay}" Command="{Binding CurrentMonthCommand}" ToolTip="Click to return to Current Month"
                            Background="#EAB308" BorderThickness="0" Foreground="#0F172A"
                            Padding="16,6" Cursor="Hand" FontSize="11" FontWeight="Bold" Margin="0,0,10,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>

                    <Button Content="Next Month &gt;" Command="{Binding NextMonthCommand}"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#1E293B"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- 2 Rows x 4 Columns KPI Cards Grid (Row 2 Col 0 intentionally blank) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ROW 0, COL 0: Retail Sale (Blue) -->
                    <Border Grid.Row="0" Grid.Column="0" Tag="PreserveTheme" Background="#2563EB" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 2,3 L 5,3 L 7,12 L 17,12 L 19,6 L 6,6 M 7.5,15 A 1.5,1.5 0 1,1 7.5,15.01 M 15.5,15 A 1.5,1.5 0 1,1 15.5,15.01"
                                      Stroke="#FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Retail Sale" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0E7FF" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthRetailTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#BFDBFE" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 1: Domestic Sale (Green) -->
                    <Border Grid.Row="0" Grid.Column="1" Tag="PreserveTheme" Background="#15803D" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 3,2 L 10,2 L 14,6 L 14,16 L 3,16 Z M 10,2 L 10,6 L 14,6 M 5,9 L 11,9 M 5,12 L 11,12"
                                      Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Domestic Sale" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCFCE7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthDomesticTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#BBF7D0" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 2: Export Sale (Teal) -->
                    <Border Grid.Row="0" Grid.Column="2" Tag="PreserveTheme" Background="#0D9488" CornerRadius="12" Padding="16,14" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 11,2 L 13,2 L 13,9 L 20,13 L 20,15 L 13,13 L 13,18 L 15,20 L 15,21.5 L 12,20.5 L 9,21.5 L 9,20 L 11,18 L 11,13 L 4,15 L 4,13 L 11,9 Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Export Sale" FontSize="11.5" FontWeight="SemiBold" Foreground="#CCFBF1" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthExportTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#99F6E4" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0, COL 3: Total Sale (Purple) -->
                    <Border Grid.Row="0" Grid.Column="3" Tag="PreserveTheme" Background="#7C3AED" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <Path Data="M 2,12 L 6,8 L 10,11 L 16,4 M 11,4 L 16,4 L 16,9"
                                      Stroke="#FFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Sale" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDE9FE" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthGrandTotal, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="incl. GST" FontSize="10" Foreground="#DDD6FE" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 0: BLANK PLACE (Left empty intentional) -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Background="Transparent"/>

                    <!-- ROW 1, COL 1: Domestic Outstanding to Receive (Amber) -->
                    <Border Grid.Row="1" Grid.Column="1" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Domestic Outstanding to Receive" FontSize="11" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthDomesticOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to receive" FontSize="10" Foreground="#FDE68A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 2: Export Outstanding to Receive (Amber) -->
                    <Border Grid.Row="1" Grid.Column="2" Tag="PreserveTheme" Background="#D97706" CornerRadius="12" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Export Outstanding to Receive" FontSize="11" FontWeight="SemiBold" Foreground="#FEF3C7" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthExportOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to receive" FontSize="10" Foreground="#FDE68A" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 1, COL 3: Total Outstanding to Receive (Red) -->
                    <Border Grid.Row="1" Grid.Column="3" Tag="PreserveTheme" Background="#DC2626" CornerRadius="12" Padding="16,14" Margin="0,0,0,0">
                        <StackPanel>
                            <Border Tag="PreserveTheme" Width="28" Height="28" CornerRadius="6" Background="#26FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="₹" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Outstanding to Receive" FontSize="11" FontWeight="SemiBold" Foreground="#FEE2E2" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding MonthTotalOutstanding, Converter={StaticResource InrShortConv}}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            <TextBlock Text="still to receive" FontSize="10" Foreground="#FECACA" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 3. Custom Report & Data Table Section -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <DockPanel>
                    <!-- Custom Report Filter Bar (Exact Match to Prototype & Screenshot) -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Box (Left) + Category Chips (Right) -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetChannelCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Retail" Command="{Binding SetChannelCommand}" CommandParameter="retail" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=retail}"
                                            Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=retail}"
                                            BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=retail}"/>

                                    <Button Content="Domestic" Command="{Binding SetChannelCommand}" CommandParameter="domestic" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                            Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                            BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"/>

                                    <Button Content="Export" Command="{Binding SetChannelCommand}" CommandParameter="export"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                            Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                            BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"/>
                                </StackPanel>

                                <!-- Search Box with Hint & Clean Focus -->
                                <Border Style="{StaticResource SearchContainerBorderStyle}" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Grid.Column="1" Text="Search customer, invoice no..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSalesSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSalesSearch}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtSalesSearch" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CleanSearchTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Row 2: Custom report From/To (Left) + Status Chips & Download file (Right) -->
                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="All" Command="{Binding SetStatusCommand}" CommandParameter="all" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"/>

                                    <Button Content="Unpaid" Command="{Binding SetStatusCommand}" CommandParameter="Unpaid" Margin="0,0,5,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Unpaid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Unpaid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Unpaid}"/>

                                    <Button Content="Paid" Command="{Binding SetStatusCommand}" CommandParameter="Paid" Margin="0,0,8,0"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Paid}"
                                            Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Paid}"
                                            BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Paid}"/>

                                    <!-- Single Download file button asking PDF or CSV -->
                                    <Button Content="Download file" Command="{Binding DownloadFileCommand}"
                                            Height="32" Padding="16,0" Background="#172443" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Custom report From & To -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Custom report" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="From" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportFromDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="To" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ReportToDate, Mode=TwoWay}" Width="125" Height="30" VerticalContentAlignment="Center"/>
                                    <Button Content="Clear" Command="{Binding ClearCustomDatesCommand}"
                                            Visibility="{Binding HasCustomDates, Converter={StaticResource BoolToVis}}"
                                            Height="28" Padding="10,0" Margin="8,0,0,0" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Table Summary Bar: "0 entries · Total ₹0 · Balance ₹0" -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,2,2,10">
                        <TextBlock Text="{Binding FilteredSummaryText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Data Table Columns in exact order: Invoice | Type | Customer | Date | Amount | Received | Balance | Terms | Status | Actions -->
                    <DataGrid ItemsSource="{Binding FilteredSales}" AutoGenerateColumns="False" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              ScrollViewer.CanContentScroll="True"
                              helpers:SmoothScrollHelper.BubbleMouseWheel="True"
                              MaxHeight="680"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                        <!-- 1. Invoice -->
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="100" FontWeight="Bold"/>

                        <!-- 2. Type -->
                        <DataGridTemplateColumn Header="Type" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding Type, Converter={StaticResource StatusBgConv}}">
                                        <TextBlock Text="{Binding ChannelLabel}" Foreground="{Binding Type, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Customer -->
                        <DataGridTemplateColumn Header="Customer" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Date -->
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="80"/>

                        <!-- 5. Amount -->
                        <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="90" FontWeight="Bold"/>

                        <!-- 6. Received -->
                        <DataGridTextColumn Header="Received" Binding="{Binding PaidAmount, Converter={StaticResource InrConv}}" Width="85"/>

                        <!-- 7. Balance -->
                        <DataGridTemplateColumn Header="Balance" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BalanceAmount, Converter={StaticResource InrConv}}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Terms -->
                        <DataGridTextColumn Header="Terms" Binding="{Binding SaleType}" Width="60"/>

                        <!-- 9. Status -->
                        <DataGridTemplateColumn Header="Status" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 10. Actions -->
                        <DataGridTemplateColumn Width="195" MinWidth="195">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="View" Command="{Binding DataContext.ViewSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="8,3" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="Receive" Visibility="{Binding ReceivePaymentVisibility}" Command="{Binding DataContext.ReceivePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="8,3" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Padding="8,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
