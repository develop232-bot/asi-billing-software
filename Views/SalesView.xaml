<UserControl x:Class="AsiErp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:InrShortConverter x:Key="InrShortConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:StatusToBrushConverter x:Key="StatusBrushConv"/>
        <converters:StatusToBackgroundConverter x:Key="StatusBgConv"/>
        <converters:TabActiveBackgroundConverter x:Key="TabActiveBgConv"/>
        <converters:TabActiveForegroundConverter x:Key="TabActiveFgConv"/>
        <converters:TabActiveBorderConverter x:Key="TabActiveBorderConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Title & Subtitle -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Sales &amp; Billing" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Domestic wholesale invoices, overseas export invoices, and showroom retail counter bills." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+ Retail Billing" Command="{Binding NavigateCommand}" CommandParameter="sales:retail" Padding="14,8" Background="#172443" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Button Content="+ Domestic Invoice" Command="{Binding OpenDialogCommand}" CommandParameter="domestic_invoice" Padding="14,8" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Button Content="+ Export Invoice" Command="{Binding OpenDialogCommand}" CommandParameter="export_invoice" Padding="14,8" Background="#0D9488" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>

            <!-- 4 Stats Tiles -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Billed This Month" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BilledThisMonth, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,2"/>
                        <TextBlock Text="Current calendar month" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Outstanding to Receive" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OutstandingTotal, Converter={StaticResource InrShortConv}}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,2"/>
                        <TextBlock Text="{Binding OutstandingCount, StringFormat='From {0} open invoices'}" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Channel Distribution" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,2">
                            <Run Text="{Binding RetailCount, Mode=OneWay}"/>
                            <Run Text=" · " Foreground="#F59E0B"/>
                            <Run Text="{Binding DomesticCount, Mode=OneWay}"/>
                            <Run Text=" · " Foreground="#2563EB"/>
                            <Run Text="{Binding ExportCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Retail · Domestic · Export" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Invoices to Date" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalInvoicesCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,5,0,2"/>
                        <TextBlock Text="Total records generated" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table Container -->
            <Border Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Filter Tools -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="10,6" Margin="0,0,16,0"/>

                        <!-- Channel Chips -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Content="All" Command="{Binding SetChannelCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Retail" Command="{Binding SetChannelCommand}" CommandParameter="retail" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=retail}"
                                    Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=retail}"
                                    BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=retail}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Domestic" Command="{Binding SetChannelCommand}" CommandParameter="domestic" Margin="0,0,4,0" Padding="12,5"
                                    Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=domestic}"
                                    Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=domestic}"
                                    BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=domestic}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Export" Command="{Binding SetChannelCommand}" CommandParameter="export" Padding="12,5"
                                    Background="{Binding SelectedChannel, Converter={StaticResource TabActiveBgConv}, ConverterParameter=export}"
                                    Foreground="{Binding SelectedChannel, Converter={StaticResource TabActiveFgConv}, ConverterParameter=export}"
                                    BorderBrush="{Binding SelectedChannel, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=export}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Status Chips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="All Status" Command="{Binding SetStatusCommand}" CommandParameter="all" Margin="0,0,4,0" Padding="10,5"
                                    Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=all}"
                                    Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=all}"
                                    BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=all}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Unpaid" Command="{Binding SetStatusCommand}" CommandParameter="Unpaid" Margin="0,0,4,0" Padding="10,5"
                                    Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Unpaid}"
                                    Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Unpaid}"
                                    BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Unpaid}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Partial" Command="{Binding SetStatusCommand}" CommandParameter="Partial" Margin="0,0,4,0" Padding="10,5"
                                    Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Partial}"
                                    Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Partial}"
                                    BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Partial}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="Paid" Command="{Binding SetStatusCommand}" CommandParameter="Paid" Padding="10,5"
                                    Background="{Binding SelectedStatus, Converter={StaticResource TabActiveBgConv}, ConverterParameter=Paid}"
                                    Foreground="{Binding SelectedStatus, Converter={StaticResource TabActiveFgConv}, ConverterParameter=Paid}"
                                    BorderBrush="{Binding SelectedStatus, Converter={StaticResource TabActiveBorderConv}, ConverterParameter=Paid}"
                                    BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Invoices Table -->
                    <DataGrid ItemsSource="{Binding FilteredSales}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="150" FontWeight="Bold"/>

                            <DataGridTemplateColumn Header="Channel" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Type, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding ChannelLabel}" Foreground="{Binding Type, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Customer / Buyer" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Party}" ToolTip="{Binding Party}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateConv}}" Width="95"/>
                            <DataGridTextColumn Header="Amount (₹)" Binding="{Binding GrossAmount, Converter={StaticResource InrConv}}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Terms" Binding="{Binding SaleType}" Width="85"/>

                            <DataGridTemplateColumn Header="Payment" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConv}}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="View" Command="{Binding DataContext.ViewSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#F8FAFC" BorderBrush="#E2E8F0" Cursor="Hand" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="Receive" Command="{Binding DataContext.ReceivePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Padding="10,4" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
