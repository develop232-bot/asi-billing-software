<UserControl x:Class="AsiErp.Views.DomesticInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AsiErp.Converters"
             xmlns:helpers="clr-namespace:AsiErp.Helpers">

    <UserControl.Resources>
        <converters:InrCurrencyConverter x:Key="InrConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToIndexConverter x:Key="BoolToIndexConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Top Header & Navigation -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Domestic Tax Invoice" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Within India / GST B2B Wholesale Billing" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Reset" Command="{Binding ResetFormCommand}"
                            Padding="12,6" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                            Cursor="Hand" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="💾 Save Tax Invoice" Command="{Binding SaveInvoiceCommand}"
                            Padding="16,8" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold" FontSize="12">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Customer & Invoice Information Card -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Customer / Company Name -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                        <TextBlock Text="Customer / Company Name *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Invoice Date -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,12">
                        <TextBlock Text="Invoice Date *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding InvoiceDate, Mode=TwoWay}" Padding="6,4"/>
                    </StackPanel>

                    <!-- Invoice Number -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Invoice Number" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InvoiceNo}" IsReadOnly="True" Background="#F8FAFC" Padding="8,6" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Contact Person -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Contact Person Name" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Phone Number -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Contact Phone Number *" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- GSTIN & Tax Type -->
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Customer GSTIN" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomerGstin, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tax Type" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding IsInterState, Converter={StaticResource BoolToIndexConv}}"
                                      IsEditable="True" IsTextSearchEnabled="True" Padding="6,5">
                                <ComboBoxItem Content="Intra (CGST+SGST)"/>
                                <ComboBoxItem Content="Inter (IGST)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Line Items Table Card -->
            <Border Background="White" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Invoice Items" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Content="➕ Add Item" Command="{Binding AddLineCommand}" HorizontalAlignment="Right"
                                Padding="14,6" Background="#0F172A" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </DockPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" helpers:SmoothScrollHelper.IsDragScrollEnabled="True">
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White"
                                  RowHeight="46" MinWidth="850">
                            <DataGrid.Columns>
                                <!-- Product Name Selection -->
                                <DataGridTemplateColumn Header="Product (Select or Type)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.AvailableProducts}"
                                                      DisplayMemberPath="FullDisplayName" SelectedValuePath="Id" SelectedValue="{Binding Pid, Mode=TwoWay}"
                                                      Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                      IsEditable="True" Height="34" Padding="10,0" VerticalContentAlignment="Center" Margin="2,0" FontSize="12.5"
                                                      IsTextSearchEnabled="True" TextSearch.TextPath="FullDisplayName">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,3">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Border Background="#EEF2FF" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                                        <TextBlock Text="{Binding Sku}" FontSize="10" FontWeight="Bold" Foreground="#4F46E5"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Stock, StringFormat='{}{0:N0} in stock'}" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Size -->
                                <DataGridTemplateColumn Header="Size" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- HSN -->
                                <DataGridTemplateColumn Header="HSN" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Hsn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Qty -->
                                <DataGridTemplateColumn Header="Qty" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Rate (₹) -->
                                <DataGridTemplateColumn Header="Rate (₹)" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="8,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Disc % -->
                                <DataGridTemplateColumn Header="Disc %" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DiscPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- GST % -->
                                <DataGridTemplateColumn Header="GST %" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding GstPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"
                                                     FontWeight="SemiBold" FontSize="12.5" BorderBrush="#CBD5E1" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total (₹) -->
                                <DataGridTemplateColumn Header="Total (₹)" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="6" Height="34" Padding="8,0" Margin="2,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GrossAmount, StringFormat='{}{0:N2}'}"
                                                           FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete -->
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteLineCommand}" CommandParameter="{Binding}"
                                                    Foreground="#DC2626" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                    Width="28" Height="28" Cursor="Hand" FontWeight="Bold" FontSize="13"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Delete this item">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Bottom Summary & Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Payment Terms -->
                <Border Grid.Column="0" Background="White" Padding="18" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Payment Terms" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Cash / Immediate Payment" IsChecked="{Binding IsCash, Mode=TwoWay}" GroupName="Terms" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton Content="Credit Invoice" IsChecked="{Binding IsCredit, Mode=TwoWay}" GroupName="Terms" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="Credit Period:" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding CreditDays, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4" TextAlignment="Center" BorderBrush="#CBD5E1"/>
                            <TextBlock Text="days" VerticalAlignment="Center" Foreground="#475569" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Totals Box -->
                <Border Grid.Column="1" Background="White" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Subtotal (Taxable):" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Subtotal, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="{Binding TaxLabel}" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TaxAmount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </DockPanel>
                        <Border Background="#E2E8F0" Height="1" Margin="0,8"/>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Total Invoice Amount:" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding GrossAmount, Converter={StaticResource InrConv}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="17" Foreground="#2563EB"/>
                        </DockPanel>

                        <DockPanel Margin="0,10,0,14" VerticalAlignment="Center">
                            <TextBlock Text="Paid Now (₹):" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PaidNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                     Width="130" HorizontalAlignment="Right" Padding="6,4" TextAlignment="Right" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                        </DockPanel>

                        <Button Content="💾 Save Tax Invoice" Command="{Binding SaveInvoiceCommand}"
                                Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="13">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
